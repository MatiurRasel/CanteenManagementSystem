// =============================================================================
// Development overrides — loaded AFTER appsettings.json when ASPNETCORE_ENVIRONMENT=Development.
//
// Goals here:
//   * verbose logs for trace work
//   * console OTel exporter so spans land on stdout (no collector needed)
//   * an obvious "we're in dev" so accidental prod overlap is visible
//
// Anything secret stays in dotnet user-secrets, NOT in this file.
//   dotnet user-secrets init --project src/CanteenManagementSystem.Presentation
//   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Server=localhost;..."
// =============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "Observability": {
    // OTel Console exporter is intentionally OFF — it dumps every Activity
    // (DB queries, HTTP spans, instrumentation scopes) AND every metric as
    // multi-line text and drowns out Serilog. Turn it on temporarily only
    // when you're debugging the OTel pipeline itself (env var override:
    // OBSERVABILITY__USECONSOLEEXPORTER=true).
    //
    // Traces still flow through Activity for /metrics + any configured OTLP
    // endpoint; you just won't see them on stdout.
    "UseConsoleExporter": false
  },

  "Receipt": {
    "VerifyBaseUrl": "https://localhost:7093"
  }
}
