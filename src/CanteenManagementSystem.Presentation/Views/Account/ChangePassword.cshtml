@model CanteenManagementSystem.Presentation.Controllers.AccountController.ChangePasswordForm
@{
    ViewData["Title"] = "Change password";
    Layout = null;
    var mustChange = User?.HasClaim("must_change_password", "true") == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change password</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/shadcn.css" asp-append-version="true" />
    <style>
        body {
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .pw-card { max-width: 440px; width: 100%; }
    </style>
</head>
<body>
    <div class="pw-card">
        <div class="ui-card surface-raised">
            <div class="ui-card-body">
                <div class="text-center mb-3">
                    <div class="mb-3" style="width:56px;height:56px;background:var(--accent-soft);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-key" style="color:var(--accent);font-size:24px"></i>
                    </div>
                    <h5 class="fw-semibold mb-1" style="color:var(--fg)">Change password</h5>
                    @if (mustChange)
                    {
                        <p class="ui-muted small mb-0">Your administrator requires you to update your password before continuing.</p>
                    }
                    else
                    {
                        <p class="ui-muted small mb-0">Update your account password.</p>
                    }
                </div>

                @if (mustChange)
                {
                    <div class="alert alert-warning small py-2 mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        You must change your password before continuing.
                    </div>
                }

                <form method="post" asp-action="ChangePassword">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label class="ui-label" asp-for="CurrentPassword">Current password</label>
                        <input asp-for="CurrentPassword" class="ui-input form-control" type="password" autocomplete="current-password" autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="ui-label" asp-for="NewPassword">New password</label>
                        <input asp-for="NewPassword" class="ui-input form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="ui-muted" style="font-size:12px;margin-top:.25rem">At least 8 characters.</div>
                    </div>
                    <div class="mb-3">
                        <label class="ui-label" asp-for="ConfirmPassword">Confirm new password</label>
                        <input asp-for="ConfirmPassword" class="ui-input form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-check me-1"></i> Update password
                        </button>
                    </div>
                </form>

                @if (!mustChange)
                {
                    <div class="text-center mt-3 small">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none ui-muted">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
