@model CanteenManagementSystem.Presentation.Controllers.AccountController.ResetPasswordForm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Account.ResetPassword.Title"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Account.ResetPassword.Title"] · @L["Account.Common.BrandName"]</title>
    <partial name="_AuthChrome" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
</head>
<body>
<div class="auth-shell">
    <div class="auth-card auth-card-wide">
        <div class="auth-icon-plate"><i class="bx bx-lock-open-alt"></i></div>
        <h2 class="auth-title">@L["Account.ResetPassword.Heading"]</h2>
        <p class="auth-sub">
            @L["Account.ResetPassword.Subtitle"]
        </p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label class="ui-label" asp-for="NewPassword">@L["Account.Common.NewPassword"]</label>
                <input asp-for="NewPassword" type="password" class="ui-input form-control"
                       autocomplete="new-password" required minlength="8" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="ui-label" asp-for="ConfirmPassword">@L["Account.Common.ConfirmNewPassword"]</label>
                <input asp-for="ConfirmPassword" type="password" class="ui-input form-control"
                       autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">
                <i class="bx bx-check me-2"></i>@L["Account.ResetPassword.Submit"]
            </button>
        </form>

        <div class="text-center mt-3 small">
            <a asp-action="Login" class="auth-link">← @L["Account.Common.BackToSignIn"]</a>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
