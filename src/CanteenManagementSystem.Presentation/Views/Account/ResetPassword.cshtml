@model CanteenManagementSystem.Presentation.Controllers.AccountController.ResetPasswordForm
@{
    ViewData["Title"] = "Reset password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset password · SmartCanteen</title>
    <partial name="_AuthChrome" />
</head>
<body>
<div class="auth-shell">
    <div class="auth-card auth-card-wide">
        <div class="auth-icon-plate"><i class="fa-solid fa-lock-open"></i></div>
        <h2 class="auth-title">Choose a new password</h2>
        <p class="auth-sub">
            Make it at least 8 characters. Mix letters, numbers, and symbols for the strongest result.
        </p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label class="ui-label" asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" type="password" class="ui-input form-control"
                       autocomplete="new-password" required minlength="8" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="ui-label" asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" type="password" class="ui-input form-control"
                       autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">
                <i class="fa-solid fa-check me-2"></i>Set new password
            </button>
        </form>

        <div class="text-center mt-3 small">
            <a asp-action="Login" class="auth-link">← Back to sign in</a>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
