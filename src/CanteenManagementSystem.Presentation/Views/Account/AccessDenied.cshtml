@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Account.AccessDenied.Title"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Account.AccessDenied.Title"] · @L["Account.Common.BrandName"]</title>
    <partial name="_AuthChrome" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
</head>
<body>
<div class="auth-shell">
    <div class="auth-card text-center">
        <div class="auth-icon-plate" style="background:rgba(239,68,68,.10);color:#ef4444;margin:0 auto 1rem">
            <i class="bx bx-lock-alt"></i>
        </div>
        <h2 class="auth-title">@L["Account.AccessDenied.Title"]</h2>
        <p class="auth-sub">@L["Account.AccessDenied.Subtitle"]</p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="/" class="btn btn-primary">
                <i class="bx bxs-home me-1"></i> @L["Account.AccessDenied.BackHome"]
            </a>
            <a asp-action="Login" class="btn btn-outline-secondary">
                <i class="bx bx-log-out me-1"></i> @L["Account.AccessDenied.SignInAnother"]
            </a>
        </div>
    </div>
</div>
</body>
</html>
