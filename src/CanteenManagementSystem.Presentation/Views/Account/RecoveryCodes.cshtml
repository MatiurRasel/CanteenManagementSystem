@*
    /Account/RecoveryCodes — shown ONCE after MFA enrolment / regeneration.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.AccountController.RecoveryCodesVm
@{
    ViewData["Title"] = "Your MFA recovery codes";
    var header = new UiPageHeaderOptions
    {
        Title    = "Your MFA recovery codes",
        Subtitle = "These are shown once. Save them somewhere safe — a password manager or a printed copy in a sealed envelope."
    };
    var warn = new UiAlertOptions
    {
        Variant = UiAlertVariant.Warning,
        Heading = "Save these codes NOW",
        Body    = "Each code can be used exactly once if you lose access to your authenticator. We never show them again — generate a fresh set if you need new ones."
    };
}

<div class="container py-4" style="max-width:720px">
    <partial name="_UiPageHeader" model="header" />
    <partial name="_UiAlert" model="warn" />

    <div class="ui-card mt-4">
        <div class="ui-card-header">
            <div class="ui-card-title">@Model.Codes.Count codes</div>
            <div class="ui-row" style="gap:.5rem">
                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="cmsCopyRecovery()">
                    <i class="fa-solid fa-copy me-1"></i> Copy all
                </button>
                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> Print
                </button>
                <a class="btn btn-outline-secondary btn-sm" download="canteen-recovery-codes.txt"
                   id="cms-download-recovery">
                    <i class="fa-solid fa-download me-1"></i> Download .txt
                </a>
            </div>
        </div>
        <div class="ui-card-body">
            <div class="row g-2" id="cms-recovery-grid">
                @foreach (var code in Model.Codes)
                {
                    <div class="col-12 col-sm-6">
                        <div class="ui-mono ui-card surface-raised" style="padding:.75rem 1rem;font-size:16px;letter-spacing:0.05em">@code</div>
                    </div>
                }
            </div>
        </div>
        <div class="ui-card-footer">
            <a asp-action="Mfa" class="btn btn-primary">
                <i class="fa-solid fa-check me-1"></i> I've saved them — done
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var codes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Codes));
            var text  = codes.join('\n');
            window.cmsCopyRecovery = function () {
                navigator.clipboard.writeText(text).then(function () {
                    if (window.showToast) window.showToast('Codes copied to clipboard.', 'success');
                }, function () {
                    if (window.cmsToast) window.cmsToast('Copy failed — select + copy manually.', 'warning');
                    else alert('Copy failed — select + copy manually.');
                });
            };
            var dl = document.getElementById('cms-download-recovery');
            if (dl) dl.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(text);
        })();
    </script>
}
