@model CanteenManagementSystem.Presentation.Controllers.AccountController.VerifyMfaForm
@{
    ViewData["Title"] = "Two-factor verification";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Two-factor verification</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/shadcn.css" asp-append-version="true" />
    <style>
        body {
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .mfa-card {
            max-width: 420px;
            width: 100%;
        }
        .mfa-code {
            font-size: 28px;
            letter-spacing: 0.4em;
            text-align: center;
            font-family: var(--font-mono);
        }
    </style>
</head>
<body>
    <div class="mfa-card">
        <div class="ui-card surface-raised">
            <div class="ui-card-body text-center">
                <div class="mb-3" style="width:56px;height:56px;background:var(--accent-soft);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-shield-halved" style="color:var(--accent);font-size:24px"></i>
                </div>
                <h5 class="fw-semibold mb-2" style="color:var(--fg)">Two-factor verification</h5>
                <p class="ui-muted small mb-4" id="prompt">Enter the 6-digit code from your authenticator app.</p>

                <form method="post" asp-action="VerifyMfa" class="text-start">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Code" class="ui-label" id="codeLabel">Code</label>
                        <input asp-for="Code" id="codeInput"
                               class="ui-input form-control mfa-code"
                               inputmode="numeric" pattern="[0-9]*" maxlength="8" autocomplete="one-time-code" autofocus />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-check me-1"></i> Verify
                        </button>
                    </div>
                </form>

                <div class="mt-3 small">
                    <a href="#" id="toggleMode" class="text-decoration-none" style="color:var(--accent)">
                        <i class="fa-solid fa-key me-1"></i> Use a recovery code instead
                    </a>
                </div>
                <div class="mt-2 small">
                    <a asp-action="Login" class="text-decoration-none ui-muted">Sign in as a different user</a>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var btn = document.getElementById('toggleMode');
            var input = document.getElementById('codeInput');
            var prompt = document.getElementById('prompt');
            var mode = 'totp';
            btn && btn.addEventListener('click', function (e) {
                e.preventDefault();
                mode = (mode === 'totp') ? 'recovery' : 'totp';
                if (mode === 'recovery') {
                    input.setAttribute('inputmode', 'text');
                    input.removeAttribute('pattern');
                    input.setAttribute('maxlength', '20');
                    input.placeholder = 'e.g. 5F2H7-K9XYM';
                    input.value = '';
                    input.focus();
                    prompt.textContent = 'Enter one of your one-time recovery codes.';
                    btn.innerHTML = '<i class="fa-solid fa-mobile-screen me-1"></i> Use my authenticator app instead';
                } else {
                    input.setAttribute('inputmode', 'numeric');
                    input.setAttribute('pattern', '[0-9]*');
                    input.setAttribute('maxlength', '8');
                    input.placeholder = '';
                    input.value = '';
                    input.focus();
                    prompt.textContent = 'Enter the 6-digit code from your authenticator app.';
                    btn.innerHTML = '<i class="fa-solid fa-key me-1"></i> Use a recovery code instead';
                }
            });
        })();
    </script>
</body>
</html>
