@model CanteenManagementSystem.Presentation.Controllers.AccountController.VerifyMfaForm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Account.VerifyMfa.Title"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Account.VerifyMfa.Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/css/shadcn.css" asp-append-version="true" />
    <style>
        body {
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .mfa-card {
            max-width: 420px;
            width: 100%;
        }
        .mfa-code {
            font-size: 28px;
            letter-spacing: 0.4em;
            text-align: center;
            font-family: var(--font-mono);
        }
    </style>
</head>
<body>
    <div class="mfa-card">
        <div class="ui-card surface-raised">
            <div class="ui-card-body text-center">
                <div class="mb-3" style="width:56px;height:56px;background:var(--accent-soft);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;">
                    <i class="bx bxs-shield" style="color:var(--accent);font-size:24px"></i>
                </div>
                <h5 class="fw-semibold mb-2" style="color:var(--fg)">@L["Account.VerifyMfa.Title"]</h5>
                <p class="ui-muted small mb-4" id="prompt">@L["Account.VerifyMfa.PromptTotp"]</p>

                <form method="post" asp-action="VerifyMfa" class="text-start">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Code" class="ui-label" id="codeLabel">@L["Account.VerifyMfa.CodeLabel"]</label>
                        <input asp-for="Code" id="codeInput"
                               class="ui-input form-control mfa-code"
                               inputmode="numeric" pattern="[0-9]*" maxlength="8" autocomplete="one-time-code" autofocus />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-check me-1"></i> @L["Account.VerifyMfa.Verify"]
                        </button>
                    </div>
                </form>

                <div class="mt-3 small">
                    <a href="#" id="toggleMode" class="text-decoration-none" style="color:var(--accent)">
                        <i class="bx bx-key me-1"></i> @L["Account.VerifyMfa.UseRecovery"]
                    </a>
                </div>
                <div class="mt-2 small">
                    <a asp-action="Login" class="text-decoration-none ui-muted">@L["Account.VerifyMfa.SignInDifferentUser"]</a>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        const T = {
            promptTotp: '@L["Account.VerifyMfa.PromptTotp"]',
            promptRecovery: '@L["Account.VerifyMfa.PromptRecovery"]',
            useRecovery: '@L["Account.VerifyMfa.UseRecovery"]',
            useTotp: '@L["Account.VerifyMfa.UseTotp"]',
            recoveryPlaceholder: '@L["Account.VerifyMfa.RecoveryPlaceholder"]'
        };
        (function () {
            var btn = document.getElementById('toggleMode');
            var input = document.getElementById('codeInput');
            var prompt = document.getElementById('prompt');
            var mode = 'totp';
            btn && btn.addEventListener('click', function (e) {
                e.preventDefault();
                mode = (mode === 'totp') ? 'recovery' : 'totp';
                if (mode === 'recovery') {
                    input.setAttribute('inputmode', 'text');
                    input.removeAttribute('pattern');
                    input.setAttribute('maxlength', '20');
                    input.placeholder = T.recoveryPlaceholder;
                    input.value = '';
                    input.focus();
                    prompt.textContent = T.promptRecovery;
                    btn.innerHTML = '<i class="bx bx-mobile-alt me-1"></i> ' + T.useTotp;
                } else {
                    input.setAttribute('inputmode', 'numeric');
                    input.setAttribute('pattern', '[0-9]*');
                    input.setAttribute('maxlength', '8');
                    input.placeholder = '';
                    input.value = '';
                    input.focus();
                    prompt.textContent = T.promptTotp;
                    btn.innerHTML = '<i class="bx bx-key me-1"></i> ' + T.useRecovery;
                }
            });
        })();
    </script>
</body>
</html>
