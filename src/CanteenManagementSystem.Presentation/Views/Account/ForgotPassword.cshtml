@model CanteenManagementSystem.Presentation.Controllers.AccountController.ForgotPasswordForm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Account.ForgotPassword.Title"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Account.ForgotPassword.Title"] · @L["Account.Common.BrandName"]</title>
    <partial name="_AuthChrome" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
</head>
<body>
<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-icon-plate"><i class="bx bx-key"></i></div>
        <h2 class="auth-title">@L["Account.ForgotPassword.Heading"]</h2>
        <p class="auth-sub">
            @L["Account.ForgotPassword.Subtitle"]
        </p>

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <label class="ui-label" asp-for="Email">@L["Common.Email"]</label>
            <input asp-for="Email" class="ui-input form-control" placeholder="@L["Account.Common.EmailPlaceholder"]"
                   autocomplete="email" required autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                <i class="bx bxs-send me-2"></i>@L["Account.ForgotPassword.Submit"]
            </button>
        </form>

        <div class="text-center mt-3 small">
            <a asp-action="Login" class="auth-link">← @L["Account.Common.BackToSignIn"]</a>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
