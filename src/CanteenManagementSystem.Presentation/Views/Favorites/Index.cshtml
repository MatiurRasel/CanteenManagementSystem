@*
    /me/favorites — saved items for one-tap re-order.
*@
@using CanteenManagementSystem.Application.Favorites
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<FavoriteItemDto>
@{
    ViewData["Title"] = "My favourites";
    var header = new UiPageHeaderOptions
    {
        Title    = "My favourites",
        Subtitle = "Tap a card to re-order an item you've saved."
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions
        {
            Icon  = "fa-heart",
            Title = "No favourites yet",
            Description = "Tap the heart icon on /me/orders next to any item you'd order again, and it lands here.",
            CtaLabel = "Go to my orders",
            CtaUrl   = "/me/orders",
            CtaIcon  = "fa-arrow-right"
        };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="row g-3">
            @foreach (var f in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="ui-card" style="height:100%">
                        <div class="ui-card-body">
                            <div class="ui-row-between mb-2">
                                <div class="ui-text-strong">@f.ItemName</div>
                                <form method="post" action="/me/favorites/@f.FavoriteId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="_method" value="DELETE" />
                                    <button class="btn btn-ghost btn-sm" type="submit" title="Remove">
                                        <i class="fa-solid fa-heart" style="color: var(--danger-fg)"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="ui-tabular ui-text-strong" style="font-size:18px">৳ @f.Price.ToString("N0")</div>
                            <div class="ui-muted" style="font-size:12px">saved @f.CreatedAtUtc.ToString("yyyy-MM-dd")</div>
                            <div class="ui-divider"></div>
                            <a class="btn btn-primary w-100" href="/kiosk?fav=@f.FoodItemId">
                                <i class="fa-solid fa-cart-plus me-1"></i> Order now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
