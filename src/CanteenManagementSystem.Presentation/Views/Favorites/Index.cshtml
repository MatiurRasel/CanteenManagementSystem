@*
    /me/favorites — saved items for one-tap re-order.
*@
@using CanteenManagementSystem.Application.Favorites
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<FavoriteItemDto>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Favorites.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["Favorites.Index.Title"].Value,
        Subtitle = L["Favorites.Index.Subtitle"].Value
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions
        {
            Icon  = "bx-heart",
            Title = L["Favorites.Index.EmptyTitle"].Value,
            Description = L["Favorites.Index.EmptyDescription"].Value,
            CtaLabel = L["Favorites.Index.GoToOrders"].Value,
            CtaUrl   = "/me/orders",
            CtaIcon  = "bx-right-arrow-alt"
        };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="row g-3">
            @foreach (var f in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="ui-card" style="height:100%">
                        <div class="ui-card-body">
                            <div class="ui-row-between mb-2">
                                <div class="ui-text-strong">@f.ItemName</div>
                                <form method="post" action="/me/favorites/@f.FavoriteId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="_method" value="DELETE" />
                                    <button class="btn btn-ghost btn-sm" type="submit" title="@L["Common.Remove"]">
                                        <i class="bx bxs-heart" style="color: var(--danger-fg)"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="ui-tabular ui-text-strong" style="font-size:18px">৳ @f.Price.ToString("N0")</div>
                            <div class="ui-muted" style="font-size:12px">@L["Favorites.Index.SavedOn", f.CreatedAtUtc.ToString("yyyy-MM-dd")]</div>
                            <div class="ui-divider"></div>
                            <a class="btn btn-primary w-100" href="/kiosk?fav=@f.FoodItemId">
                                <i class="bx bx-cart-add me-1"></i> @L["Favorites.Index.OrderNow"]
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
