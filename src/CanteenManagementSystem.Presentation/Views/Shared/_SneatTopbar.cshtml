@using CanteenManagementSystem
@using Platform.Application.Configuration
@inject IStringLocalizer<SharedResource> L
@inject Microsoft.Extensions.Options.IOptions<BrandingConfiguration> BrandingOptions

@{
    var branding = BrandingOptions.Value;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var pageTitle = ViewData["Title"] as string ?? branding.AppName;
    var impCookie = Context.Request.Cookies["ccs.impersonate"];
    string? impTenant = !string.IsNullOrEmpty(impCookie) && impCookie.Contains('|')
        ? impCookie.Split('|', 2)[1] : null;

    string userName = User?.Identity?.Name ?? string.Empty;
    string initials = "?";
    if (!string.IsNullOrWhiteSpace(userName))
    {
        var parts = userName.Trim().Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            initials = (char.ToUpperInvariant(parts[0][0]).ToString() + char.ToUpperInvariant(parts[1][0]));
        else if (parts.Length == 1)
            initials = char.ToUpperInvariant(parts[0][0]).ToString();
    }
    var roles = User?.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToArray() ?? Array.Empty<string>();
}

@if (!string.IsNullOrEmpty(impTenant) && (User?.IsInRole("SystemAdmin") ?? false))
{
    <div class="topbar-impersonation">
        <div class="small">
            <i class="bx bx-mask me-2"></i>
            @L["Shared.Topbar.Impersonating.Before"] <strong>@impTenant</strong> @L["Shared.Topbar.Impersonating.After"]
        </div>
        <form asp-controller="TenantsAdmin" asp-action="StopImpersonating" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-warning">
                <i class="bx bx-stop-circle me-1"></i> @L["Shared.Topbar.StopImpersonating"]
            </button>
        </form>
    </div>
}

<header class="app-topbar">
    <div class="topbar-left">
        <button type="button" class="topbar-action menu-toggler" data-menu-toggle aria-label="@L["ToggleMenu"]">
            <i class="bx bx-menu"></i>
        </button>
        <button type="button" class="topbar-action sidebar-collapse-toggle d-none d-lg-inline-flex"
                data-sidebar-collapse aria-label="@L["Shared.Topbar.CollapseSidebar"]"
                title="@L["Shared.Topbar.CollapseSidebar"] (Ctrl+B)">
            <i class="bx bx-menu-alt-left"></i>
        </button>
        <div class="topbar-title-block">
            <div class="topbar-eyebrow text-truncate">@branding.AppName</div>
            <h5 class="text-truncate">@pageTitle</h5>
        </div>
    </div>

    <div class="topbar-center d-none d-lg-flex">
        <div class="topbar-search">
            <i class="bx bx-search topbar-search-icon"></i>
            <input type="search"
                   class="topbar-search-input"
                   placeholder="@L["Shared.Topbar.SearchPlaceholder"] (Ctrl+K)"
                   aria-label="@L["Common.Search"]"
                   id="cms-topbar-search" />
            <kbd class="topbar-search-kbd">⌘K</kbd>
        </div>
    </div>

    <div class="topbar-right">
        <button type="button" class="topbar-action d-inline-flex d-lg-none"
                data-topbar-mobile-search aria-label="@L["Common.Search"]">
            <i class="bx bx-search"></i>
        </button>

        <div class="dropdown d-none d-md-inline-flex">
            <button class="topbar-pill" data-bs-toggle="dropdown" aria-expanded="false" title="@L["LanguageEnglish"]">
                <i class="bx bx-world"></i>
                <span>@(currentCulture == "bn-BD" ? "বাংলা" : "EN")</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item @(currentCulture == "en-US" ? "active" : "")"
                       asp-controller="Culture" asp-action="Set"
                       asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">
                        <span class="me-2">🇺🇸</span> @L["LanguageEnglish"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item @(currentCulture == "bn-BD" ? "active" : "")"
                       asp-controller="Culture" asp-action="Set"
                       asp-route-culture="bn-BD" asp-route-returnUrl="@returnUrl">
                        <span class="me-2">🇧🇩</span> বাংলা
                    </a>
                </li>
            </ul>
        </div>

        <button type="button" class="topbar-action" data-theme-toggle title="@L["ToggleTheme"]" aria-label="@L["ToggleTheme"]">
            <i class="bx bx-moon" data-theme-icon></i>
        </button>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <button type="button" class="topbar-action topbar-notif" data-bs-toggle="dropdown" aria-expanded="false" title="@L["Shared.Topbar.Notifications"]">
                <i class="bx bx-bell"></i>
                <span class="topbar-notif-dot" aria-hidden="true"></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end topbar-dropdown">
                <li class="dropdown-header d-flex justify-content-between align-items-center">
                    <strong>@L["Shared.Topbar.Notifications"]</strong>
                    <a asp-controller="NotificationDeliveries" asp-action="Index" class="small">@L["ViewAll"]</a>
                </li>
                <li><hr class="dropdown-divider m-0" /></li>
                <li><div class="dropdown-item-text text-center text-muted py-4 small">
                    <i class="bx bx-bell-off mb-2 d-block" style="font-size:1.5rem"></i>
                    @L["Shared.Topbar.NoNotifications"]
                </div></li>
            </ul>

            <div class="dropdown">
                <button class="topbar-avatar-btn" data-bs-toggle="dropdown" aria-expanded="false" title="@userName">
                    <span class="topbar-avatar">@initials</span>
                    <span class="topbar-avatar-meta d-none d-xl-flex">
                        <span class="topbar-avatar-name">@userName</span>
                        @if (roles.Length > 0)
                        {
                            <span class="topbar-avatar-role">@roles[0]</span>
                        }
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end topbar-dropdown topbar-dropdown-user">
                    <li class="dropdown-header">
                        <div class="d-flex align-items-center gap-3">
                            <span class="topbar-avatar topbar-avatar-lg">@initials</span>
                            <div class="min-w-0 flex-grow-1">
                                <div class="fw-semibold text-truncate">@userName</div>
                                @if (roles.Length > 0)
                                {
                                    <small class="text-muted text-truncate d-block">@string.Join(", ", roles)</small>
                                }
                            </div>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li class="dropdown-header small text-muted">@L["Shared.Sidebar.MyAccount"]</li>
                    <li>
                        <a asp-controller="Account" asp-action="Mfa" class="dropdown-item">
                            <i class="bx bx-shield-quarter me-2 text-muted"></i> @L["Shared.Topbar.TwoFactorAuth"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item">
                            <i class="bx bx-key me-2 text-muted"></i> @L["Account.ChangePassword.Title"]
                        </a>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" data-customizer-open>
                            <i class="bx bx-palette me-2 text-muted"></i> @L["Shared.Topbar.CustomizeTheme"]
                        </button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bx bx-log-out me-2"></i> @L["SignOut"]
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="btn btn-primary btn-sm">
                <i class="bx bx-log-in me-1"></i> @L["Account.Login.Title"]
            </a>
        }
    </div>
</header>

<div class="topbar-mobile-search" id="cms-mobile-search" hidden>
    <div class="topbar-search w-100">
        <i class="bx bx-search topbar-search-icon"></i>
        <input type="search" class="topbar-search-input" placeholder="@L["Shared.Topbar.SearchPlaceholder"]" autofocus />
        <button class="btn btn-sm btn-link" type="button" data-topbar-mobile-search-close aria-label="@L["Common.Close"]">
            <i class="bx bx-x"></i>
        </button>
    </div>
</div>
