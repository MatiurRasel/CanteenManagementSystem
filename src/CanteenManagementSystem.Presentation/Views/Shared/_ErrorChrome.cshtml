@*
    _ErrorChrome — shared <head> + body styles for the /Views/Error/* pages.
    Each per-status page (401.cshtml, 404.cshtml, …) sets Layout=null and
    invokes <partial name="_ErrorChrome" />. Variables that drive the visual
    are set as ViewData entries before the partial is rendered.
*@
@{
    var code        = ViewData["Code"]        as string ?? "ERR";
    var title       = ViewData["Title"]       as string ?? "Something went wrong";
    var description = ViewData["Description"] as string ?? string.Empty;
    var icon        = ViewData["Icon"]        as string ?? "fa-triangle-exclamation";
    var tone        = ViewData["Tone"]        as string ?? "danger"; // info | warning | danger | secondary
    var ctaUrl      = ViewData["CtaUrl"]      as string ?? "/";
    var ctaLabel    = ViewData["CtaLabel"]    as string ?? "Back to home";
    var ctaIcon     = ViewData["CtaIcon"]     as string ?? "fa-house";
    var secondaryUrl   = ViewData["SecondaryUrl"]   as string;
    var secondaryLabel = ViewData["SecondaryLabel"] as string;
    var secondaryIcon  = ViewData["SecondaryIcon"]  as string ?? "fa-arrow-left";
    string ToneColor() => tone switch
    {
        "info"      => "#3b82f6",
        "warning"   => "#f59e0b",
        "secondary" => "var(--muted)",
        _           => "#ef4444"
    };
    string ToneSoft() => tone switch
    {
        "info"      => "rgba(59,130,246,.10)",
        "warning"   => "rgba(245,158,11,.10)",
        "secondary" => "rgba(100,116,139,.10)",
        _           => "rgba(239,68,68,.10)"
    };
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
<link rel="stylesheet" href="~/css/shadcn.css" asp-append-version="true" />
<link rel="icon" href="~/favicon.ico" />
<style>
    html, body { height: 100%; margin: 0; }
    body {
        background:
            radial-gradient(circle at 20% 10%, @ToneSoft() 0, transparent 45%),
            radial-gradient(circle at 80% 90%, @ToneSoft() 0, transparent 45%),
            var(--bg);
        color: var(--fg);
        font-family: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex; align-items: center; justify-content: center;
        padding: 1.5rem;
    }
    .err-shell { max-width: 640px; width: 100%; text-align: center; }
    .err-code {
        font-weight: 900;
        font-size: clamp(6rem, 18vw, 10rem);
        line-height: 1; letter-spacing: -0.05em;
        background: linear-gradient(180deg, @ToneColor() 0%, color-mix(in srgb, @ToneColor() 40%, transparent) 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }
    .err-icon-plate {
        width: 72px; height: 72px;
        border-radius: var(--rad-lg);
        background: @ToneSoft();
        color: @ToneColor();
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 2rem;
        margin: 0 0 1rem;
    }
    .err-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0 0 .75rem;
        color: var(--fg);
    }
    .err-description {
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.55;
        margin: 0 auto 2rem;
        max-width: 480px;
    }
    .err-actions {
        display: flex; gap: .75rem;
        justify-content: center; flex-wrap: wrap;
    }
    .err-trace {
        margin-top: 2.5rem;
        font-size: .72rem;
        color: var(--muted);
        opacity: .6;
        font-family: var(--font-mono);
    }
    .err-brand {
        position: fixed; top: 1.5rem; left: 1.5rem;
        display: inline-flex; align-items: center; gap: .5rem;
        color: var(--muted);
        text-decoration: none;
        font-size: .85rem; font-weight: 600;
    }
    .err-brand:hover { color: var(--accent); }
    .err-brand .dot {
        width: 28px; height: 28px;
        border-radius: 8px;
        background: var(--accent);
        color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: .75rem;
    }
</style>
@functions {
    public string ColorMix(string a, string b) => $"color-mix(in srgb, {a} 40%, {b})";
}
