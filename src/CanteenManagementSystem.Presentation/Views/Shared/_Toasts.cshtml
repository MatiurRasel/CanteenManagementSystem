@*
   _Toasts.cshtml — Bootstrap-toast renderer for TempData flashes.
   ------------------------------------------------------------
   Reads BOTH the legacy keys ("SuccessMessage" / "ErrorMessage" /
   "WarningMessage" / "InfoMessage") AND the newer dotted keys
   ("Flash.Success" / "Flash.Error" / "Flash.Warning" / "Flash.Info") so any
   controller built against either convention surfaces a toast.

   Auto-dismiss after 5 s for success/info, 8 s for warning/error.
   Fixed bottom-right; on mobile takes full width.
*@
@{
    var flashes = new[]
    {
        new { Variant = "success", Icon = "fa-circle-check",         Msg = (TempData["SuccessMessage"] ?? TempData["Flash.Success"]) as string, Delay = 5000 },
        new { Variant = "danger",  Icon = "fa-circle-xmark",         Msg = (TempData["ErrorMessage"]   ?? TempData["Flash.Error"])   as string, Delay = 8000 },
        new { Variant = "warning", Icon = "fa-triangle-exclamation", Msg = (TempData["WarningMessage"] ?? TempData["Flash.Warning"]) as string, Delay = 8000 },
        new { Variant = "info",    Icon = "fa-circle-info",          Msg = (TempData["InfoMessage"]    ?? TempData["Flash.Info"])    as string, Delay = 5000 }
    };
    var live = flashes.Where(f => !string.IsNullOrWhiteSpace(f.Msg)).ToArray();
}

@if (live.Length > 0)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        @foreach (var f in live)
        {
            <div class="toast align-items-center text-bg-@f.Variant border-0 mb-2 shadow"
                 role="alert" aria-live="assertive" aria-atomic="true"
                 data-bs-autohide="true" data-bs-delay="@f.Delay">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-start gap-2">
                        <i class="fa-solid @f.Icon mt-1"></i>
                        <div class="flex-grow-1">@f.Msg</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.toast').forEach(function (el) {
                new bootstrap.Toast(el).show();
            });
        });
    </script>
}
