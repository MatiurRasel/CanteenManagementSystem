@*
    _UiAlert — inline notification with icon + optional heading.

    USAGE
        <partial name="_UiAlert" model="@new UiAlertOptions {
            Variant  = UiAlertVariant.Warning,
            Heading  = "Heads up",
            Body     = "Three pending callbacks couldn't be verified — see the retry log.",
            Icon     = "bx-error"
        }" />

    Icon accepts Boxicons ("bx-*" / "bxs-*"); legacy "fa-*" still renders via Font Awesome.
*@
@model CanteenManagementSystem.Presentation.Models.UiAlertOptions
@{
    var opts = Model ?? new CanteenManagementSystem.Presentation.Models.UiAlertOptions();
    var variantClass = "variant-" + opts.Variant.ToString().ToLowerInvariant();
    var icon = string.IsNullOrEmpty(opts.Icon)
        ? opts.Variant switch
        {
            CanteenManagementSystem.Presentation.Models.UiAlertVariant.Success => "bx-check-circle",
            CanteenManagementSystem.Presentation.Models.UiAlertVariant.Warning => "bx-error",
            CanteenManagementSystem.Presentation.Models.UiAlertVariant.Danger  => "bx-x-circle",
            CanteenManagementSystem.Presentation.Models.UiAlertVariant.Info    => "bx-info-circle",
            _ => "bx-info-circle"
        }
        : opts.Icon;
    string IconClass(string i) => i.StartsWith("fa-") ? $"fa-solid {i}" : $"bx {i}";
}
<div class="ui-alert @variantClass" role="alert">
    <i class="@IconClass(icon)" aria-hidden="true"></i>
    <div class="flex-grow-1">
        @if (!string.IsNullOrWhiteSpace(opts.Heading))
        {
            <div class="ui-alert-heading">@opts.Heading</div>
        }
        <div>@opts.Body</div>
    </div>
</div>
