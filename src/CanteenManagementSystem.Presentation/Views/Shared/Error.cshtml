@*
    Fallback exception view — invoked by Microsoft.AspNetCore.Diagnostics if
    `UseExceptionHandler("/Home/Error")` is wired and our ErrorController didn't
    catch it. The real per-status pages live under /Views/Error/{code}.cshtml.
*@
@model ErrorViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Code"]          = "500";
    ViewData["Tone"]          = "danger";
    ViewData["Icon"]          = "bx-bug";
    ViewData["Title"]         = L["Error.500.Title"].Value;
    ViewData["Description"]   = L["Error.500.Description"].Value;
    ViewData["CtaUrl"]        = "/";
    ViewData["CtaLabel"]      = L["Error.Shared.BackHome"].Value;
    ViewData["CtaIcon"]       = "bx-home";
    ViewData["TraceId"]       = Model?.RequestId;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.Shared.ServerError"] · @L["Account.Common.BrandName"]</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
