@*
    _ErrorPage — visual content block for every /error/{code} page.
    Reads the same ViewData values that _ErrorChrome reads.
*@
@{
    var code        = ViewData["Code"]        as string ?? "ERR";
    var title       = ViewData["Title"]       as string ?? "Something went wrong";
    var description = ViewData["Description"] as string ?? string.Empty;
    var icon        = ViewData["Icon"]        as string ?? "fa-triangle-exclamation";
    var ctaUrl      = ViewData["CtaUrl"]      as string ?? "/";
    var ctaLabel    = ViewData["CtaLabel"]    as string ?? "Back to home";
    var ctaIcon     = ViewData["CtaIcon"]     as string ?? "fa-house";
    var secondaryUrl   = ViewData["SecondaryUrl"]   as string;
    var secondaryLabel = ViewData["SecondaryLabel"] as string;
    var secondaryIcon  = ViewData["SecondaryIcon"]  as string ?? "fa-arrow-left";
    var traceId        = ViewData["TraceId"]        as string;
}
<a href="/" class="err-brand"><span class="dot"><i class="fa-solid fa-utensils"></i></span> SmartCanteen</a>

<div class="err-shell">
    <div class="err-icon-plate"><i class="fa-solid @icon"></i></div>
    <div class="err-code">@code</div>
    <h1 class="err-title">@title</h1>
    <p class="err-description">@description</p>
    <div class="err-actions">
        <a href="@ctaUrl" class="btn btn-primary">
            <i class="fa-solid @ctaIcon me-2"></i>@ctaLabel
        </a>
        @if (!string.IsNullOrEmpty(secondaryUrl))
        {
            <a href="@secondaryUrl" class="btn btn-outline-secondary">
                <i class="fa-solid @secondaryIcon me-2"></i>@secondaryLabel
            </a>
        }
        <button type="button" class="btn btn-outline-secondary" onclick="history.length > 1 ? history.back() : (location.href = '/')">
            <i class="fa-solid fa-rotate-left me-2"></i>Go back
        </button>
    </div>
    @if (!string.IsNullOrEmpty(traceId))
    {
        <div class="err-trace">Trace ID: @traceId</div>
    }
</div>
