@*
    _ErrorPage — visual content block for every /error/{code} page.
    Reads the same ViewData values that _ErrorChrome reads.

    Icons accept Boxicons classes ("bx-*" / "bxs-*"); legacy "fa-*" values
    still render through Font Awesome until the migration sweep completes.
*@
@inject IStringLocalizer<SharedResource> L
@{
    var code        = ViewData["Code"]        as string ?? "ERR";
    var title       = ViewData["Title"]       as string ?? L["Shared.ErrorPage.DefaultTitle"].Value;
    var description = ViewData["Description"] as string ?? string.Empty;
    var icon        = ViewData["Icon"]        as string ?? "bx-error";
    var ctaUrl      = ViewData["CtaUrl"]      as string ?? "/";
    var ctaLabel    = ViewData["CtaLabel"]    as string ?? L["Error.Shared.BackHome"].Value;
    var ctaIcon     = ViewData["CtaIcon"]     as string ?? "bx-home";
    var secondaryUrl   = ViewData["SecondaryUrl"]   as string;
    var secondaryLabel = ViewData["SecondaryLabel"] as string;
    var secondaryIcon  = ViewData["SecondaryIcon"]  as string ?? "bx-left-arrow-alt";
    var traceId        = ViewData["TraceId"]        as string;
    string IconClass(string i) => i.StartsWith("fa-") ? $"fa-solid {i}" : $"bx {i}";
}
<a href="/" class="err-brand"><span class="dot"><i class="bx bxs-restaurant"></i></span> @L["Account.Common.BrandName"]</a>

<div class="err-shell">
    <div class="err-icon-plate"><i class="@IconClass(icon)"></i></div>
    <div class="err-code">@code</div>
    <h1 class="err-title">@title</h1>
    <p class="err-description">@description</p>
    <div class="err-actions">
        <a href="@ctaUrl" class="btn btn-primary">
            <i class="@IconClass(ctaIcon) me-2"></i>@ctaLabel
        </a>
        @if (!string.IsNullOrEmpty(secondaryUrl))
        {
            <a href="@secondaryUrl" class="btn btn-outline-secondary">
                <i class="@IconClass(secondaryIcon) me-2"></i>@secondaryLabel
            </a>
        }
        <button type="button" class="btn btn-outline-secondary" onclick="history.length > 1 ? history.back() : (location.href = '/')">
            <i class="bx bx-undo me-2"></i>@L["Error.Shared.GoBack"]
        </button>
    </div>
    @if (!string.IsNullOrEmpty(traceId))
    {
        <div class="err-trace">@L["Shared.ErrorPage.TraceId", traceId]</div>
    }
</div>
