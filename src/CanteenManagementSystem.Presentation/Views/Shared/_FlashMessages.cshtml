@inject IStringLocalizer<SharedResource> L
@{
    var flashes = new[]
    {
        new { Variant = "success", Icon = "bx-check-circle", Msg = TempData["SuccessMessage"] as string },
        new { Variant = "danger",  Icon = "bx-x-circle",     Msg = TempData["ErrorMessage"]   as string },
        new { Variant = "warning", Icon = "bx-error",        Msg = TempData["WarningMessage"] as string },
        new { Variant = "info",    Icon = "bx-info-circle",  Msg = TempData["InfoMessage"]    as string },
    };
}

@foreach (var flash in flashes)
{
    if (!string.IsNullOrWhiteSpace(flash.Msg))
    {
        <div class="alert alert-@flash.Variant alert-dismissible fade show shadow-sm d-flex align-items-start gap-2 mb-3" role="alert">
            <i class="bx @flash.Icon mt-1"></i>
            <div class="flex-grow-1">@flash.Msg</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }
}
