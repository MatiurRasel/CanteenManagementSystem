@*
    /admin/users/invite — create + role-assign a new user.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.UsersAdminController.InviteForm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["UsersAdmin.Index.InviteUser"].Value;
    var roles = ViewBag.Roles as IList<Platform.Domain.Identity.Role> ?? new List<Platform.Domain.Identity.Role>();
    var header = new UiPageHeaderOptions
    {
        Title    = L["UsersAdmin.Invite.Heading"].Value,
        Subtitle = L["UsersAdmin.Invite.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/users'><i class='bx bx-arrow-back me-1'></i> {L["UsersAdmin.AllUsers"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="Invite">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="ui-label">@L["UsersAdmin.Index.Username"]</label>
                                <input asp-for="UserName" class="ui-input form-control" placeholder="ccpc.operator2" autocomplete="off" />
                                <div class="ui-help-text">@L["UsersAdmin.Invite.UsernameHelp"]</div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DisplayName" class="ui-label">@L["UsersAdmin.DisplayName"]</label>
                                <input asp-for="DisplayName" class="ui-input form-control" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="ui-label">@L["Common.Email"]</label>
                                <input asp-for="Email" class="ui-input form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserKind" class="ui-label">@L["UsersAdmin.Kind"]</label>
                                <select asp-for="UserKind" class="form-select ui-select">
                                    <option value="Operator">@L["UsersAdmin.UserKind.Operator"]</option>
                                    <option value="Admin">@L["UsersAdmin.UserKind.Admin"]</option>
                                    <option value="Cashier">@L["UsersAdmin.UserKind.Cashier"]</option>
                                    <option value="Auditor">@L["UsersAdmin.UserKind.Auditor"]</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RoleCode" class="ui-label">@L["UsersAdmin.Invite.InitialRole"]</label>
                                <select asp-for="RoleCode" class="form-select ui-select">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r.RoleCode">@r.DisplayName (@r.RoleCode)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="ui-card sticky-top" style="top:5rem">
                    <div class="ui-card-header"><div class="ui-card-title">@L["UsersAdmin.Invite.WhatHappensNext"]</div></div>
                    <div class="ui-card-body">
                        <ul class="small ui-stack-sm mb-3" style="padding-left:1.2rem">
                            <li>@L["UsersAdmin.Invite.Step1"]</li>
                            <li>@L["UsersAdmin.Invite.Step2"]</li>
                            <li>@L["UsersAdmin.Invite.Step3"]</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bx bx-send me-1"></i> @L["UsersAdmin.Invite.CreateUser"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@L["Common.Cancel"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
