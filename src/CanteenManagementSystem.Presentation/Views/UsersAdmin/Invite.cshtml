@*
    /admin/users/invite — create + role-assign a new user.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.UsersAdminController.InviteForm
@{
    ViewData["Title"] = "Invite user";
    var roles = ViewBag.Roles as IList<Platform.Domain.Identity.Role> ?? new List<Platform.Domain.Identity.Role>();
    var header = new UiPageHeaderOptions
    {
        Title    = "Invite a user",
        Subtitle = "Create the account, pick the role, ship a one-time password.",
        Actions  = Html.Raw("<a class='btn btn-outline-secondary btn-sm' href='/admin/users'><i class='fa-solid fa-arrow-left me-1'></i> All users</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="Invite">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="ui-label">Username</label>
                                <input asp-for="UserName" class="ui-input form-control" placeholder="ccpc.operator2" autocomplete="off" />
                                <div class="ui-help-text">Lower-cased on save. Must be unique platform-wide.</div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DisplayName" class="ui-label">Display name</label>
                                <input asp-for="DisplayName" class="ui-input form-control" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="ui-label">Email</label>
                                <input asp-for="Email" class="ui-input form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserKind" class="ui-label">Kind</label>
                                <select asp-for="UserKind" class="form-select ui-select">
                                    <option value="Operator">Operator</option>
                                    <option value="Admin">Admin</option>
                                    <option value="Cashier">Cashier</option>
                                    <option value="Auditor">Auditor</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RoleCode" class="ui-label">Initial role</label>
                                <select asp-for="RoleCode" class="form-select ui-select">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r.RoleCode">@r.DisplayName (@r.RoleCode)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="ui-card sticky-top" style="top:5rem">
                    <div class="ui-card-header"><div class="ui-card-title">What happens next</div></div>
                    <div class="ui-card-body">
                        <ul class="small ui-stack-sm mb-3" style="padding-left:1.2rem">
                            <li>User created in <code>AppUsers</code> bound to this tenant</li>
                            <li>Random one-time password is returned on the next page</li>
                            <li>User is forced to change it at first login</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane me-1"></i> Create user
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
