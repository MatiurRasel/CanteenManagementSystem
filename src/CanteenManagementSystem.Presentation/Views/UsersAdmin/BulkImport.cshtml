@*
    /admin/users/bulk-import — CSV upload of multiple users at once.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.UsersAdminController.BulkImportResult
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["UsersAdmin.BulkImport.PageTitle"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["UsersAdmin.BulkImport.Heading"].Value,
        Subtitle = L["UsersAdmin.BulkImport.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/users'><i class='bx bx-arrow-back me-1'></i> {L["UsersAdmin.AllUsers"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3">
        <div class="col-lg-7">
            <form method="post" enctype="multipart/form-data" asp-action="BulkImport">
                @Html.AntiForgeryToken()
                <div class="ui-card">
                    <div class="ui-card-body">
                        <label class="ui-label">@L["UsersAdmin.BulkImport.CsvFile"]</label>
                        <input type="file" name="file" accept=".csv" class="ui-input form-control" required />
                        <div class="ui-help-text">@L["UsersAdmin.BulkImport.CsvHelp"]</div>
                    </div>
                    <div class="ui-card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-upload me-1"></i> @L["UsersAdmin.BulkImport.Import"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@L["Common.Cancel"]</a>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="ui-card">
                <div class="ui-card-header"><div class="ui-card-title">@L["UsersAdmin.BulkImport.ExpectedShape"]</div></div>
                <div class="ui-card-body">
                    <pre class="ui-mono small mb-2" style="background:var(--surface-2);padding:.75rem;border-radius:var(--rad);border:1px solid var(--border);white-space:pre-wrap">UserName,DisplayName,Email,UserKind,RoleCode,ExternalId
ccpc.op1,Imran Ahmed,imran@ccpc.edu,Operator,Operator,
ccpc.op2,Reza Karim,reza@ccpc.edu,Cashier,Cashier,STAFF-001
ccpc.aud1,Audit One,audit@ccpc.edu,Auditor,Auditor,</pre>
                    <p class="ui-muted small mb-0">
                        @L["Common.Required"]: <code>UserName</code>, <code>DisplayName</code>.
                        @L["Common.Optional"]: <code>Email</code>, <code>UserKind</code> (@L["UsersAdmin.BulkImport.Default"] <code>Operator</code>),
                        <code>RoleCode</code> (@L["UsersAdmin.BulkImport.Default"] <code>Operator</code>), <code>ExternalId</code>
                        (@L["UsersAdmin.BulkImport.ExternalIdHint"]).
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
