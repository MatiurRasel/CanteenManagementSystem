@*
    /admin/notification-templates/{key} — single-template editor.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.NotificationTemplatesController.EditForm
@inject IStringLocalizer<SharedResource> L
@{
    var friendly = ViewBag.FriendlyName as string ?? Model.Key;
    ViewData["Title"] = L["NotificationTemplates.Edit.TitleFormat", friendly].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = friendly,
        Subtitle = Model.Key,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/notification-templates'><i class='bx bx-arrow-back me-1'></i> {L["NotificationTemplates.Edit.AllTemplates"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3">
        <div class="col-lg-8">
            <form method="post" asp-action="Edit" asp-route-key="@Model.Key">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Key" />

                <div class="ui-card">
                    <div class="ui-card-header"><div class="ui-card-title">@L["NotificationTemplates.Edit.EmailSubjectTitle"]</div></div>
                    <div class="ui-card-body">
                        <label class="ui-label" asp-for="Subject">@L["NotificationTemplates.Edit.SubjectLabel"]</label>
                        <input asp-for="Subject" class="ui-input form-control"
                               placeholder="@L["NotificationTemplates.Edit.SubjectPlaceholder"]"
                               data-bs-toggle="tooltip" title="@L["NotificationTemplates.Edit.SubjectTooltip"]" />
                    </div>
                </div>

                <div class="ui-card mt-3">
                    <div class="ui-card-header"><div class="ui-card-title">@L["NotificationTemplates.Edit.BodyTitle"]</div></div>
                    <div class="ui-card-body">
                        <textarea asp-for="Body" class="ui-input form-control ui-mono" rows="10"
                                  data-bs-toggle="tooltip"
                                  title="@L["NotificationTemplates.Edit.BodyTooltip"]"
                                  placeholder="@L["NotificationTemplates.Edit.BodyPlaceholder"]"></textarea>
                        <div class="ui-help-text">@L["NotificationTemplates.Edit.SmsCostHint"]</div>
                    </div>
                    <div class="ui-card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> @L["Common.Save"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@L["Common.Cancel"]</a>
                    </div>
                </div>
            </form>

            @* Test-send sits OUTSIDE the edit form so they don't share a submit *@
            <form method="post" asp-action="TestSend" asp-route-key="@Model.Key" class="ui-card mt-3">
                @Html.AntiForgeryToken()
                <div class="ui-card-header">
                    <div>
                        <div class="ui-card-title">@L["NotificationTemplates.Edit.TestSendTitle"]</div>
                        <div class="ui-card-muted-body">
                            @L["NotificationTemplates.Edit.TestSendHint"]
                        </div>
                    </div>
                </div>
                <div class="ui-card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="ui-label">@L["NotificationTemplates.Edit.ChannelLabel"]</label>
                            <select name="Channel" class="form-select ui-select">
                                <option value="Sms">@L["NotificationTemplates.Channel.Sms"]</option>
                                <option value="Email">@L["Common.Email"]</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="ui-label">@L["NotificationTemplates.TestSend.RecipientLabel"]</label>
                            <input name="Recipient" class="ui-input form-control"
                                   placeholder="@L["NotificationTemplates.Edit.RecipientPlaceholder"]" required />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bx bx-send me-1"></i> @L["NotificationTemplates.TestSend.SendButton"]
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="ui-card sticky-top" style="top:5rem">
                <div class="ui-card-header"><div class="ui-card-title">@L["NotificationTemplates.Edit.TokensTitle"]</div></div>
                <div class="ui-card-body">
                    <ul class="small mb-3 ui-stack-sm" style="list-style:none;padding-left:0">
                        <li><code>{customer.name}</code></li>
                        <li><code>{customer.phone}</code></li>
                        <li><code>{order.number}</code></li>
                        <li><code>{order.total}</code></li>
                        <li><code>{order.status}</code></li>
                        <li><code>{wallet.balance}</code></li>
                        <li><code>{wallet.amount}</code> <span class="ui-muted">@L["NotificationTemplates.Edit.TokenRechargeNote"]</span></li>
                        <li><code>{tenant.name}</code></li>
                    </ul>
                    <p class="ui-muted small mb-0">
                        @L["NotificationTemplates.Edit.FallbackHint"]
                        <code>NotificationTemplates</code>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
