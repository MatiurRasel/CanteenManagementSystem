@*
    /admin/inventory/stock-takes — stock-take history + "Begin take" button.
*@
@using CanteenManagementSystem.Application.Inventory
@using CanteenManagementSystem.Domain.Inventory
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<StockTakeSummary>
@{
    ViewData["Title"] = "Stock takes";
    var beginAction = $@"
        <form method=""post"" action=""/admin/inventory/stock-takes/begin"" class=""d-inline"">
            {Html.AntiForgeryToken()}
            <button class=""btn btn-sm btn-primary"" type=""submit""><i class=""fa-solid fa-clipboard-check me-1""></i> Begin take</button>
        </form>";
    var header = new UiPageHeaderOptions
    {
        Title    = "Stock takes",
        Subtitle = "Periodic physical-vs-system counts. Begin one → walk the shelves → submit → variance recorded.",
        Actions  = Html.Raw(beginAction)
    };
    UiBadgeVariant V(StockTakeStatus s) => s switch
    {
        StockTakeStatus.Draft     => UiBadgeVariant.Info,
        StockTakeStatus.Submitted => UiBadgeVariant.Success,
        StockTakeStatus.Cancelled => UiBadgeVariant.Warning,
        _ => UiBadgeVariant.Secondary
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions { Icon = "fa-clipboard-check", Title = "No stock takes yet", Description = "Click Begin take above to snapshot every active item's expected vs counted quantity." };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>Started</th>
                        <th>Completed</th>
                        <th class="text-end">Items</th>
                        <th class="text-end">Net variance</th>
                        <th>Status</th>
                        <th class="text-end" style="width:1%">Open</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model)
                {
                    var b = new UiBadgeOptions { Text = t.Status.ToString(), Variant = V(t.Status), WithDot = true };
                    <tr>
                        <td class="ui-muted ui-tabular">@t.StartedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="ui-muted ui-tabular">@(t.CompletedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="text-end ui-tabular">@t.LineCount</td>
                        <td class="text-end ui-tabular @(t.TotalVariance < 0 ? "text-danger" : t.TotalVariance > 0 ? "text-success" : "ui-muted")">@t.TotalVariance.ToString("+#;-#;0")</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" href="/admin/inventory/stock-takes/@t.StockTakeId">
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
