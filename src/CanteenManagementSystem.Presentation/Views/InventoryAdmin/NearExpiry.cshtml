@*
    /admin/inventory/near-expiry — items expiring within the next N hours.
*@
@using CanteenManagementSystem.Application.Inventory
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<NearExpiryRow>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["InventoryAdmin.NearExpiry.Title"].Value;
    int hours = ViewBag.HoursWindow as int? ?? 8;

    var hoursForm = $@"
        <form method='get' class='d-flex gap-2 align-items-end'>
            <div>
                <label class='ui-label mb-1'>{L["InventoryAdmin.NearExpiry.WindowHours"].Value}</label>
                <select name='hours' class='form-select ui-select form-select-sm' onchange='this.form.submit()'>
                    <option value='2'  {(hours == 2  ? "selected" : "")}>{L["InventoryAdmin.NearExpiry.NextHours", 2].Value}</option>
                    <option value='4'  {(hours == 4  ? "selected" : "")}>{L["InventoryAdmin.NearExpiry.NextHours", 4].Value}</option>
                    <option value='8'  {(hours == 8  ? "selected" : "")}>{L["InventoryAdmin.NearExpiry.NextHours", 8].Value}</option>
                    <option value='24' {(hours == 24 ? "selected" : "")}>{L["InventoryAdmin.NearExpiry.NextHours", 24].Value}</option>
                    <option value='48' {(hours == 48 ? "selected" : "")}>{L["InventoryAdmin.NearExpiry.NextHours", 48].Value}</option>
                </select>
            </div>
        </form>";
    var header = new UiPageHeaderOptions
    {
        Title    = L["InventoryAdmin.NearExpiry.Title"].Value,
        Subtitle = L["InventoryAdmin.NearExpiry.Subtitle", hours].Value,
        Actions  = Html.Raw(hoursForm)
    };
    int expired  = Model.Count(r => r.HoursToExpiry < 0);
    int expiringSoon = Model.Count(r => r.HoursToExpiry >= 0);

    var kpiExpired = new UiKpiOptions
    {
        Label = L["InventoryAdmin.NearExpiry.KpiExpired"].Value,
        Value = expired.ToString(),
        Icon  = "bx-error-circle",
        Trend = expired > 0 ? UiKpiTrend.Down : UiKpiTrend.None
    };
    var kpiSoon = new UiKpiOptions
    {
        Label = L["InventoryAdmin.NearExpiry.KpiExpiringSoon"].Value,
        Value = expiringSoon.ToString(),
        Hint  = L["InventoryAdmin.NearExpiry.WithinHours", hours].Value,
        Icon  = "bx-hourglass"
    };
    var kpiQty = new UiKpiOptions
    {
        Label = L["InventoryAdmin.NearExpiry.KpiStockAtRisk"].Value,
        Value = Model.Sum(r => r.AvailableQuantity).ToString("N0"),
        Hint  = L["InventoryAdmin.NearExpiry.AcrossRows"].Value,
        Icon  = "bx-package"
    };
    var kpiValue = new UiKpiOptions
    {
        Label = L["InventoryAdmin.NearExpiry.KpiValueAtRisk"].Value,
        Value = "৳ " + Model.Sum(r => r.AvailableQuantity * r.Price).ToString("N0"),
        Icon  = "bx-coin-stack"
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiExpired" /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiSoon"    /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiQty"     /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiValue"   /></div>
    </div>

    @if (Model.Count == 0)
    {
        var ok = new UiAlertOptions
        {
            Variant = UiAlertVariant.Success,
            Heading = L["InventoryAdmin.NearExpiry.NothingExpiring"].Value,
            Body    = L["InventoryAdmin.NearExpiry.NothingExpiringBody"].Value
        };
        <partial name="_UiAlert" model="ok" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["InventoryAdmin.NearExpiry.Item"]</th>
                        <th>@L["InventoryAdmin.NearExpiry.MenuDate"]</th>
                        <th class="text-end">@L["InventoryAdmin.NearExpiry.ShelfLife"]</th>
                        <th>@L["InventoryAdmin.NearExpiry.ExpiresUtc"]</th>
                        <th class="text-end">@L["InventoryAdmin.NearExpiry.Available"]</th>
                        <th class="text-end">@L["InventoryAdmin.NearExpiry.Value"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end">@L["InventoryAdmin.NearExpiry.Action"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    var isExpired = r.HoursToExpiry < 0;
                    var soon      = r.HoursToExpiry >= 0 && r.HoursToExpiry < 2;
                    var b = new UiBadgeOptions
                    {
                        Text    = isExpired
                            ? L["InventoryAdmin.NearExpiry.ExpiredAgo", Math.Abs((int)r.HoursToExpiry)].Value
                            : L["InventoryAdmin.NearExpiry.InHours", (int)Math.Ceiling(r.HoursToExpiry)].Value,
                        Variant = isExpired ? UiBadgeVariant.Danger
                                : soon      ? UiBadgeVariant.Warning
                                            : UiBadgeVariant.Info,
                        WithDot = true
                    };
                    <tr>
                        <td class="ui-text-strong">@r.ItemName</td>
                        <td class="small">@r.MenuDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end ui-tabular">@L["InventoryAdmin.NearExpiry.HoursAbbrev", r.ShelfLifeHours]</td>
                        <td class="ui-mono small">@r.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end ui-tabular">@r.AvailableQuantity</td>
                        <td class="text-end ui-tabular">৳ @((r.AvailableQuantity * r.Price).ToString("N0"))</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end">
                            <form asp-action="RecordWaste" method="post" class="d-inline"
                                  data-cl-confirm="@L["InventoryAdmin.NearExpiry.ConfirmWriteOff", r.AvailableQuantity, r.ItemName]" data-cl-confirm-variant="warning">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="foodItemId" value="@r.FoodItemId" />
                                <input type="hidden" name="quantity"   value="@r.AvailableQuantity" />
                                <input type="hidden" name="reason"     value="@CanteenManagementSystem.Domain.Inventory.WasteReason.Expired" />
                                <input type="hidden" name="notes"      value="Auto-write-off from /admin/inventory/near-expiry" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                    <i class="bx bx-trash me-1"></i> @L["InventoryAdmin.NearExpiry.WriteOff"]
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
