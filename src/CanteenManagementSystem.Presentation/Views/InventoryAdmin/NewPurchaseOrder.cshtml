@*
    /admin/inventory/pos/new — compose a purchase order.
*@
@using CanteenManagementSystem.Domain.Inventory
@using CanteenManagementSystem.Domain.Menu
@using CanteenManagementSystem.Presentation.Models
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["InventoryAdmin.NewPurchaseOrder.Title"].Value;
    var suppliers = (IReadOnlyList<Supplier>)(ViewBag.Suppliers ?? new List<Supplier>());
    var foods     = (List<FoodItem>)(ViewBag.FoodItems ?? new List<FoodItem>());

    var header = new UiPageHeaderOptions
    {
        Title    = L["InventoryAdmin.NewPurchaseOrder.Title"].Value,
        Subtitle = L["InventoryAdmin.NewPurchaseOrder.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-ghost' href='/admin/inventory/pos'><i class='bx bx-arrow-back me-1'></i> {L["Common.Back"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" action="/admin/inventory/pos/save" id="po-form" data-cl-form>
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="ui-card">
                    <div class="ui-card-header"><div class="ui-card-title">@L["InventoryAdmin.NewPurchaseOrder.Header"]</div></div>
                    <div class="ui-card-body ui-stack">
                        <div>
                            <label class="ui-label">@L["InventoryAdmin.PurchaseOrders.Supplier"] <span class="ui-muted">*</span></label>
                            <select name="supplierId" class="form-select ui-select" required>
                                <option value="" disabled selected>@L["InventoryAdmin.NewPurchaseOrder.PickOne"]</option>
                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.SupplierId">@s.Name</option>
                                }
                            </select>
                            @if (suppliers.Count == 0)
                            {
                                <div class="ui-help-text">@L["InventoryAdmin.Suppliers.Empty.Title"] — <a href="/admin/inventory/suppliers/edit">@L["InventoryAdmin.NewPurchaseOrder.AddOneFirst"]</a></div>
                            }
                        </div>
                        <div>
                            <label class="ui-label">@L["InventoryAdmin.NewPurchaseOrder.PoNumberLabel"] <span class="ui-muted">(@L["Common.Optional"])</span></label>
                            <input class="ui-input form-control" name="poNumber" placeholder="@L["InventoryAdmin.NewPurchaseOrder.AutoPlaceholder"]" maxlength="40" />
                        </div>
                        <div>
                            <label class="ui-label">@L["InventoryAdmin.NewPurchaseOrder.Notes"]</label>
                            <input class="ui-input form-control" name="notes" maxlength="500" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="ui-card">
                    <div class="ui-card-header">
                        <div class="ui-card-title">@L["InventoryAdmin.PurchaseOrders.Lines"]</div>
                        <button type="button" class="btn btn-sm btn-ghost" id="po-add-line">
                            <i class="bx bx-plus me-1"></i> @L["InventoryAdmin.NewPurchaseOrder.AddLine"]
                        </button>
                    </div>
                    <div class="ui-card-body">
                        <div class="ui-table-wrap">
                            <table class="table ui-table">
                                <thead>
                                    <tr>
                                        <th>@L["InventoryAdmin.NewPurchaseOrder.Item"]</th>
                                        <th class="text-end" style="width:18%">@L["Common.Quantity"]</th>
                                        <th class="text-end" style="width:24%">@L["InventoryAdmin.NewPurchaseOrder.UnitCost"] ৳</th>
                                        <th class="text-end" style="width:24%">@L["InventoryAdmin.NewPurchaseOrder.LineTotal"] ৳</th>
                                        <th class="text-end" style="width:1%">&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody id="po-lines">
                                    <tr class="po-line-row">
                                        <td>
                                            <select name="foodItemId" class="form-select ui-select" required>
                                                <option value="" disabled selected>@L["InventoryAdmin.NewPurchaseOrder.Pick"]</option>
                                                @foreach (var f in foods) { <option value="@f.FoodItemID" data-price="@f.Price">@f.ItemName (৳ @f.Price.ToString("N0"))</option> }
                                            </select>
                                        </td>
                                        <td><input name="quantity" type="number" min="1" step="1" class="ui-input form-control text-end" required /></td>
                                        <td><input name="unitCost" type="number" min="0" step="0.01" class="ui-input form-control text-end" required /></td>
                                        <td class="text-end ui-tabular line-total">৳ 0</td>
                                        <td class="text-end"><button class="btn btn-ghost btn-sm po-line-del" type="button" tabindex="-1" title="@L["Common.Remove"]"><i class="bx bx-trash"></i></button></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end ui-text-strong">@L["InventoryAdmin.NewPurchaseOrder.GrandTotal"]</td>
                                        <td class="text-end ui-tabular ui-text-strong" id="po-grand-total">৳ 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="ui-row" style="justify-content:flex-end; gap: .5rem; margin-top: 1.5rem">
            <a class="btn btn-ghost" href="/admin/inventory/pos">@L["Common.Cancel"]</a>
            <button class="btn btn-primary" type="submit"><i class="bx bx-send me-1"></i> @L["InventoryAdmin.NewPurchaseOrder.SubmitPo"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var tbody = document.getElementById('po-lines');
            function recalcRow(row) {
                var qty  = parseFloat(row.querySelector('input[name="quantity"]').value) || 0;
                var cost = parseFloat(row.querySelector('input[name="unitCost"]').value) || 0;
                var line = qty * cost;
                row.querySelector('.line-total').textContent = '৳ ' + line.toLocaleString('en-IN', { maximumFractionDigits: 0 });
                recalcTotal();
            }
            function recalcTotal() {
                var total = Array.from(tbody.querySelectorAll('.po-line-row')).reduce(function (acc, row) {
                    var qty  = parseFloat(row.querySelector('input[name="quantity"]').value) || 0;
                    var cost = parseFloat(row.querySelector('input[name="unitCost"]').value) || 0;
                    return acc + qty * cost;
                }, 0);
                document.getElementById('po-grand-total').textContent = '৳ ' + total.toLocaleString('en-IN', { maximumFractionDigits: 0 });
            }
            function bindRow(row) {
                row.querySelectorAll('input').forEach(function (i) { i.addEventListener('input', function () { recalcRow(row); }); });
                row.querySelector('select').addEventListener('change', function (e) {
                    var opt = e.target.options[e.target.selectedIndex];
                    var price = opt && opt.getAttribute('data-price');
                    if (price && !row.querySelector('input[name="unitCost"]').value) {
                        row.querySelector('input[name="unitCost"]').value = price;
                        recalcRow(row);
                    }
                });
                row.querySelector('.po-line-del').addEventListener('click', function () {
                    if (tbody.querySelectorAll('.po-line-row').length === 1) return;
                    row.remove(); recalcTotal();
                });
            }
            tbody.querySelectorAll('.po-line-row').forEach(bindRow);
            document.getElementById('po-add-line').addEventListener('click', function () {
                var clone = tbody.querySelector('.po-line-row').cloneNode(true);
                clone.querySelectorAll('input').forEach(function (i) { i.value = ''; });
                clone.querySelector('select').selectedIndex = 0;
                clone.querySelector('.line-total').textContent = '৳ 0';
                tbody.appendChild(clone); bindRow(clone);
            });
        })();
    </script>
}
