@*
    /admin/inventory/suppliers — supplier list.
*@
@using CanteenManagementSystem.Domain.Inventory
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<Supplier>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["InventoryAdmin.Suppliers.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["InventoryAdmin.Suppliers.Title"].Value,
        Subtitle = L["InventoryAdmin.Suppliers.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-primary' href='/admin/inventory/suppliers/edit'><i class='bx bx-plus me-1'></i> {L["InventoryAdmin.Suppliers.AddSupplier"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions { Icon = "bxs-truck", Title = L["InventoryAdmin.Suppliers.Empty.Title"].Value, Description = L["InventoryAdmin.Suppliers.Empty.Description"].Value, CtaLabel = L["InventoryAdmin.Suppliers.AddSupplier"].Value, CtaUrl = "/admin/inventory/suppliers/edit", CtaIcon = "bx-plus" };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["Common.Name"]</th>
                        <th>@L["InventoryAdmin.Suppliers.Contact"]</th>
                        <th>@L["Common.Email"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end" style="width:1%">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    var badge = new UiBadgeOptions
                    {
                        Text = s.IsActive ? L["Common.Active"].Value : L["Common.Disabled"].Value,
                        Variant = s.IsActive ? UiBadgeVariant.Success : UiBadgeVariant.Secondary,
                        WithDot = true
                    };
                    <tr>
                        <td>
                            <div class="ui-text-strong">@s.Name</div>
                            @if (!string.IsNullOrEmpty(s.ContactName))
                            {
                                <div class="ui-muted" style="font-size:12px">@s.ContactName</div>
                            }
                        </td>
                        <td class="ui-muted">@(s.ContactNo ?? "—")</td>
                        <td class="ui-mono" style="font-size:13px">@(s.Email ?? "—")</td>
                        <td><partial name="_UiBadge" model="badge" /></td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" href="/admin/inventory/suppliers/edit/@s.SupplierId">
                                <i class="bx bx-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
