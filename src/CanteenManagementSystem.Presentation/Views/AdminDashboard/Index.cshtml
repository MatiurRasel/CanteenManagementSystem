@*
    /admin/dashboard — Tenant-admin landing dashboard.
    Reference page demonstrating the shadcn-style design system on a KPI-heavy admin screen.
*@
@using CanteenManagementSystem.Application.Dashboards
@using CanteenManagementSystem.Presentation.Models
@model AdminDashboardSnapshot
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Dashboard"].Value;

    var deltaPct = Model.RevenueYesterday > 0
        ? ((Model.RevenueToday - Model.RevenueYesterday) / Model.RevenueYesterday) * 100m
        : 0m;
    var deltaTrend = deltaPct >= 0 ? UiKpiTrend.Up : UiKpiTrend.Down;
    var deltaText = Model.RevenueYesterday > 0
        ? L["AdminDashboard.Index.VsYesterday", $"{deltaPct:+0.0;-0.0;0}"].Value
        : L["AdminDashboard.Index.NoDataYesterday"].Value;

    var header = new UiPageHeaderOptions
    {
        Title    = L["Common.Today"].Value,
        Subtitle = L["AdminDashboard.Index.Subtitle"].Value,
        Actions  = Html.Raw(
            $"<a class='btn btn-sm btn-ghost' href='/admin/reports-catalog'><i class='bx bx-line-chart me-1'></i> {L["Reports"].Value}</a>" +
            $"<a class='btn btn-sm btn-primary ms-2' href='/Menu/Manage'><i class='bx bx-plus me-1'></i> {L["AdminDashboard.Index.ManageMenu"].Value}</a>"
        )
    };

    var kpiRevenue = new UiKpiOptions { Label = L["AdminDashboard.Index.RevenueToday"].Value,  Value = $"৳ {Model.RevenueToday:N0}", Delta = deltaText, Trend = deltaTrend, Icon = "bx bx-coin-stack" };
    var kpiOrders  = new UiKpiOptions { Label = L["AdminDashboard.Index.OrdersToday"].Value,    Value = Model.OrdersToday.ToString("N0"),   Delta = L["AdminDashboard.Index.DeliveredCount", Model.OrdersDelivered].Value, Icon = "bx bx-receipt" };
    var kpiPending = new UiKpiOptions { Label = L["AdminDashboard.Index.PendingNow"].Value,     Value = Model.OrdersPending.ToString("N0"), Delta = Model.OrdersPending == 0 ? L["AdminDashboard.Index.AllClear"].Value : L["AdminDashboard.Index.NeedsAttention"].Value, Trend = Model.OrdersPending > 5 ? UiKpiTrend.Down : UiKpiTrend.None, Icon = "bx bx-hourglass" };
    var kpiLow     = new UiKpiOptions { Label = L["AdminDashboard.Index.LowStockItems"].Value, Value = Model.LowStockCount.ToString("N0"), Delta = Model.LowStockCount == 0 ? L["AdminDashboard.Index.FullyStocked"].Value : L["AdminDashboard.Index.RestockToday"].Value, Trend = Model.LowStockCount > 0 ? UiKpiTrend.Down : UiKpiTrend.None, Icon = "bx bx-error" };

    UiBadgeVariant OrderBadge(string s) => s switch
    {
        "Delivered" => UiBadgeVariant.Success,
        "Cancelled" => UiBadgeVariant.Secondary,
        "Refunded"  => UiBadgeVariant.Warning,
        "Ready"     => UiBadgeVariant.Primary,
        _ => UiBadgeVariant.Info
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @* KPI strip *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiRevenue" /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiOrders"  /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiPending" /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiLow"     /></div>
    </div>

    <div class="row g-4">
        @* Recent activity *@
        <div class="col-12 col-lg-8">
            <div class="ui-card">
                <div class="ui-card-header">
                    <div>
                        <div class="ui-card-title">@L["Parent.Index.RecentOrders"]</div>
                        <div class="ui-card-muted-body">@L["AdminDashboard.Index.RecentOrdersSubtitle"]</div>
                    </div>
                    <a class="btn btn-sm btn-ghost" href="/admin/receipts/search">
                        @L["AdminDashboard.Index.SearchAll"] <i class="bx bx-right-arrow-alt ms-1"></i>
                    </a>
                </div>
                <div class="ui-card-body p-0">
                    <table class="table table-hover mb-0 ui-table">
                        <thead>
                            <tr>
                                <th>@L["Parent.Index.OrderNumber"]</th>
                                <th>@L["Common.User"]</th>
                                <th class="text-end">@L["Common.Total"]</th>
                                <th>@L["Common.Status"]</th>
                                <th class="text-end">@L["Parent.Index.When"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.RecentOrders.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center py-5 ui-muted">@L["AdminDashboard.Index.NoOrdersToday"]</td></tr>
                        }
                        @foreach (var r in Model.RecentOrders)
                        {
                            var b = new UiBadgeOptions { Text = r.Status, Variant = OrderBadge(r.Status), WithDot = true };
                            <tr>
                                <td class="ui-mono" style="font-size:13px">@r.OrderNumber</td>
                                <td class="ui-text-strong">@r.UserId</td>
                                <td class="text-end ui-tabular">৳ @r.TotalAmount.ToString("N0")</td>
                                <td><partial name="_UiBadge" model="b" /></td>
                                <td class="text-end ui-muted ui-tabular">@r.OrderDate.ToString("HH:mm")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Sidebar — popular items + directory totals + quick links *@
        <div class="col-12 col-lg-4">
            <div class="ui-stack">
                <div class="ui-card">
                    <div class="ui-card-header">
                        <div class="ui-card-title">@L["AdminDashboard.Index.PopularThisWeek"]</div>
                    </div>
                    <div class="ui-card-body">
                        @if (Model.PopularItems.Count == 0)
                        {
                            <div class="ui-muted" style="font-size:13px">@L["AdminDashboard.Index.NoDataYet"]</div>
                        }
                        else
                        {
                            <div class="ui-stack-sm">
                                @{ var maxCount = Math.Max(1, Model.PopularItems.Max(p => p.OrderCount)); }
                                @foreach (var p in Model.PopularItems)
                                {
                                    var pct = (p.OrderCount * 100) / maxCount;
                                    <div>
                                        <div class="ui-row-between" style="font-size:13px">
                                            <span class="ui-text-strong">@p.ItemName</span>
                                            <span class="ui-muted ui-tabular">@p.OrderCount</span>
                                        </div>
                                        <div style="height:6px;background:var(--surface-sunken);border-radius:var(--rad-pill);overflow:hidden;margin-top:6px">
                                            <div style="height:100%;width:@(pct)%;background:var(--accent);border-radius:var(--rad-pill)"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="ui-card">
                    <div class="ui-card-header">
                        <div class="ui-card-title">@L["Directory"]</div>
                        <a class="btn btn-sm btn-ghost" href="/admin/directory">@L["InventoryAdmin.StockTakes.Open"]</a>
                    </div>
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="ui-kpi-label">@L["DirectoryAdminUi.Students"]</div>
                                <div class="ui-kpi-value">@Model.ActiveStudents.ToString("N0")</div>
                            </div>
                            <div class="col-6">
                                <div class="ui-kpi-label">@L["DirectoryAdminUi.Employees"]</div>
                                <div class="ui-kpi-value">@Model.ActiveEmployees.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ui-card">
                    <div class="ui-card-header">
                        <div class="ui-card-title">@L["QuickActions"]</div>
                    </div>
                    <div class="ui-card-body ui-stack-sm">
                        <a class="btn btn-outline-secondary btn-sm w-100" href="/admin/inventory/stock-takes">
                            <i class="bx bx-task me-1"></i> @L["AdminDashboard.Index.BeginStockTake"]
                        </a>
                        <a class="btn btn-outline-secondary btn-sm w-100" href="/admin/inventory/pos/new">
                            <i class="bx bxs-truck me-1"></i> @L["InventoryAdmin.NewPurchaseOrder.Title"]
                        </a>
                        <a class="btn btn-outline-secondary btn-sm w-100" href="/admin/combos">
                            <i class="bx bx-customize me-1"></i> @L["AdminDashboard.Index.CombosQuickButtons"]
                        </a>
                        <a class="btn btn-outline-secondary btn-sm w-100" href="/admin/notification-templates">
                            <i class="bx bx-envelope-open me-1"></i> @L["NotificationTemplates"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
