@*
    /gateways-admin — list payment gateway configurations.
*@
@using Platform.Domain.Payments
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<PaymentGatewayConfig>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["GatewaysAdmin.Index.Title"].Value;
    var sandboxCount = Model.Count(g => g.IsSandbox);
    var liveCount    = Model.Count(g => !g.IsSandbox);
    var enabledCount = Model.Count(g => g.IsEnabled);
    var header = new UiPageHeaderOptions
    {
        Title    = L["GatewaysAdmin.Index.Title"].Value,
        Subtitle = L["GatewaysAdmin.Index.Subtitle"].Value
    };

    var kpiTotal   = new UiKpiOptions { Label = L["Common.Total"].Value,          Value = Model.Count.ToString(),  Icon = "bx bx-credit-card" };
    var kpiLive    = new UiKpiOptions { Label = L["GatewaysAdmin.Env.Live"].Value,    Value = liveCount.ToString(),    Icon = "bx bx-bolt-circle", Trend = UiKpiTrend.Up };
    var kpiSandbox = new UiKpiOptions { Label = L["GatewaysAdmin.Env.Sandbox"].Value, Value = sandboxCount.ToString(), Icon = "bx bx-test-tube" };
    var kpiOn      = new UiKpiOptions { Label = L["Common.Enabled"].Value,        Value = enabledCount.ToString(), Icon = "bx bx-toggle-right" };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiTotal"   /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiLive"    /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiSandbox" /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiOn"      /></div>
    </div>

    @if (Model.Count == 0)
    {
        var info = new UiAlertOptions
        {
            Variant = UiAlertVariant.Warning,
            Heading = L["GatewaysAdmin.Index.Empty.Title"].Value,
            Body    = L["GatewaysAdmin.Index.Empty.Description"].Value
        };
        <partial name="_UiAlert" model="info" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["GatewaysAdmin.Index.Code"]</th>
                        <th>@L["Common.Name"]</th>
                        <th>@L["GatewaysAdmin.Index.Method"]</th>
                        <th>@L["GatewaysAdmin.Group"]</th>
                        <th class="text-end">@L["GatewaysAdmin.Index.Channels"]</th>
                        <th>@L["GatewaysAdmin.Index.Env"]</th>
                        <th>@L["Common.Enabled"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var g in Model)
                {
                    var envBadge = new UiBadgeOptions
                    {
                        Text    = g.IsSandbox ? L["GatewaysAdmin.Env.Sandbox"].Value : L["GatewaysAdmin.Env.Live"].Value,
                        Variant = g.IsSandbox ? UiBadgeVariant.Warning : UiBadgeVariant.Success,
                        WithDot = true
                    };
                    var enBadge = new UiBadgeOptions
                    {
                        Text    = g.IsEnabled ? L["GatewaysAdmin.Status.On"].Value : L["GatewaysAdmin.Status.Off"].Value,
                        Variant = g.IsEnabled ? UiBadgeVariant.Primary : UiBadgeVariant.Secondary
                    };
                    <tr>
                        <td><span class="ui-mono">@g.GatewayCode</span></td>
                        <td class="ui-text-strong">@g.Name</td>
                        <td class="ui-muted" style="font-size:13px">@g.Method</td>
                        <td class="ui-muted" style="font-size:13px">@g.GatewayGroup</td>
                        <td class="text-end ui-tabular">@g.Channels.Count</td>
                        <td><partial name="_UiBadge" model="envBadge" /></td>
                        <td><partial name="_UiBadge" model="enBadge" /></td>
                        <td class="ui-muted" style="font-size:13px">@g.Status</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@g.GatewayConfigId" class="btn btn-outline-primary" title="@L["Common.Edit"]">
                                    <i class="bx bx-edit"></i>
                                </a>
                                <form asp-action="Toggle" asp-route-id="@g.GatewayConfigId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-@(g.IsEnabled ? "warning" : "success")"
                                            title="@(g.IsEnabled ? L["GatewaysAdmin.Index.Disable"].Value : L["GatewaysAdmin.Index.Enable"].Value)">
                                        <i class="bx @(g.IsEnabled ? "bx-toggle-left" : "bx-toggle-right")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
