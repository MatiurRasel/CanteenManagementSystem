@*
    /reports-catalog — registered reports grouped by domain.
*@
@using Platform.Application.Abstractions.Reporting
@using CanteenManagementSystem.Presentation.Models
@model List<IGrouping<string, IReport>>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ReportsCatalog"].Value;
    string GroupIcon(string g) => g switch
    {
        "Sales"      => "bx-store-alt",
        "Wallet"     => "bx-wallet",
        "Compliance" => "bx-check-shield",
        "Audit"      => "bx-clipboard",
        "Inventory"  => "bx-package",
        _ => "bx-pie-chart-alt-2"
    };
    UiBadgeVariant FormatVariant(string fmt) => fmt.ToLowerInvariant() switch
    {
        "pdf"  => UiBadgeVariant.Danger,
        "xlsx" => UiBadgeVariant.Success,
        "csv"  => UiBadgeVariant.Info,
        "json" => UiBadgeVariant.Secondary,
        "html" => UiBadgeVariant.Primary,
        _      => UiBadgeVariant.Secondary
    };
    var header = new UiPageHeaderOptions
    {
        Title    = L["ReportsCatalog"].Value,
        Subtitle = L["ReportsCatalog.Index.Subtitle"].Value
    };
    var reportCount = Model.SelectMany(g => g).Count();
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var info = new UiAlertOptions
        {
            Variant = UiAlertVariant.Info,
            Heading = L["ReportsCatalog.Index.EmptyTitle"].Value,
            Body    = L["ReportsCatalog.Index.EmptyBody"].Value
        };
        <partial name="_UiAlert" model="info" />
    }
    else
    {
        <div class="ui-muted mb-3" style="font-size:13px">@L["ReportsCatalog.Index.CountSummary", reportCount, Model.Count]</div>

        @foreach (var group in Model)
        {
            <div class="ui-section-title mt-4 mb-2">
                <i class="bx @GroupIcon(group.Key) me-2"></i>@group.Key
                <span class="ui-muted" style="font-weight:400;font-size:12px;margin-left:.5rem">(@group.Count())</span>
            </div>
            <div class="row g-3">
                @foreach (var r in group)
                {
                    <div class="col-lg-4 col-md-6">
                        <a asp-action="Run" asp-route-key="@r.Key" class="ui-card ui-card-interactive h-100 text-decoration-none text-reset">
                            <div class="ui-card-body">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div>
                                        <div class="ui-text-strong">@r.DisplayName</div>
                                        @if (!string.IsNullOrEmpty(r.Description))
                                        {
                                            <div class="ui-muted mt-1" style="font-size:13px">@r.Description</div>
                                        }
                                    </div>
                                    <i class="bx bx-right-arrow-alt ui-muted ms-2"></i>
                                </div>
                                <div class="mt-3 d-flex flex-wrap gap-1">
                                    @foreach (var f in r.SupportedFormats)
                                    {
                                        var fb = new UiBadgeOptions { Text = f.ToString().ToUpperInvariant(), Variant = FormatVariant(f.ToString()) };
                                        <partial name="_UiBadge" model="fb" />
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    }
</div>
