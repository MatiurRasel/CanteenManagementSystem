@*
    /admin/report-schedules/{id|new} — schedule editor.
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.ReportSchedulesController.ScheduleForm
@{
    var isNew  = Model.ScheduleId == 0;
    ViewData["Title"] = isNew ? "New scheduled report" : "Edit schedule";
    var reports = (ViewBag.Reports as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>();
    var header = new UiPageHeaderOptions
    {
        Title    = isNew ? "New scheduled report" : Model.DisplayName,
        Subtitle = "Pick a report, schedule, format, recipients. Optional params JSON supports @-tokens.",
        Actions  = Html.Raw("<a class='btn btn-outline-secondary btn-sm' href='/admin/report-schedules'><i class='fa-solid fa-arrow-left me-1'></i> All schedules</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="@(isNew ? "New" : "Edit")" asp-route-id="@Model.ScheduleId">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="ui-label" asp-for="ReportKey">Report</label>
                                <select asp-for="ReportKey" asp-items="reports" class="form-select ui-select"></select>
                                <span asp-validation-for="ReportKey" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label class="ui-label" asp-for="DisplayName">Display name</label>
                                <input asp-for="DisplayName" class="ui-input form-control" placeholder="Nightly daily-collection" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="ui-label" asp-for="Recurrence">Recurrence</label>
                                <select asp-for="Recurrence" class="form-select ui-select" id="recurrence">
                                    <option value="Daily">Daily</option>
                                    <option value="Weekly">Weekly</option>
                                    <option value="Monthly">Monthly</option>
                                    <option value="Hourly">Hourly</option>
                                </select>
                            </div>
                            <div class="col-md-4" data-rec="Daily,Weekly,Monthly">
                                <label class="ui-label" asp-for="HourOfDay">Hour (UTC, 0-23)</label>
                                <input asp-for="HourOfDay" type="number" min="0" max="23" class="ui-input form-control" />
                            </div>
                            <div class="col-md-4" data-rec="Daily,Weekly,Monthly">
                                <label class="ui-label" asp-for="Minute">Minute</label>
                                <input asp-for="Minute" type="number" min="0" max="59" class="ui-input form-control" />
                            </div>

                            <div class="col-md-4" data-rec="Weekly">
                                <label class="ui-label" asp-for="DayOfWeek">Day of week</label>
                                <select asp-for="DayOfWeek" class="form-select ui-select">
                                    <option value="0">Sunday</option><option value="1">Monday</option>
                                    <option value="2">Tuesday</option><option value="3">Wednesday</option>
                                    <option value="4">Thursday</option><option value="5">Friday</option>
                                    <option value="6">Saturday</option>
                                </select>
                            </div>
                            <div class="col-md-4" data-rec="Monthly">
                                <label class="ui-label" asp-for="DayOfMonth">Day of month</label>
                                <input asp-for="DayOfMonth" type="number" min="1" max="31" class="ui-input form-control" />
                            </div>
                            <div class="col-md-4" data-rec="Hourly">
                                <label class="ui-label" asp-for="IntervalHours">Every N hours</label>
                                <input asp-for="IntervalHours" type="number" min="1" max="24" class="ui-input form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="ui-label" asp-for="Format">Format</label>
                                <select asp-for="Format" class="form-select ui-select">
                                    <option>Pdf</option><option>Xlsx</option>
                                    <option>Csv</option><option>Html</option><option>Json</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="ui-label" asp-for="Recipients">Recipients (CSV)</label>
                                <input asp-for="Recipients" class="ui-input form-control" placeholder="admin@school.edu, finance@school.edu" />
                                <span asp-validation-for="Recipients" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="ui-label" asp-for="ParametersJson">Parameters (JSON)</label>
                                <textarea asp-for="ParametersJson" class="ui-input form-control ui-mono" rows="4" placeholder='{"From":"@@WEEK_AGO","To":"@@TODAY"}'></textarea>
                                <div class="ui-help-text">
                                    Tokens: <code>@@TODAY</code>, <code>@@YESTERDAY</code>, <code>@@WEEK_START</code>,
                                    <code>@@WEEK_AGO</code>, <code>@@MONTH_START</code>, <code>@@THIRTY_DAY_AGO</code>.
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="IsEnabled" />
                                    <label class="form-check-label" asp-for="IsEnabled">Enabled</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ui-card sticky-top" style="top:5rem">
                    <div class="ui-card-header"><div class="ui-card-title">How it works</div></div>
                    <div class="ui-card-body">
                        <ul class="small ui-stack-sm mb-3" style="padding-left:1.2rem">
                            <li>The scheduler ticks every minute UTC; schedules past their <em>NextRunAtUtc</em> fire.</li>
                            <li>Output is sent as an email attachment using <strong>Notifications.Email.*</strong> tenant settings.</li>
                            <li>Failures stamp <em>LastError</em> on the schedule row — the next tick still tries again.</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var rec = document.getElementById('recurrence');
            function refresh () {
                var v = rec.value;
                document.querySelectorAll('[data-rec]').forEach(function (el) {
                    var allowed = el.getAttribute('data-rec').split(',');
                    el.style.display = allowed.indexOf(v) >= 0 ? '' : 'none';
                });
            }
            rec.addEventListener('change', refresh); refresh();
        })();
    </script>
}
