@*
    /admin/report-schedules/{id|new} — schedule editor.
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.ReportSchedulesController.ScheduleForm
@inject IStringLocalizer<SharedResource> L
@{
    var isNew  = Model.ScheduleId == 0;
    ViewData["Title"] = isNew ? L["ReportSchedules.Edit.NewTitle"].Value : L["ReportSchedules.Edit.EditTitle"].Value;
    var reports = (ViewBag.Reports as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>();
    var header = new UiPageHeaderOptions
    {
        Title    = isNew ? L["ReportSchedules.Edit.NewTitle"].Value : Model.DisplayName,
        Subtitle = L["ReportSchedules.Edit.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/report-schedules'><i class='bx bx-left-arrow-alt me-1'></i> {L["ReportSchedules.Edit.AllSchedules"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="@(isNew ? "New" : "Edit")" asp-route-id="@Model.ScheduleId">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="ui-label" asp-for="ReportKey">@L["ReportSchedules.Index.Report"]</label>
                                <select asp-for="ReportKey" asp-items="reports" class="form-select ui-select"></select>
                                <span asp-validation-for="ReportKey" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label class="ui-label" asp-for="DisplayName">@L["UsersAdmin.DisplayName"]</label>
                                <input asp-for="DisplayName" class="ui-input form-control" placeholder="@L["ReportSchedules.Edit.DisplayNamePlaceholder"]" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="ui-label" asp-for="Recurrence">@L["ReportSchedules.Edit.Recurrence"]</label>
                                <select asp-for="Recurrence" class="form-select ui-select" id="recurrence">
                                    <option value="Daily">@L["ReportSchedules.Edit.RecurrenceDaily"]</option>
                                    <option value="Weekly">@L["ReportSchedules.Edit.RecurrenceWeekly"]</option>
                                    <option value="Monthly">@L["ReportSchedules.Edit.RecurrenceMonthly"]</option>
                                    <option value="Hourly">@L["ReportSchedules.Edit.RecurrenceHourly"]</option>
                                </select>
                            </div>
                            <div class="col-md-4" data-rec="Daily,Weekly,Monthly">
                                <label class="ui-label" asp-for="HourOfDay">@L["ReportSchedules.Edit.HourUtc"]</label>
                                <input asp-for="HourOfDay" type="number" min="0" max="23" class="ui-input form-control" />
                            </div>
                            <div class="col-md-4" data-rec="Daily,Weekly,Monthly">
                                <label class="ui-label" asp-for="Minute">@L["ReportSchedules.Edit.Minute"]</label>
                                <input asp-for="Minute" type="number" min="0" max="59" class="ui-input form-control" />
                            </div>

                            <div class="col-md-4" data-rec="Weekly">
                                <label class="ui-label" asp-for="DayOfWeek">@L["DiscountRules.Edit.DayOfWeekLabel"]</label>
                                <select asp-for="DayOfWeek" class="form-select ui-select">
                                    @for (var d = 0; d < 7; d++)
                                    {
                                        <option value="@d">@System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetDayName((DayOfWeek)d)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4" data-rec="Monthly">
                                <label class="ui-label" asp-for="DayOfMonth">@L["ReportSchedules.Edit.DayOfMonth"]</label>
                                <input asp-for="DayOfMonth" type="number" min="1" max="31" class="ui-input form-control" />
                            </div>
                            <div class="col-md-4" data-rec="Hourly">
                                <label class="ui-label" asp-for="IntervalHours">@L["ReportSchedules.Edit.EveryNHours"]</label>
                                <input asp-for="IntervalHours" type="number" min="1" max="24" class="ui-input form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="ui-label" asp-for="Format">@L["ReportsCatalog.Run.Format"]</label>
                                <select asp-for="Format" class="form-select ui-select">
                                    <option>Pdf</option><option>Xlsx</option>
                                    <option>Csv</option><option>Html</option><option>Json</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="ui-label" asp-for="Recipients">@L["ReportSchedules.Edit.RecipientsCsv"]</label>
                                <input asp-for="Recipients" class="ui-input form-control" placeholder="admin@school.edu, finance@school.edu" />
                                <span asp-validation-for="Recipients" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="ui-label" asp-for="ParametersJson">@L["ReportSchedules.Edit.ParametersJson"]</label>
                                <textarea asp-for="ParametersJson" class="ui-input form-control ui-mono" rows="4" placeholder='{"From":"@@WEEK_AGO","To":"@@TODAY"}'></textarea>
                                <div class="ui-help-text">
                                    @L["NotificationTemplates.Index.TokensLabel"] <code>@@TODAY</code>, <code>@@YESTERDAY</code>, <code>@@WEEK_START</code>,
                                    <code>@@WEEK_AGO</code>, <code>@@MONTH_START</code>, <code>@@THIRTY_DAY_AGO</code>.
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="IsEnabled" />
                                    <label class="form-check-label" asp-for="IsEnabled">@L["Common.Enabled"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ui-card sticky-top" style="top:5rem">
                    <div class="ui-card-header"><div class="ui-card-title">@L["ReportSchedules.Edit.HowItWorks"]</div></div>
                    <div class="ui-card-body">
                        <ul class="small ui-stack-sm mb-3" style="padding-left:1.2rem">
                            <li>@L["ReportSchedules.Edit.HowItWorks1"]</li>
                            <li>@L["ReportSchedules.Edit.HowItWorks2"]</li>
                            <li>@L["ReportSchedules.Edit.HowItWorks3"]</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bx bx-save me-1"></i> @L["Common.Save"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@L["Common.Cancel"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var rec = document.getElementById('recurrence');
            function refresh () {
                var v = rec.value;
                document.querySelectorAll('[data-rec]').forEach(function (el) {
                    var allowed = el.getAttribute('data-rec').split(',');
                    el.style.display = allowed.indexOf(v) >= 0 ? '' : 'none';
                });
            }
            rec.addEventListener('change', refresh); refresh();
        })();
    </script>
}
