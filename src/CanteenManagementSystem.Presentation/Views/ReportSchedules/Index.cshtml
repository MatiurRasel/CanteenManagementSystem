@*
    /admin/report-schedules — recurring report runs + email.
*@
@using Platform.Domain.Reporting
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<ReportSchedule>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ScheduledReports"].Value;
    UiBadgeVariant StatusVar(string? s) => s switch
    {
        "Success" => UiBadgeVariant.Success,
        "Failed"  => UiBadgeVariant.Danger,
        _ => UiBadgeVariant.Secondary
    };
    string DescribeRecurrence(ReportSchedule s) => s.Recurrence switch
    {
        "Hourly"  => L["ReportSchedules.Index.EveryHours", s.IntervalHours ?? 1].Value,
        "Daily"   => L["ReportSchedules.Index.DailyAt", $"{(s.HourOfDay ?? 0):00}:{(s.Minute ?? 0):00}"].Value,
        "Weekly"  => L["ReportSchedules.Index.WeeklyAt", System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetDayName((DayOfWeek)(s.DayOfWeek ?? 1)), $"{(s.HourOfDay ?? 0):00}:{(s.Minute ?? 0):00}"].Value,
        "Monthly" => L["ReportSchedules.Index.MonthlyAt", s.DayOfMonth ?? 1, $"{(s.HourOfDay ?? 0):00}:{(s.Minute ?? 0):00}"].Value,
        _ => s.Recurrence
    };
    var header = new UiPageHeaderOptions
    {
        Title    = L["ScheduledReports"].Value,
        Subtitle = L["ReportSchedules.Index.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-primary btn-sm' href='/admin/report-schedules/new'><i class='bx bx-plus me-1'></i> {L["ReportSchedules.Index.NewSchedule"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions
        {
            Icon        = "bx-calendar",
            Title       = L["ReportSchedules.Index.Empty.Title"].Value,
            Description = L["ReportSchedules.Index.Empty.Description"].Value,
            CtaLabel    = L["ReportSchedules.Index.NewSchedule"].Value,
            CtaIcon     = "bx-plus",
            CtaUrl      = "/admin/report-schedules/new"
        };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["ReportSchedules.Index.Report"]</th>
                        <th>@L["Parent.Index.When"]</th>
                        <th>@L["ReportsCatalog.Run.Format"]</th>
                        <th>@L["ReportSchedules.Index.Recipients"]</th>
                        <th>@L["ReportSchedules.Index.LastRun"]</th>
                        <th>@L["ReportSchedules.Index.NextRun"]</th>
                        <th class="text-end">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    var recBadge = new UiBadgeOptions { Text = s.Recurrence, Variant = UiBadgeVariant.Primary };
                    var fmtBadge = new UiBadgeOptions { Text = s.Format, Variant = UiBadgeVariant.Secondary };
                    <tr>
                        <td>
                            <div class="ui-text-strong">@s.DisplayName</div>
                            <div class="ui-muted small"><code>@s.ReportKey</code></div>
                        </td>
                        <td>
                            <partial name="_UiBadge" model="recBadge" />
                            <span class="ui-muted small ms-2">@DescribeRecurrence(s)</span>
                        </td>
                        <td><partial name="_UiBadge" model="fmtBadge" /></td>
                        <td class="ui-muted small">@s.Recipients</td>
                        <td>
                            <div class="ui-muted small">@(s.LastRunAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? L["UsersAdmin.Index.Never"].Value)</div>
                            @if (!string.IsNullOrEmpty(s.LastRunStatus))
                            {
                                var b = new UiBadgeOptions { Text = s.LastRunStatus, Variant = StatusVar(s.LastRunStatus), WithDot = true };
                                <partial name="_UiBadge" model="b" />
                            }
                            @if (!string.IsNullOrEmpty(s.LastError))
                            {
                                <div class="text-danger small text-truncate" style="max-width:280px" title="@s.LastError">
                                    <i class="bx bx-error me-1"></i>@s.LastError
                                </div>
                            }
                        </td>
                        <td class="ui-muted small">@(s.NextRunAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <form asp-action="RunNow" asp-route-id="@s.ScheduleId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-primary" title="@L["ReportSchedules.Index.RunNow"]"><i class="bx bx-send"></i></button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@s.ScheduleId" class="btn btn-outline-secondary" title="@L["Common.Edit"]"><i class="bx bx-edit"></i></a>
                                <form asp-action="Toggle" asp-route-id="@s.ScheduleId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-@(s.IsEnabled ? "warning" : "success")" title="@(s.IsEnabled ? L["ReportSchedules.Index.Pause"].Value : L["ReportSchedules.Index.Resume"].Value)">
                                        <i class="bx @(s.IsEnabled ? "bx-pause" : "bx-play")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@s.ScheduleId" method="post" class="d-inline"
                                      data-cl-confirm="@L["ReportSchedules.Index.ConfirmDelete", s.DisplayName]" data-cl-confirm-variant="warning">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="@L["Common.Delete"]"><i class="bx bx-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
