@*
    /sysadmin/tenants — SysAdmin tenant list.
    Reference page demonstrating the shadcn-style design system on a table-heavy admin screen.
*@
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<Platform.Domain.Tenancy.Client>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Tenants"].Value;
    var freshCode  = TempData["NewTenant.Code"] as string;
    var freshLogin = TempData["NewTenant.AdminLogin"] as string;
    var freshPwd   = TempData["NewTenant.BootstrapPassword"] as string;

    var addActions = Html.Raw($"<a class='btn btn-primary' href='/sysadmin/tenants/new'><i class='bx bx-plus me-1'></i> {L["TenantsAdmin.Index.AddTenant"].Value}</a>");
    var header = new UiPageHeaderOptions
    {
        Title    = L["Tenants"].Value,
        Subtitle = L["TenantsAdmin.Index.Subtitle"].Value,
        Actions  = addActions
    };

    var activeCount   = Model.Count(c => c.IsActive && c.DeletedAtUtc == null);
    var deletedCount  = Model.Count(c => c.DeletedAtUtc != null);
    var totalCount    = Model.Count;
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @* Bootstrap-admin one-time output after Add tenant. *@
    @if (!string.IsNullOrEmpty(freshCode))
    {
        <div class="ui-alert variant-success ui-anim-in mb-4" role="alert">
            <i class="bx bx-check-circle"></i>
            <div class="flex-grow-1">
                <div class="ui-alert-heading">@L["TenantsAdmin.Index.CreatedHeading", freshCode]</div>
                <div class="ui-row ui-mono" style="font-size:13px; gap:1rem">
                    <span>@L["TenantsAdmin.Index.Login"]: <strong>@freshLogin</strong></span>
                    <span>@L["TenantsAdmin.Index.Password"]: <strong>@freshPwd</strong></span>
                </div>
                <div class="ui-help-text mt-1">@L["TenantsAdmin.Index.ShareSecurely"]</div>
            </div>
        </div>
    }

    @* KPI strip *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <partial name="_UiKpi" model="@(new UiKpiOptions { Label = L["Common.Total"].Value, Value = totalCount.ToString("N0"), Icon = "bx bx-buildings" })" />
        </div>
        <div class="col-6 col-md-3">
            <partial name="_UiKpi" model="@(new UiKpiOptions { Label = L["Common.Active"].Value, Value = activeCount.ToString("N0"), Icon = "bx bx-check-circle" })" />
        </div>
        <div class="col-6 col-md-3">
            <partial name="_UiKpi" model="@(new UiKpiOptions { Label = L["TenantsAdmin.Index.KpiDeletedInHold"].Value, Value = deletedCount.ToString("N0"), Icon = "bx bx-trash" })" />
        </div>
        <div class="col-6 col-md-3">
            <partial name="_UiKpi" model="@(new UiKpiOptions { Label = L["TenantsAdmin.Index.KpiThisMonth"].Value, Value = Model.Count(c => c.CreatedAtUtc >= DateTime.UtcNow.AddDays(-30)).ToString("N0"), Delta = L["TenantsAdmin.Index.KpiNewTenants"].Value, Icon = "bx bx-trending-up" })" />
        </div>
    </div>

    @* Table *@
    <div class="ui-table-wrap">
        <table class="table table-hover mb-0 ui-table">
            <thead>
                <tr>
                    <th>@L["TenantsAdmin.Index.ColCode"]</th>
                    <th>@L["Common.Name"]</th>
                    <th>@L["TenantsAdmin.Index.ColContact"]</th>
                    <th>@L["Common.Status"]</th>
                    <th class="text-end">@L["TenantsAdmin.Index.ColCreated"]</th>
                    <th class="text-end" style="width: 1%">@L["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="p-0">
                        <partial name="_EmptyState" model="@(new EmptyStateOptions { Icon = "bx-buildings", Title = L["TenantsAdmin.Index.Empty.Title"].Value, Description = L["TenantsAdmin.Index.Empty.Description"].Value, CtaLabel = L["TenantsAdmin.Index.AddTenant"].Value, CtaUrl = "/sysadmin/tenants/new" })" />
                    </td></tr>
                }
                @foreach (var c in Model)
                {
                    var variant = c.DeletedAtUtc != null ? UiBadgeVariant.Warning
                                : c.IsActive    ? UiBadgeVariant.Success
                                : UiBadgeVariant.Secondary;
                    var label   = c.DeletedAtUtc != null ? L["TenantsAdmin.Index.StatusInHold", c.HoldUntilUtc?.ToString("yyyy-MM-dd") ?? ""].Value
                                : c.IsActive    ? L["Common.Active"].Value
                                : L["Common.Disabled"].Value;
                    <tr>
                        <td class="ui-mono ui-text-strong">@c.ClientCode</td>
                        <td>
                            <div class="ui-text-strong">@c.ClientName</div>
                            @if (!string.IsNullOrEmpty(c.ShortName))
                            {
                                <div class="ui-muted" style="font-size:12px">@c.ShortName</div>
                            }
                        </td>
                        <td>
                            <div>@(c.Email ?? "—")</div>
                            <div class="ui-muted" style="font-size:12px">@(c.PhoneNumber ?? "")</div>
                        </td>
                        <td>
                            <partial name="_UiBadge" model="@(new UiBadgeOptions { Text = label, Variant = variant, WithDot = true })" />
                        </td>
                        <td class="text-end ui-muted ui-tabular">@c.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-ghost btn-sm" data-bs-toggle="dropdown" aria-label="@L["Common.Actions"]">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (c.DeletedAtUtc != null)
                                    {
                                        <li>
                                            <form method="post" action="/sysadmin/tenants/@c.ClientId/restore" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bx bx-rotate-left me-2"></i> @L["TenantsAdmin.Index.Restore"]
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form method="post" action="/sysadmin/tenants/@c.ClientId/soft-delete" class="m-0"
                                                  data-cl-confirm="@L["TenantsAdmin.Index.ConfirmSoftDelete", c.ClientCode]" data-cl-confirm-variant="warning">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reason" value="Manual soft-delete from console" />
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bx bx-trash me-2"></i> @L["TenantsAdmin.Index.SoftDelete"]
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
