@*
    /admin/audit — audit log viewer.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.AuditAdminController.AuditPage
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["AuditLog"].Value;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
    var header = new UiPageHeaderOptions
    {
        Title    = L["AuditLog"].Value,
        Subtitle = L["AuditAdmin.Index.Subtitle"].Value
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="get" class="ui-card mb-4">
        <div class="ui-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="ui-label">@L["Common.From"]</label>
                    <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="ui-input form-control" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="ui-label">@L["Common.To"]</label>
                    <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="ui-input form-control" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="ui-label">@L["AuditAdmin.Index.Action"]</label>
                    <select name="action" class="form-select ui-select">
                        <option value="">@L["AuditAdmin.Index.Any"]</option>
                        @foreach (var a in Model.KnownActions)
                        {
                            <option value="@a" selected="@(Model.Action == a)">@a</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="ui-label">@L["AuditAdmin.Index.EntityType"]</label>
                    <input type="text" name="entityType" value="@Model.EntityType" class="ui-input form-control" placeholder="@L["AuditAdmin.Index.EntityTypePlaceholder"]" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="ui-label">@L["Common.Search"]</label>
                    <input type="text" name="q" value="@Model.Q" class="ui-input form-control" placeholder="@L["AuditAdmin.Index.SearchPlaceholder"]" />
                </div>
                <div class="col-12 col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary">@L["Common.Filter"]</button>
                </div>
            </div>
        </div>
    </form>

    <div class="ui-table-wrap">
        <table class="table table-hover mb-0 ui-table">
            <thead>
                <tr>
                    <th>@L["AuditAdmin.Index.ColWhen"]</th>
                    <th>@L["AuditAdmin.Index.Action"]</th>
                    <th>@L["AuditAdmin.Index.ColEntity"]</th>
                    <th>@L["AuditAdmin.Index.ColBy"]</th>
                    <th>@L["AuditAdmin.Index.ColIp"]</th>
                    <th>@L["AuditAdmin.Index.ColCorrelation"]</th>
                    <th>@L["AuditAdmin.Index.ColPayload"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="p-0">
                        <partial name="_EmptyState" model="@(new EmptyStateOptions { Icon = "bx-clipboard", Title = L["AuditAdmin.Index.Empty.Title"].Value, Description = L["AuditAdmin.Index.Empty.Description"].Value })" />
                    </td></tr>
                }
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td class="ui-muted ui-tabular" style="font-size:12px">@a.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="ui-mono" style="font-size:12px">@a.Action</td>
                        <td>@(a.EntityType ?? "—")@(string.IsNullOrEmpty(a.EntityId) ? "" : $":{a.EntityId}")</td>
                        <td>
                            <div>@(a.PerformedBy ?? "—")</div>
                            @if (!string.IsNullOrEmpty(a.PerformedByRole))
                            {
                                <div class="ui-muted" style="font-size:11px">@a.PerformedByRole</div>
                            }
                        </td>
                        <td class="ui-muted ui-mono" style="font-size:12px">@(a.IpAddress ?? "—")</td>
                        <td class="ui-muted ui-mono" style="font-size:12px">@(a.CorrelationId ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(a.PayloadJson))
                            {
                                <span class="ui-muted ui-mono" style="font-size:11px;max-width:240px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@a.PayloadJson">@a.PayloadJson</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="ui-row-between mt-3">
            <span class="ui-muted" style="font-size:13px">@L["AuditAdmin.Index.PageInfo", Model.Page, totalPages, Model.TotalCount]</span>
            <ul class="pagination pagination-sm mb-0">
                @if (Model.Page > 1)
                {
                    <li class="page-item"><a class="page-link" href="?from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")&action=@Model.Action&entityType=@Model.EntityType&q=@Model.Q&page=@(Model.Page-1)">← @L["Common.Previous"]</a></li>
                }
                @if (Model.Page < totalPages)
                {
                    <li class="page-item"><a class="page-link" href="?from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")&action=@Model.Action&entityType=@Model.EntityType&q=@Model.Q&page=@(Model.Page+1)">@L["Common.Next"] →</a></li>
                }
            </ul>
        </div>
    }
</div>
