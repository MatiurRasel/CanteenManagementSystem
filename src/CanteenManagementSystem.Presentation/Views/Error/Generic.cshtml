@inject IStringLocalizer<SharedResource> L
@{
    var code = Context.Response.StatusCode;
    ViewData["Code"]           = code.ToString();
    ViewData["Tone"]           = code >= 500 ? "danger" : "warning";
    ViewData["Icon"]           = code >= 500 ? "bx bx-error" : "bx bx-help-circle";
    ViewData["Title"]          = code >= 500 ? L["Error.Shared.ServerError"].Value : L["Error.Generic.RequestError"].Value;
    ViewData["Description"]    = code >= 500
        ? L["Error.Generic.ServerDescription"].Value
        : L["Error.Generic.RequestDescription"].Value;
    ViewData["CtaUrl"]         = "/";
    ViewData["CtaLabel"]       = L["Error.Shared.BackHome"].Value;
    ViewData["CtaIcon"]        = "bx bx-home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.Generic.PageTitle", code] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
