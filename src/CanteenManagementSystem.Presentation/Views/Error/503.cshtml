@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Code"]           = "503";
    ViewData["Tone"]           = "warning";
    ViewData["Icon"]           = "bx bx-wrench";
    ViewData["Title"]          = L["Error.503.Title"].Value;
    ViewData["Description"]    = L["Error.503.Description"].Value;
    ViewData["CtaUrl"]         = "javascript:location.reload()";
    ViewData["CtaLabel"]       = L["Common.Refresh"].Value;
    ViewData["CtaIcon"]        = "bx bx-refresh";
    ViewData["SecondaryUrl"]   = "/health/live";
    ViewData["SecondaryLabel"] = L["Error.503.Secondary"].Value;
    ViewData["SecondaryIcon"]  = "bx bx-pulse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.503.Title"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
