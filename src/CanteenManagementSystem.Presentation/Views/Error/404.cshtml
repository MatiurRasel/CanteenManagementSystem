@{
    var originalPath = ViewData["OriginalPath"] as string;
    ViewData["Code"]           = "404";
    ViewData["Tone"]           = "secondary";
    ViewData["Icon"]           = "fa-compass";
    ViewData["Title"]          = "Page not found";
    ViewData["Description"]    = string.IsNullOrEmpty(originalPath)
        ? "We couldn't find the page you were looking for. It may have moved, or the link you followed could be out of date."
        : $"We couldn't find anything at {originalPath}. It may have moved, or the link you followed could be out of date.";
    ViewData["CtaUrl"]         = "/";
    ViewData["CtaLabel"]       = "Back to home";
    ViewData["CtaIcon"]        = "fa-house";
    ViewData["SecondaryUrl"]   = "/admin/receipts/search";
    ViewData["SecondaryLabel"] = "Search";
    ViewData["SecondaryIcon"]  = "fa-magnifying-glass";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
