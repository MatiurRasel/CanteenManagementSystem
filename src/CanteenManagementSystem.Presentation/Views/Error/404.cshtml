@inject IStringLocalizer<SharedResource> L
@{
    var originalPath = ViewData["OriginalPath"] as string;
    ViewData["Code"]           = "404";
    ViewData["Tone"]           = "secondary";
    ViewData["Icon"]           = "bx bx-compass";
    ViewData["Title"]          = L["Error.404.Title"].Value;
    ViewData["Description"]    = string.IsNullOrEmpty(originalPath)
        ? L["Error.404.Description"].Value
        : L["Error.404.PathInfo", originalPath].Value;
    ViewData["CtaUrl"]         = "/";
    ViewData["CtaLabel"]       = L["Error.Shared.BackHome"].Value;
    ViewData["CtaIcon"]        = "bx bx-home";
    ViewData["SecondaryUrl"]   = "/admin/receipts/search";
    ViewData["SecondaryLabel"] = L["Common.Search"].Value;
    ViewData["SecondaryIcon"]  = "bx bx-search";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.404.Title"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
