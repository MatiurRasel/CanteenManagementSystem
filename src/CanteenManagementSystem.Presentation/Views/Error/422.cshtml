@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Code"]         = "422";
    ViewData["Tone"]         = "warning";
    ViewData["Icon"]         = "bx bx-error-circle";
    ViewData["Title"]        = L["Error.422.Title"].Value;
    ViewData["Description"]  = L["Error.422.Description"].Value;
    ViewData["CtaUrl"]       = "javascript:history.back()";
    ViewData["CtaLabel"]     = L["Error.Shared.GoBack"].Value;
    ViewData["CtaIcon"]      = "bx bx-arrow-back";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.422.PageTitle"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
