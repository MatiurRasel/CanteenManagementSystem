@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Code"]          = "400";
    ViewData["Tone"]          = "warning";
    ViewData["Icon"]          = "bx bx-help-circle";
    ViewData["Title"]         = L["Error.400.Title"].Value;
    ViewData["Description"]   = L["Error.400.Description"].Value;
    ViewData["CtaUrl"]        = "/";
    ViewData["CtaLabel"]      = L["Error.Shared.BackHome"].Value;
    ViewData["CtaIcon"]       = "bx bx-home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.400.Title"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
