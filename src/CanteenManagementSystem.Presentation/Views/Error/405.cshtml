@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Code"]           = "405";
    ViewData["Tone"]           = "warning";
    ViewData["Icon"]           = "bx bx-block";
    ViewData["Title"]          = L["Error.405.Title"].Value;
    ViewData["Description"]    = L["Error.405.Description"].Value;
    ViewData["CtaUrl"]         = "javascript:history.back()";
    ViewData["CtaLabel"]       = L["Error.Shared.GoBack"].Value;
    ViewData["CtaIcon"]        = "bx bx-arrow-back";
    ViewData["SecondaryUrl"]   = "/";
    ViewData["SecondaryLabel"] = L["Error.Shared.Home"].Value;
    ViewData["SecondaryIcon"]  = "bx bx-home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.405.Title"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
