@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Code"]           = "408";
    ViewData["Tone"]           = "warning";
    ViewData["Icon"]           = "bx bx-hourglass";
    ViewData["Title"]          = L["Error.408.Title"].Value;
    ViewData["Description"]    = L["Error.408.Description"].Value;
    ViewData["CtaUrl"]         = "javascript:location.reload()";
    ViewData["CtaLabel"]       = L["Error.Shared.TryAgain"].Value;
    ViewData["CtaIcon"]        = "bx bx-refresh";
    ViewData["SecondaryUrl"]   = "/";
    ViewData["SecondaryLabel"] = L["Error.Shared.Home"].Value;
    ViewData["SecondaryIcon"]  = "bx bx-home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.408.Title"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
