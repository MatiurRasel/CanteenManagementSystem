@inject IStringLocalizer<SharedResource> L
@{
    var returnUrl = ViewData["OriginalPath"] as string ?? "/";
    ViewData["Code"]            = "401";
    ViewData["Tone"]            = "info";
    ViewData["Icon"]            = "bx bx-log-in";
    ViewData["Title"]           = L["Error.401.Title"].Value;
    ViewData["Description"]     = L["Error.401.Description"].Value;
    ViewData["CtaUrl"]          = $"/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    ViewData["CtaLabel"]        = L["Error.401.Cta"].Value;
    ViewData["CtaIcon"]         = "bx bx-log-in";
    ViewData["SecondaryUrl"]    = "/";
    ViewData["SecondaryLabel"]  = L["Error.Shared.Home"].Value;
    ViewData["SecondaryIcon"]   = "bx bx-home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Error.401.Cta"] · SmartCanteen</title>
    <partial name="_ErrorChrome" />
</head>
<body>
    <partial name="_ErrorPage" />
</body>
</html>
