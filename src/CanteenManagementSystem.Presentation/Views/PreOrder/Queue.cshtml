@*
    /pre-orders/queue — today's pre-orders awaiting fulfilment (operator view).
*@
@using CanteenManagementSystem.Domain.Enums
@using CanteenManagementSystem.Domain.Orders
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<Order>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["PreOrder.Queue.Title"].Value;
    UiBadgeVariant V(CanteenOrderStatus s) => s switch
    {
        CanteenOrderStatus.Ready     => UiBadgeVariant.Success,
        CanteenOrderStatus.Preparing => UiBadgeVariant.Primary,
        CanteenOrderStatus.Pending   => UiBadgeVariant.Warning,
        _ => UiBadgeVariant.Info
    };
    var header = new UiPageHeaderOptions
    {
        Title    = L["PreOrder.Queue.Heading"].Value,
        Subtitle = L["PreOrder.Queue.Subtitle", DateTime.UtcNow.ToString("dd MMM yyyy"), Model.Count].Value
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions
        {
            Icon        = "bx-calendar-check",
            Title       = L["PreOrder.Queue.Empty.Title"].Value,
            Description = L["PreOrder.Queue.Empty.Description"].Value
        };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["PreOrder.Index.OrderNo"]</th>
                        <th>@L["Common.User"]</th>
                        <th>@L["Common.Items"]</th>
                        <th class="text-end">@L["Common.Total"]</th>
                        <th>@L["Common.Status"]</th>
                        <th>@L["PreOrder.Queue.PlacedAt"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var o in Model)
                {
                    var b = new UiBadgeOptions { Text = o.Status.ToString(), Variant = V(o.Status), WithDot = true };
                    <tr>
                        <td><code class="small">@o.OrderNumber</code></td>
                        <td><code class="small">@o.UserId</code></td>
                        <td class="small ui-muted">@string.Join(", ", o.OrderItems.Select(i => $"{i.Quantity}× {i.FoodItem.ItemName}"))</td>
                        <td class="text-end ui-text-strong ui-tabular">৳ @o.TotalAmount.ToString("N0")</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="ui-muted small">@o.OrderDate.ToString("MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
