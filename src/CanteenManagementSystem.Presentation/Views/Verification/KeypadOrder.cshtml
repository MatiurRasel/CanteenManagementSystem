@*
    /Verification/KeypadOrder — minimal keypad-driven order flow.
    The controller exposes ProcessKeypadInput (POST JSON) which advances the
    on-screen state machine. This view is the operator-facing shell — keep it
    simple, kiosk-friendly, always focused on the keypad.
*@
@using CanteenManagementSystem.Presentation.Models
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Verification.KeypadOrder.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["Verification.KeypadOrder.Title"].Value,
        Subtitle = L["Verification.KeypadOrder.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/Verification'><i class='bx bx-arrow-back me-1'></i> {L["Verification.KeypadOrder.CardScan"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="ui-card">
                <div class="ui-card-header"><div class="ui-card-title" id="kp-stage-title">@L["Verification.KeypadOrder.IdentifyCustomer"]</div></div>
                <div class="ui-card-body">
                    <div id="kp-stage-msg" class="ui-muted small mb-3">@L["Verification.KeypadOrder.EnterIdPrompt"]</div>
                    <input id="kp-display" type="text" inputmode="numeric"
                           class="ui-input form-control form-control-lg ui-mono"
                           style="font-size:2rem;letter-spacing:.25em;text-align:center;padding:1rem"
                           readonly />
                    <div class="ui-keypad mt-3"
                         style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem">
                        @foreach (var k in new[] { "1","2","3","4","5","6","7","8","9" })
                        {
                            <button type="button" class="btn btn-outline-secondary btn-lg kp-key" data-k="@k" style="height:64px;font-size:1.5rem">@k</button>
                        }
                        <button type="button" class="btn btn-outline-warning btn-lg" data-k="<" style="height:64px"><i class="bx bx-left-arrow-alt"></i></button>
                        <button type="button" class="btn btn-outline-secondary btn-lg kp-key" data-k="0" style="height:64px;font-size:1.5rem">0</button>
                        <button type="button" class="btn btn-success btn-lg" data-k="OK" style="height:64px"><i class="bx bx-check"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="ui-card h-100">
                <div class="ui-card-header"><div class="ui-card-title">@L["Verification.KeypadOrder.Session"]</div></div>
                <div class="ui-card-body ui-stack">
                    <div>
                        <div class="ui-label">@L["Verification.KeypadOrder.SessionId"]</div>
                        <div class="ui-mono small" id="kp-session">—</div>
                    </div>
                    <div>
                        <div class="ui-label">@L["Verification.KeypadOrder.LastResponse"]</div>
                        <pre class="ui-mono small" id="kp-log" style="max-height:280px;overflow:auto;background:var(--surface-2);padding:.75rem;border-radius:var(--rad);border:1px solid var(--border);white-space:pre-wrap">@L["Verification.KeypadOrder.NoneYet"]</pre>
                    </div>
                    <a href="/Verification" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> @L["Verification.KeypadOrder.BackToCardScan"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var display = document.getElementById('kp-display');
    var sess    = document.getElementById('kp-session');
    var log     = document.getElementById('kp-log');
    var msg     = document.getElementById('kp-stage-msg');
    var sessionId = '';

    function setDisplay(v) { display.value = v; }
    function pushLog(obj) { log.textContent = JSON.stringify(obj, null, 2); }

    async function post(key) {
        try {
            var resp = await fetch('/Verification/ProcessKeypadInput', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ SessionId: sessionId, Key: key })
            });
            var data = await resp.json();
            pushLog(data);
            if (data.sessionId) { sessionId = data.sessionId; sess.textContent = sessionId; }
            if (data.message)   msg.textContent = data.message;
        } catch (e) {
            pushLog({ error: String(e) });
        }
    }

    document.querySelectorAll('[data-k]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var k = btn.getAttribute('data-k');
            if (k === '<') {
                setDisplay(display.value.slice(0, -1));
            } else if (k === 'OK') {
                post(display.value);
                setDisplay('');
            } else {
                setDisplay(display.value + k);
            }
        });
    });

    // Physical keyboard support
    document.addEventListener('keydown', function (e) {
        if (e.key >= '0' && e.key <= '9') { setDisplay(display.value + e.key); }
        else if (e.key === 'Backspace')   { setDisplay(display.value.slice(0, -1)); }
        else if (e.key === 'Enter')       { post(display.value); setDisplay(''); }
    });
})();
</script>
}
