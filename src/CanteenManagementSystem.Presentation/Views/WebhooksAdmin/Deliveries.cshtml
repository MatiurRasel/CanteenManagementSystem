@*
    /admin/webhooks/{id}/deliveries — outbound delivery log for one subscription.
*@
@using Platform.Domain.Webhooks
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<WebhookDelivery>
@inject IStringLocalizer<SharedResource> L
@{
    var sub = ViewBag.Subscription as WebhookSubscription;
    ViewData["Title"] = L["WebhooksAdmin.Deliveries.Title", sub?.DisplayName ?? ""].Value;
    UiBadgeVariant V(string s) => s switch
    {
        "Delivered"  => UiBadgeVariant.Success,
        "Queued"     => UiBadgeVariant.Info,
        "Delivering" => UiBadgeVariant.Warning,
        "Failed"     => UiBadgeVariant.Danger,
        _ => UiBadgeVariant.Secondary
    };
    string SLabel(string s) => s switch
    {
        "Delivered"  => L["WebhooksAdmin.DeliveryStatus.Delivered"].Value,
        "Queued"     => L["WebhooksAdmin.DeliveryStatus.Queued"].Value,
        "Delivering" => L["WebhooksAdmin.DeliveryStatus.Delivering"].Value,
        "Failed"     => L["WebhooksAdmin.DeliveryStatus.Failed"].Value,
        _ => s
    };
    var header = new UiPageHeaderOptions
    {
        Title    = sub?.DisplayName ?? L["WebhooksAdmin.Deliveries.Heading"].Value,
        Subtitle = L["WebhooksAdmin.Deliveries.Subtitle", Model.Count].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/webhooks'><i class='bx bx-arrow-back me-1'></i> {L["WebhooksAdmin.AllWebhooks"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var info = new UiAlertOptions
        {
            Variant = UiAlertVariant.Info,
            Heading = L["WebhooksAdmin.Deliveries.Empty.Title"].Value,
            Body    = L["WebhooksAdmin.Deliveries.Empty.Description"].Value
        };
        <partial name="_UiAlert" model="info" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["WebhooksAdmin.Deliveries.When"]</th>
                        <th>@L["WebhooksAdmin.Deliveries.Event"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end">@L["WebhooksAdmin.Deliveries.Attempt"]</th>
                        <th class="text-end">@L["WebhooksAdmin.Deliveries.Http"]</th>
                        <th>@L["WebhooksAdmin.Deliveries.NextRetry"]</th>
                        <th>@L["WebhooksAdmin.Deliveries.Response"]</th>
                        <th class="text-end">@L["WebhooksAdmin.Deliveries.Replay"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model)
                {
                    var b = new UiBadgeOptions { Text = SLabel(d.Status), Variant = V(d.Status), WithDot = true };
                    <tr>
                        <td class="ui-mono small">@((d.LastAttemptAtUtc ?? d.FirstQueuedAtUtc)?.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                        <td><code class="small">@d.EventKey</code></td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end ui-tabular">@d.Attempt</td>
                        <td class="text-end ui-tabular">@(d.ResponseCode == 0 ? "—" : d.ResponseCode.ToString())</td>
                        <td class="ui-muted small">@(d.NextRetryAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(d.ResponseSnippet))
                            {
                                <span class="ui-muted text-truncate d-inline-block small" style="max-width:280px" title="@d.ResponseSnippet">@d.ResponseSnippet</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (d.Status == "Failed")
                            {
                                <form asp-action="Replay" asp-route-id="@d.SubscriptionId" asp-route-deliveryId="@d.DeliveryId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-rotate-right me-1"></i> @L["WebhooksAdmin.Deliveries.Replay"]
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
