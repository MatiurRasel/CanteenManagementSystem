@*
    /admin/webhooks/{id}/deliveries — outbound delivery log for one subscription.
*@
@using Platform.Domain.Webhooks
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<WebhookDelivery>
@{
    var sub = ViewBag.Subscription as WebhookSubscription;
    ViewData["Title"] = $"Deliveries · {sub?.DisplayName}";
    UiBadgeVariant V(string s) => s switch
    {
        "Delivered"  => UiBadgeVariant.Success,
        "Queued"     => UiBadgeVariant.Info,
        "Delivering" => UiBadgeVariant.Warning,
        "Failed"     => UiBadgeVariant.Danger,
        _ => UiBadgeVariant.Secondary
    };
    var header = new UiPageHeaderOptions
    {
        Title    = sub?.DisplayName ?? "Webhook deliveries",
        Subtitle = $"Delivery log — {Model.Count} attempt(s) shown",
        Actions  = Html.Raw("<a class='btn btn-outline-secondary btn-sm' href='/admin/webhooks'><i class='fa-solid fa-arrow-left me-1'></i> All webhooks</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var info = new UiAlertOptions
        {
            Variant = UiAlertVariant.Info,
            Heading = "No deliveries yet",
            Body    = "Trigger a matching event (order, wallet recharge, …) to see attempts here. Failed attempts get a Replay button so you can re-fire after fixing the receiver."
        };
        <partial name="_UiAlert" model="info" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table mb-0 ui-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Event</th>
                        <th>Status</th>
                        <th class="text-end">Attempt</th>
                        <th class="text-end">HTTP</th>
                        <th>Next retry</th>
                        <th>Response</th>
                        <th class="text-end">Replay</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model)
                {
                    var b = new UiBadgeOptions { Text = d.Status, Variant = V(d.Status), WithDot = true };
                    <tr>
                        <td class="ui-mono small">@((d.LastAttemptAtUtc ?? d.FirstQueuedAtUtc)?.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                        <td><code class="small">@d.EventKey</code></td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end ui-tabular">@d.Attempt</td>
                        <td class="text-end ui-tabular">@(d.ResponseCode == 0 ? "—" : d.ResponseCode.ToString())</td>
                        <td class="ui-muted small">@(d.NextRetryAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(d.ResponseSnippet))
                            {
                                <span class="ui-muted text-truncate d-inline-block small" style="max-width:280px" title="@d.ResponseSnippet">@d.ResponseSnippet</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (d.Status == "Failed")
                            {
                                <form asp-action="Replay" asp-route-id="@d.SubscriptionId" asp-route-deliveryId="@d.DeliveryId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-rotate-right me-1"></i> Replay
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
