@*
    /admin/webhooks — outbound subscriptions list.
*@
@using Platform.Domain.Webhooks
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<WebhookSubscription>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["WebhooksAdmin.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["WebhooksAdmin.Index.Heading"].Value,
        Subtitle = L["WebhooksAdmin.Index.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-primary' href='/admin/webhooks/new'><i class='bx bx-plus me-1'></i> {L["WebhooksAdmin.Index.AddSubscription"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions { Icon = "bx-bolt-circle", Title = L["WebhooksAdmin.Index.Empty.Title"].Value, Description = L["WebhooksAdmin.Index.Empty.Description"].Value };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["WebhooksAdmin.Index.Url"]</th>
                        <th>@L["WebhooksAdmin.Events"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end">@L["WebhooksAdmin.Index.Failures"]</th>
                        <th class="text-end">@L["WebhooksAdmin.Index.LastSuccess"]</th>
                        <th class="text-end" style="width:1%">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var w in Model)
                {
                    var b = new UiBadgeOptions
                    {
                        Text    = w.IsActive ? L["Common.Active"].Value : L["WebhooksAdmin.Status.Paused"].Value,
                        Variant = w.IsActive ? UiBadgeVariant.Success : UiBadgeVariant.Warning,
                        WithDot = true
                    };
                    <tr>
                        <td class="ui-mono" style="font-size:13px">@w.Url</td>
                        <td class="ui-muted" style="font-size:13px">@w.EventsCsv</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end ui-tabular @(w.FailureCount > 0 ? "text-danger" : "ui-muted")">@w.FailureCount</td>
                        <td class="text-end ui-muted ui-tabular" style="font-size:12px">@(w.LastSuccessAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" href="/admin/webhooks/@w.SubscriptionId">
                                <i class="bx bx-edit"></i>
                            </a>
                            <a class="btn btn-ghost btn-sm" href="/admin/webhooks/@w.SubscriptionId/deliveries" title="@L["WebhooksAdmin.Index.Deliveries"]">
                                <i class="bx bx-list-ul"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
