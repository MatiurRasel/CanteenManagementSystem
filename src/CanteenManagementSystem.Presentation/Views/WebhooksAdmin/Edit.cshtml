@*
    /admin/webhooks/{id} — single subscription editor.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.WebhooksAdminController.SubForm
@{
    var isNew = Model.SubscriptionId == 0;
    ViewData["Title"] = isNew ? "New webhook" : Model.DisplayName;
    var header = new UiPageHeaderOptions
    {
        Title    = isNew ? "New webhook subscription" : Model.DisplayName,
        Subtitle = "Outbound HTTP POST when canteen events fire. HMAC-signed; replayable from the delivery log.",
        Actions  = Html.Raw("<a class='btn btn-outline-secondary btn-sm' href='/admin/webhooks'><i class='fa-solid fa-arrow-left me-1'></i> All webhooks</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="Save">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SubscriptionId" />

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-9">
                                <label asp-for="DisplayName" class="ui-label">Display name</label>
                                <input asp-for="DisplayName" class="ui-input form-control" placeholder="School portal — order webhook" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                    <label class="form-check-label" asp-for="IsActive">Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label asp-for="Url" class="ui-label">Endpoint URL</label>
                                <input asp-for="Url" class="ui-input form-control" placeholder="https://partner.school.edu/canteen/events" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Secret" class="ui-label">HMAC secret</label>
                                <input asp-for="Secret" class="ui-input form-control ui-mono" autocomplete="off" />
                                <div class="ui-help-text">Used to sign every outbound POST. Share with the partner once — they can't view it again.</div>
                            </div>
                            <div class="col-12">
                                <label asp-for="EventsCsv" class="ui-label">Events</label>
                                <input asp-for="EventsCsv" class="ui-input form-control" placeholder="order.placed, order.delivered" />
                                <div class="ui-help-text">
                                    CSV from: <code>order.placed</code>, <code>order.delivered</code>, <code>order.voided</code>,
                                    <code>order.refunded</code>, <code>wallet.recharged</code>, <code>card.lost</code>,
                                    <code>directory.synced</code>.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ui-card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ui-card sticky-top" style="top:5rem">
                    <div class="ui-card-header"><div class="ui-card-title">Signature scheme</div></div>
                    <div class="ui-card-body small">
                        <p class="mb-2">Outbound requests carry:</p>
                        <pre class="ui-mono small mb-2" style="background:var(--surface-2);padding:.75rem;border-radius:var(--rad);border:1px solid var(--border);white-space:pre-wrap">X-App-Key:       webhook:{SubscriptionId}
X-App-Timestamp: {unix-utc-seconds}
X-App-Signature: base64( HMAC-SHA256( secret,
                   "webhook:{id}\n{ts}\nPOST\n{path}\n{body-sha256-hex}" ) )</pre>
                        <p class="ui-muted mb-0">
                            Same canonical-string algorithm as the inbound API-key flow — a partner writes
                            one verifier for both directions.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
