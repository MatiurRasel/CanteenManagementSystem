@*
    /me/orders — Eater self-serve order history.
    Reference page demonstrating shadcn-style design system on a customer screen.
*@
@using CanteenManagementSystem.Domain.Enums
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.MeController.OrderHistoryVm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MyOrders"].Value;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));

    UiBadgeVariant BadgeVariant(CanteenOrderStatus s) => s switch
    {
        CanteenOrderStatus.Delivered => UiBadgeVariant.Success,
        CanteenOrderStatus.Cancelled => UiBadgeVariant.Secondary,
        CanteenOrderStatus.Refunded  => UiBadgeVariant.Warning,
        CanteenOrderStatus.Ready     => UiBadgeVariant.Primary,
        _ => UiBadgeVariant.Info
    };

    var header = new UiPageHeaderOptions
    {
        Title    = L["MyOrders"].Value,
        Subtitle = L["Me.Orders.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-outline-primary' href='/me/orders.csv'><i class='bx bx-spreadsheet me-1'></i> {L["Me.Orders.OrdersCsv"].Value}</a> <a class='btn btn-sm btn-outline-secondary ms-2' href='/me/export' title='{L["Me.Orders.DownloadDataTitle"].Value}'><i class='bx bx-download me-1'></i> {L["Me.Orders.DownloadData"].Value}</a> <a class='btn btn-sm btn-outline-secondary ms-2' href='/me/favorites'><i class='bx bx-heart me-1'></i> {L["Me.Orders.Favourites"].Value}</a>")
    };

    var notLinkedAlert = new UiAlertOptions
    {
        Variant = UiAlertVariant.Info,
        Heading = L["Me.Orders.NotLinkedHeading"].Value,
        Body    = L["Me.Orders.NotLinkedBody"].Value
    };

    var balKpi   = new UiKpiOptions { Label = L["Me.Orders.WalletBalance"].Value,  Value = $"৳ {(Model.CurrentBalance ?? 0):N0}", Icon = "bx bx-wallet" };
    var spendKpi = new UiKpiOptions { Label = L["Me.Orders.SpentThisMonth"].Value, Value = $"৳ {Model.SpentThisMonth:N0}",       Icon = "bx bx-receipt" };
    var countKpi = new UiKpiOptions { Label = L["Me.Orders.TotalOrders"].Value,    Value = Model.TotalCount.ToString("N0"),       Icon = "bx bx-cart" };
    var avgKpi   = new UiKpiOptions
    {
        Label = L["Me.Orders.AvgOrder"].Value,
        Value = Model.TotalCount > 0 ? $"৳ {Model.SpentThisMonth / Math.Max(1, Model.TotalCount):N0}" : "—",
        Icon  = "bx bx-line-chart"
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (string.IsNullOrEmpty(Model.LinkedPersonId))
    {
        <partial name="_UiAlert" model="notLinkedAlert" />
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3"><partial name="_UiKpi" model="balKpi"   /></div>
            <div class="col-6 col-md-3"><partial name="_UiKpi" model="spendKpi" /></div>
            <div class="col-6 col-md-3"><partial name="_UiKpi" model="countKpi" /></div>
            <div class="col-6 col-md-3"><partial name="_UiKpi" model="avgKpi"   /></div>
        </div>

        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["Me.Orders.OrderNumber"]</th>
                        <th>@L["Me.Orders.When"]</th>
                        <th>@L["Common.Items"]</th>
                        <th class="text-end">@L["Common.Total"]</th>
                        <th>@L["Common.Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-5 ui-muted">@L["Me.Orders.EmptyOrders"]</td></tr>
                    }
                    @foreach (var o in Model.Items)
                    {
                        var statusBadge = new UiBadgeOptions { Text = o.Status.ToString(), Variant = BadgeVariant(o.Status), WithDot = true };
                        var itemCount   = o.OrderItems?.Count ?? 0;
                        var itemSummary = o.OrderItems is null ? "" : string.Join(", ", o.OrderItems.Select(oi => $"{oi.Quantity}× {oi.FoodItem?.ItemName ?? L["Me.Orders.ItemFallback"].Value}"));
                        <tr>
                            <td class="ui-mono">@o.OrderNumber</td>
                            <td class="ui-muted ui-tabular">@o.OrderDate.ToString("yyyy-MM-dd · HH:mm")</td>
                            <td>
                                <div class="ui-text-strong" style="font-size:13px">@itemSummary</div>
                                <div class="ui-muted" style="font-size:12px">@L["Me.Orders.ItemCount", itemCount]</div>
                            </td>
                            <td class="text-end ui-tabular ui-text-strong">৳ @o.TotalAmount.ToString("N0")</td>
                            <td><partial name="_UiBadge" model="statusBadge" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-4" aria-label="@L["Me.Orders.PaginationLabel"]">
                <ul class="pagination justify-content-center">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="?page=@p">@p</a></li>
                    }
                </ul>
            </nav>
        }
    }
</div>
