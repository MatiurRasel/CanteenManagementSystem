@*
    /directory-admin/employees — paginated employee roster.
*@
@using CanteenManagementSystem.Domain.Users
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.DirectoryAdminUiController.RosterPage<Employee>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DirectoryAdminUi.Employees.PageTitle"].Value;
    var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    var searchForm = $@"
        <form method='get' action='/directory-admin/Employees' class='d-flex gap-2'>
            <input type='text' name='q' value='{System.Net.WebUtility.HtmlEncode(Model.Q ?? "")}'
                   class='ui-input form-control form-control-sm' placeholder='{L["DirectoryAdminUi.SearchPlaceholder"].Value}' style='min-width:240px' />
            <button type='submit' class='btn btn-outline-primary btn-sm'>
                <i class='bx bx-search me-1'></i> {L["Common.Search"].Value}
            </button>
        </form>";
    var header = new UiPageHeaderOptions
    {
        Title    = L["DirectoryAdminUi.Employees"].Value,
        Subtitle = L["DirectoryAdminUi.RecordCount", Model.TotalCount.ToString("N0")].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm me-2' href='/directory-admin'><i class='bx bx-arrow-back me-1'></i> {L["Directory"].Value}</a>{searchForm}")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="ui-table-wrap">
        <table class="table table-hover mb-0 ui-table">
            <thead>
                <tr>
                    <th>@L["DirectoryAdminUi.ExternalId"]</th>
                    <th>@L["DirectoryAdminUi.Card"]</th>
                    <th>@L["Common.Name"]</th>
                    <th>@L["DirectoryAdminUi.Employees.Designation"]</th>
                    <th>@L["Common.Type"]</th>
                    <th>@L["DirectoryAdminUi.Contact"]</th>
                    <th>@L["DirectoryAdminUi.Synced"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td><code class="small">@e.ExternalId</code></td>
                    <td><code class="small">@(e.CardIdentifier ?? "—")</code></td>
                    <td class="ui-text-strong">@e.Name</td>
                    <td class="small">@(e.Designation ?? "—")</td>
                    <td class="small">@(e.EmployeeType ?? "—")</td>
                    <td class="small">@(e.ContactNo ?? "—")</td>
                    <td class="ui-muted small">@e.SyncedAtUtc.ToString("MM-dd HH:mm")</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="p-0"><partial name="_EmptyState" model="@(new EmptyStateOptions { Icon = "bx-id-card", Title = L["DirectoryAdminUi.Employees.EmptyTitle"].Value, Description = L["DirectoryAdminUi.Roster.EmptyDescription"].Value, CtaLabel = L["Directory"].Value, CtaUrl = Url.Action("Index") })" /></td></tr>
            }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="ui-muted">@L["Common.Page"] @Model.Page @L["Common.Of"] @totalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @if (Model.Page > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Employees" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Q">@L["Common.Previous"]</a></li>
                    }
                    @if (Model.Page < totalPages)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Employees" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Q">@L["Common.Next"]</a></li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
