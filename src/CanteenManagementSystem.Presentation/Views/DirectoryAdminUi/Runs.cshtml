@*
    /directory-admin/runs — full sync-run history.
*@
@using Platform.Domain.Directory
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<DirectorySyncRun>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DirectoryAdminUi.Runs.PageTitle"].Value;
    UiBadgeVariant V(string s) => s switch
    {
        "Success" => UiBadgeVariant.Success,
        "Failed"  => UiBadgeVariant.Danger,
        "Running" => UiBadgeVariant.Warning,
        _ => UiBadgeVariant.Secondary
    };
    var header = new UiPageHeaderOptions
    {
        Title    = L["DirectoryAdminUi.Runs.Heading"].Value,
        Subtitle = L["DirectoryAdminUi.Runs.Subtitle", Model.Count].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/directory-admin'><i class='bx bx-arrow-back me-1'></i> {L["Directory"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="ui-table-wrap">
        <table class="table mb-0 ui-table">
            <thead>
                <tr>
                    <th>@L["DirectoryAdminUi.Runs.Started"]</th>
                    <th>@L["DirectoryAdminUi.Source"]</th>
                    <th>@L["Common.Status"]</th>
                    <th>@L["DirectoryAdminUi.StudentsDelta"]</th>
                    <th>@L["DirectoryAdminUi.EmployeesDelta"]</th>
                    <th>@L["DirectoryAdminUi.Duration"]</th>
                    <th>@L["Common.Error"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                var b = new UiBadgeOptions { Text = L[$"DirectoryAdminUi.RunStatus.{r.Status}"].Value, Variant = V(r.Status), WithDot = true };
                <tr>
                    <td class="ui-mono small">@r.StartedAtUtc.ToString("u")</td>
                    <td><code class="small">@r.Source</code></td>
                    <td><partial name="_UiBadge" model="b" /></td>
                    <td class="ui-muted small">+@r.StudentsAdded / ~@r.StudentsUpdated / -@r.StudentsDisabled</td>
                    <td class="ui-muted small">+@r.EmployeesAdded / ~@r.EmployeesUpdated / -@r.EmployeesDisabled</td>
                    <td class="ui-tabular small">@(r.Duration?.ToString(@"mm\:ss") ?? "—")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(r.ErrorMessage))
                        {
                            <span class="text-danger small" title="@r.ErrorMessage">
                                @(r.ErrorMessage.Length > 80 ? r.ErrorMessage[..80] + "…" : r.ErrorMessage)
                            </span>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="p-0"><partial name="_EmptyState" model="@(new EmptyStateOptions { Icon = "bx-refresh", Title = L["DirectoryAdminUi.NoRuns.Title"].Value, Description = L["DirectoryAdminUi.NoRuns.Description"].Value })" /></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
