@*
    /admin/cards — NFC card lifecycle list.
*@
@using CanteenManagementSystem.Domain.Cards
@using CanteenManagementSystem.Domain.Enums
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<CanteenManagementSystem.Presentation.Controllers.CardsAdminController.CardRow>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Cards"].Value;
    UiBadgeVariant V(CardStatus s) => s switch
    {
        CardStatus.Active     => UiBadgeVariant.Success,
        CardStatus.Issued     => UiBadgeVariant.Primary,
        CardStatus.Blocked    => UiBadgeVariant.Warning,
        CardStatus.Lost       => UiBadgeVariant.Danger,
        CardStatus.Retired    => UiBadgeVariant.Secondary,
        _ => UiBadgeVariant.Info
    };
    var header = new UiPageHeaderOptions
    {
        Title    = L["Cards"].Value,
        Subtitle = L["CardsAdmin.Index.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-primary' href='/admin/cards/issue'><i class='bx bx-plus me-1'></i> {L["CardsAdmin.Index.IssueCard"].Value}</a>")
    };

    var q      = ViewBag.Q      as string;
    var status = ViewBag.Status as CardStatus?;
    var kpiTotal   = new UiKpiOptions { Label = L["Common.Total"].Value,              Value = Model.Count.ToString("N0"), Icon = "bx bx-id-card" };
    var kpiActive  = new UiKpiOptions { Label = L["Common.Active"].Value,             Value = Model.Count(c => c.Status == CardStatus.Active).ToString("N0"),  Icon = "bx bx-check-circle" };
    var kpiBlocked = new UiKpiOptions { Label = L["CardsAdmin.Status.Blocked"].Value, Value = Model.Count(c => c.Status == CardStatus.Blocked).ToString("N0"), Icon = "bx bx-block" };
    var kpiLost    = new UiKpiOptions { Label = L["CardsAdmin.Status.Lost"].Value,    Value = Model.Count(c => c.Status == CardStatus.Lost).ToString("N0"),    Icon = "bx bx-error" };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiTotal"   /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiActive"  /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiBlocked" /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiLost"    /></div>
    </div>

    <form method="get" class="ui-card mb-4">
        <div class="ui-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="ui-label">@L["Common.Search"]</label>
                    <input type="text" name="q" value="@q" class="ui-input form-control" placeholder="@L["CardsAdmin.Index.SearchPlaceholder"]" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="ui-label">@L["Common.Status"]</label>
                    <select name="status" class="form-select ui-select">
                        <option value="">@L["Common.All"]</option>
                        @foreach (var s in Enum.GetValues<CardStatus>())
                        {
                            <option value="@s" selected="@(status == s)">@L[$"CardsAdmin.Status.{s}"]</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">@L["Common.Filter"]</button>
                </div>
            </div>
        </div>
    </form>

    <div class="ui-table-wrap">
        <table class="table table-hover mb-0 ui-table">
            <thead>
                <tr>
                    <th>@L["CardsAdmin.Index.Uid"]</th>
                    <th>@L["Common.User"]</th>
                    <th>@L["Common.Type"]</th>
                    <th>@L["Common.Status"]</th>
                    <th class="text-end">@L["CardsAdmin.Issued"]</th>
                    <th class="text-end">@L["CardsAdmin.Status.Blocked"]</th>
                    <th class="text-end" style="width:1%">@L["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="p-0">
                            <partial name="_EmptyState" model="@(new EmptyStateOptions
                            {
                                Icon        = "bx-id-card",
                                Title       = L["CardsAdmin.Index.Empty.Title"],
                                Description = L["CardsAdmin.Index.Empty.Description"]
                            })" />
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    var b = new UiBadgeOptions { Text = L[$"CardsAdmin.Status.{c.Status}"].Value, Variant = V(c.Status), WithDot = true };
                    <tr>
                        <td class="ui-mono ui-text-strong">@c.CardUid</td>
                        <td>@c.UserId</td>
                        <td class="ui-muted">@c.UserType</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end ui-muted ui-tabular" style="font-size:12px">@c.IssuedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td class="text-end ui-muted ui-tabular" style="font-size:12px">@(c.BlockedAtUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-end">
                            <div class="ui-row" style="gap:.25rem; justify-content:flex-end">
                                <a class="btn btn-ghost btn-sm" href="/admin/cards/@c.CardId" title="@L["Common.Details"]">
                                    <i class="bx bx-info-circle"></i>
                                </a>
                                <a class="btn btn-ghost btn-sm" href="/admin/cards/@c.CardId/print" target="_blank" title="@L["CardsAdmin.PrintCard"]">
                                    <i class="bx bx-printer"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
