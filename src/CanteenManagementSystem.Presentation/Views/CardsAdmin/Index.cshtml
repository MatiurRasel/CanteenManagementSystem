@*
    /admin/cards — NFC card lifecycle list.
*@
@using CanteenManagementSystem.Domain.Cards
@using CanteenManagementSystem.Domain.Enums
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<CanteenManagementSystem.Presentation.Controllers.CardsAdminController.CardRow>
@{
    ViewData["Title"] = "Cards";
    UiBadgeVariant V(CardStatus s) => s switch
    {
        CardStatus.Active     => UiBadgeVariant.Success,
        CardStatus.Issued     => UiBadgeVariant.Primary,
        CardStatus.Blocked    => UiBadgeVariant.Warning,
        CardStatus.Lost       => UiBadgeVariant.Danger,
        CardStatus.Retired    => UiBadgeVariant.Secondary,
        _ => UiBadgeVariant.Info
    };
    var header = new UiPageHeaderOptions
    {
        Title    = "NFC cards",
        Subtitle = "Issue, block, reassign, and re-print cards. Cache-busted on every change so the next swipe reflects it.",
        Actions  = Html.Raw("<a class='btn btn-sm btn-primary' href='/admin/cards/issue'><i class='fa-solid fa-plus me-1'></i> Issue card</a>")
    };

    var q      = ViewBag.Q      as string;
    var status = ViewBag.Status as CardStatus?;
    var kpiTotal   = new UiKpiOptions { Label = "Total",   Value = Model.Count.ToString("N0"), Icon = "fa-id-card-clip" };
    var kpiActive  = new UiKpiOptions { Label = "Active",  Value = Model.Count(c => c.Status == CardStatus.Active).ToString("N0"),  Icon = "fa-circle-check" };
    var kpiBlocked = new UiKpiOptions { Label = "Blocked", Value = Model.Count(c => c.Status == CardStatus.Blocked).ToString("N0"), Icon = "fa-ban" };
    var kpiLost    = new UiKpiOptions { Label = "Lost",    Value = Model.Count(c => c.Status == CardStatus.Lost).ToString("N0"),    Icon = "fa-triangle-exclamation" };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiTotal"   /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiActive"  /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiBlocked" /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiLost"    /></div>
    </div>

    <form method="get" class="ui-card mb-4">
        <div class="ui-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="ui-label">Search</label>
                    <input type="text" name="q" value="@q" class="ui-input form-control" placeholder="Card UID or user id…" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="ui-label">Status</label>
                    <select name="status" class="form-select ui-select">
                        <option value="">Any</option>
                        @foreach (var s in Enum.GetValues<CardStatus>())
                        {
                            <option value="@s" selected="@(status == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </div>
        </div>
    </form>

    <div class="ui-table-wrap">
        <table class="table table-hover mb-0 ui-table">
            <thead>
                <tr>
                    <th>UID</th>
                    <th>User</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Issued</th>
                    <th class="text-end">Blocked</th>
                    <th class="text-end" style="width:1%">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-5 ui-muted">No cards match this filter.</td></tr>
                }
                @foreach (var c in Model)
                {
                    var b = new UiBadgeOptions { Text = c.Status.ToString(), Variant = V(c.Status), WithDot = true };
                    <tr>
                        <td class="ui-mono ui-text-strong">@c.CardUid</td>
                        <td>@c.UserId</td>
                        <td class="ui-muted">@c.UserType</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end ui-muted ui-tabular" style="font-size:12px">@c.IssuedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td class="text-end ui-muted ui-tabular" style="font-size:12px">@(c.BlockedAtUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-end">
                            <div class="ui-row" style="gap:.25rem; justify-content:flex-end">
                                <a class="btn btn-ghost btn-sm" href="/admin/cards/@c.CardId" title="Details">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>
                                <a class="btn btn-ghost btn-sm" href="/admin/cards/@c.CardId/print" target="_blank" title="Print card">
                                    <i class="fa-solid fa-print"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
