@*
    /admin/cards/issue — issue a new card to a user.
*@
@using CanteenManagementSystem.Domain.Enums
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.CardsAdminController.IssueForm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CardsAdmin.Index.IssueCard"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["CardsAdmin.Issue.Title"].Value,
        Subtitle = L["CardsAdmin.Issue.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/cards'><i class='bx bx-arrow-back me-1'></i> {L["CardsAdmin.AllCards"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="Issue">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CardUid" class="ui-label">@L["CardsAdmin.Issue.CardUid"]</label>
                                <input asp-for="CardUid" class="ui-input form-control ui-mono" placeholder="A1B2C3D4"
                                       autocomplete="off" data-cl-hid-uid />
                                <div class="ui-help-text">
                                    @L["CardsAdmin.Issue.CardUidHelp"]
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="UserType" class="ui-label">@L["CardsAdmin.Issue.UserType"]</label>
                                <select asp-for="UserType" class="form-select ui-select">
                                    @foreach (var t in Enum.GetValues<CanteenUserType>())
                                    {
                                        <option value="@t">@L[$"CardsAdmin.UserType.{t}"]</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="UserId" class="ui-label">@L["CardsAdmin.Issue.UserId"]</label>
                                <input asp-for="UserId" class="ui-input form-control" placeholder="STD-2026-001" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Notes" class="ui-label">@L["CardsAdmin.Issue.Notes"]</label>
                                <input asp-for="Notes" class="ui-input form-control" placeholder="@L["CardsAdmin.Issue.NotesPlaceholder"]" />
                            </div>
                        </div>
                    </div>
                    <div class="ui-card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bx bx-check me-1"></i> @L["CardsAdmin.Issue.Submit"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@L["Common.Cancel"]</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="ui-card">
                    <div class="ui-card-header"><div class="ui-card-title">@L["CardsAdmin.Issue.Reminder.Title"]</div></div>
                    <div class="ui-card-body">
                        <p class="ui-muted small mb-2">
                            @L["CardsAdmin.Issue.Reminder.Body1"]
                        </p>
                        <p class="ui-muted small mb-0">
                            @L["CardsAdmin.Issue.Reminder.Body2"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
