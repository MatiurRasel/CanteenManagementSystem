@*
    /Display/Menu — TV menu board. Standalone-layout, dark theme, auto-refresh.

    Behaviour contract (preserved):
      * GET /Display/GetTodayMenu → { success, items[], config }
      * Refresh on tenant-configured interval (default 5000ms)
      * "n" keypress toggles nutrition/allergen chips for the session
      * dietary chips (veg/halal) always shown when present; kcal/allergens
        gated by tenant `ShowNutritionOnDisplay` (default on)
*@
@using CanteenManagementSystem.Domain.Enums
@using Platform.Domain.Tenancy
@using Platform.Application.Configuration
@inject IStringLocalizer<SharedResource> L
@{
    var clientInfo = ViewBag.ClientInfo as Client;
    var config     = ViewBag.Config as CanteenConfiguration;
    var showPrices      = config?.ShowPricesOnDisplay   ?? true;
    var showStock       = config?.ShowStockQuantity     ?? true;
    var showNutrition   = config?.ShowNutritionOnDisplay ?? true;
    var refreshInterval = config?.DisplayRefreshInterval ?? 5000;
    ViewData["Title"] = clientInfo?.ClientName ?? "Smart Canteen";
    Layout = null;
}
<!DOCTYPE html>
<html lang="bn" class="ks-html" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] · @L["Display.Menu.LiveMenu"]</title>
    <partial name="_KioskShell" />
    <link rel="stylesheet" href="~/css/canteen-loading.css" asp-append-version="true" />
    <style>
        body.ks-body {
            background:
                radial-gradient(circle at 10% 10%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(59,130,246,.18), transparent 40%),
                var(--ks-surface-canvas);
        }
        .display-content {
            flex: 1 1 auto;
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 1rem;
            padding: 1rem 1.5rem;
        }
        @@media (max-width: 992px) {
            .display-content { grid-template-columns: 1fr; }
            .display-side    { order: -1; }
        }
        .display-side {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .display-side-card {
            background: var(--ks-surface-card);
            border: 1px solid var(--border);
            border-radius: var(--rad-lg);
            padding: 1.25rem 1.35rem;
        }
        .display-side-card .label {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: var(--muted);
            font-weight: 700;
            margin-bottom: .5rem;
        }
        .display-clock {
            font-size: clamp(2.5rem, 5vw, 3.5rem);
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            letter-spacing: -.02em;
            color: var(--fg);
            line-height: 1;
        }
        .display-date {
            color: var(--muted);
            font-size: .9rem;
            margin-top: .5rem;
        }
        .display-config-row {
            display: flex;
            justify-content: space-between;
            font-size: .85rem;
            padding: .25rem 0;
        }
        .display-config-row strong { color: var(--fg); }

        .menu-grid-wrap {
            background: var(--ks-surface-card);
            border: 1px solid var(--border);
            border-radius: var(--rad-lg);
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .menu-grid-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: .85rem;
            border-bottom: 1px solid var(--border);
        }
        .menu-grid-header h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--fg);
            margin: 0;
        }
        .menu-grid-header .meta { font-size: .85rem; color: var(--muted); }
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
            flex: 1 1 auto;
            overflow: auto;
            min-height: 60vh;
        }
        .display-empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: 4rem 1.5rem;
            color: var(--muted);
        }
        .display-empty i { font-size: 3.5rem; color: var(--accent); opacity: .55; margin-bottom: 1rem; }

        .live-pill {
            display: inline-flex; align-items: center; gap: .5rem;
            padding: .35rem .85rem;
            border-radius: var(--rad-pill);
            background: rgba(16,185,129,.18);
            color: #6ee7b7;
            font-weight: 700;
            font-size: .82rem;
            letter-spacing: .04em;
        }
        .live-pill .dot {
            width: 10px; height: 10px; border-radius: 50%;
            background: #10b981; box-shadow: 0 0 0 4px rgba(16,185,129,.22);
            animation: ks-pulse 1.6s ease-in-out infinite;
        }
        /* Skeleton region keeps the grid's flex sizing while hydrating. */
        #menuRegion { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
        #menuRegion > .skeleton-target { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
    </style>
</head>
<body class="ks-body">

<div class="ks-shell">
    <header class="ks-header">
        <div class="d-flex align-items-center gap-3">
            <div class="ks-balance-icon"><i class="bx bx-restaurant"></i></div>
            <div>
                <div class="ks-title">@(clientInfo?.ClientName ?? "Smart Canteen")</div>
                <div class="ks-subtitle">@(clientInfo?.ShortName ?? L["Display.Menu.LiveMenuDisplay"].Value)</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="live-pill"><span class="dot"></span> @L["Display.Menu.Live"]</span>
            <div class="ks-clock" id="clock">--:--:--</div>
        </div>
    </header>

    <div class="display-content">
        <section class="menu-grid-wrap">
            <div class="menu-grid-header">
                <h2><i class="bx bx-bowl-hot me-2"></i> @L["TodayMenu"]</h2>
                <div class="meta">@L["Display.Menu.AutoRefresh"] · <span id="menu-count">0</span> @L["Display.Menu.ItemCountSuffix"]</div>
            </div>
            <div id="menuRegion" data-loaded="false">
                <partial name="_Skeleton" model="@(new SkeletonOptions { Variant = SkeletonVariant.Card, Rows = 6, Card = true })" />
                <div class="skeleton-target">
                    <div id="menuGrid" class="menu-grid"></div>
                </div>
            </div>
        </section>

        <aside class="display-side">
            <div class="display-side-card">
                <div class="label">@L["Display.Menu.Now"]</div>
                <div class="display-clock" id="clock-big">--:--</div>
                <div class="display-date" id="date">—</div>
            </div>
            <div class="display-side-card">
                <div class="label">@L["Display.Menu.DisplaySettings"]</div>
                <div class="display-config-row"><span>@L["Display.Menu.Prices"]</span>    <strong>@(showPrices ? L["Display.Menu.On"].Value : L["Display.Menu.Off"].Value)</strong></div>
                <div class="display-config-row"><span>@L["Display.Menu.Stock"]</span>     <strong>@(showStock ? L["Display.Menu.On"].Value : L["Display.Menu.Off"].Value)</strong></div>
                <div class="display-config-row"><span>@L["Display.Menu.Nutrition"]</span> <strong id="cfg-nutrition">@(showNutrition ? L["Display.Menu.On"].Value : L["Display.Menu.Off"].Value)</strong></div>
                <div class="display-config-row"><span>@L["Common.Refresh"]</span>   <strong>@refreshInterval ms</strong></div>
            </div>
            <div class="display-side-card">
                <div class="label">@L["Display.Menu.QuickKeys"]</div>
                <div class="ui-muted small"><kbd>N</kbd> @L["Display.Menu.ToggleNutrition"]</div>
                <div class="ui-muted small mt-1"><kbd>F</kbd> @L["Display.Menu.Fullscreen"]</div>
            </div>
        </aside>
    </div>
</div>

<script src="~/js/canteen-loading.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';
    var showPrices    = @(showPrices.ToString().ToLowerInvariant());
    var showStock     = @(showStock.ToString().ToLowerInvariant());
    var showNutrition = @(showNutrition.ToString().ToLowerInvariant());
    var refreshInterval = @refreshInterval;
    var T = {
        veg:          '@L["Display.Menu.Veg"]',
        halal:        '@L["Display.Menu.Halal"]',
        soldOut:      '@L["Display.Menu.SoldOut"]',
        onlyLeft:     '@L["Display.Menu.OnlyLeft"]',
        stockCount:   '@L["Display.Menu.StockCount"]',
        loadFailed:   '@L["Display.Menu.LoadFailed"]',
        noMenu:       '@L["Display.Menu.NoMenu"]',
        networkRetry: '@L["Display.Menu.NetworkRetry"]',
        on:           '@L["Display.Menu.On"]',
        off:          '@L["Display.Menu.Off"]'
    };

    function escapeHtml(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function renderChips(item) {
        var html = '';
        if (item.isVegetarian) html += '<span class="ks-chip chip-veg"><i class="bx bx-leaf"></i> ' + T.veg + '</span>';
        if (item.isHalal)      html += '<span class="ks-chip chip-halal"><i class="bx bx-check-circle"></i> ' + T.halal + '</span>';
        if (showNutrition) {
            if (item.kCalories && item.kCalories > 0)
                html += '<span class="ks-chip chip-kcal"><i class="bx bxs-flame"></i> ' + item.kCalories + ' kcal</span>';
            if (item.allergens) {
                String(item.allergens).split(',').map(function (s) { return s.trim(); }).filter(Boolean)
                    .forEach(function (a) {
                        html += '<span class="ks-chip chip-allergy"><i class="bx bx-error"></i> ' + escapeHtml(a) + '</span>';
                    });
            }
        }
        return html ? '<div class="d-flex flex-wrap gap-1">' + html + '</div>' : '';
    }
    function renderCard(item) {
        var price = showPrices
            ? '<div class="ks-tv-card-price">৳ ' + Number(item.price || 0).toLocaleString('bn-BD') + '</div>'
            : '';
        var stock = '';
        if (showStock) {
            var n = item.availableQuantity ?? 0;
            var cls = n === 0 ? 'chip-out' : n <= 5 ? 'chip-low' : 'chip-in';
            stock = '<span class="ks-chip ' + cls + '">' +
                    (n === 0 ? T.soldOut : (n <= 5 ? T.onlyLeft.replace('{0}', n) : T.stockCount.replace('{0}', n))) +
                    '</span>';
        }
        return '<article class="ks-tv-card">' +
                '<div class="ks-tv-card-number">' + (item.itemNumber || '—') + '</div>' +
                '<h3 class="ks-tv-card-name">' + escapeHtml(item.itemName || '') + '</h3>' +
                (item.categoryBengali
                    ? '<div class="ks-tv-card-category">' + escapeHtml(item.categoryEmoji || '') + ' ' + escapeHtml(item.categoryBengali) + '</div>'
                    : '') +
                (item.description ? '<div class="ui-muted small">' + escapeHtml(item.description) + '</div>' : '') +
                renderChips(item) +
                '<div class="ks-tv-card-footer">' + price + stock + '</div>' +
            '</article>';
    }

    var menuGrid  = document.getElementById('menuGrid');
    var menuCount = document.getElementById('menu-count');

    // Reveal the hydrated region after the FIRST render only — the 5s
    // auto-refresh must never flash the skeleton again.
    var firstRender = true;
    function revealMenu() {
        if (!firstRender) return;
        firstRender = false;
        if (window.CanteenLoading) { CanteenLoading.hide('#menuRegion'); }
        else { document.getElementById('menuRegion').setAttribute('data-loaded', 'true'); }
    }

    async function loadMenu() {
        try {
            var res  = await fetch('@Url.Action("GetTodayMenu", "Display")');
            var data = await res.json();
            if (!data.success) {
                menuGrid.innerHTML = '<div class="display-empty"><i class="bx bx-error-circle"></i><div>' + T.loadFailed + '</div></div>';
                return;
            }
            var items = data.items || [];
            menuCount.textContent = items.length;
            if (items.length === 0) {
                menuGrid.innerHTML = '<div class="display-empty"><i class="bx bxs-bowl-hot"></i><div>' + T.noMenu + '</div></div>';
                return;
            }
            menuGrid.innerHTML = items.map(renderCard).join('');
        } catch (e) {
            console.error('menu load failed', e);
            menuGrid.innerHTML = '<div class="display-empty"><i class="bx bx-error-circle"></i><div>' + T.networkRetry + '</div></div>';
        } finally {
            revealMenu();
        }
    }

    function tickClock() {
        var d = new Date();
        function p(n) { return String(n).padStart(2, '0'); }
        var hms = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
        document.getElementById('clock').textContent     = hms;
        document.getElementById('clock-big').textContent = p(d.getHours()) + ':' + p(d.getMinutes());
        document.getElementById('date').textContent =
            d.toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'n' || e.key === 'N') {
            showNutrition = !showNutrition;
            document.getElementById('cfg-nutrition').textContent = showNutrition ? T.on : T.off;
            loadMenu();
        }
        if (e.key === 'f' || e.key === 'F') {
            if (document.fullscreenElement) document.exitFullscreen();
            else document.documentElement.requestFullscreen();
        }
    });

    loadMenu(); tickClock();
    setInterval(tickClock, 1000);
    setInterval(loadMenu, refreshInterval);
})();
</script>

</body>
</html>
