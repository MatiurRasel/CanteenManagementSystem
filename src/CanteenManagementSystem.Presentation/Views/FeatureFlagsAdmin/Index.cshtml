@*
    /admin/feature-flags — per-tenant feature toggles.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.FeatureFlagsAdminController.FeatureFlagsVm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["FeatureFlagsAdmin.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["FeatureFlagsAdmin.Index.Title"].Value,
        Subtitle = L["FeatureFlagsAdmin.Index.Subtitle"].Value
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="ui-card">
        <div class="ui-card-body p-0">
            <table class="table mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["FeatureFlagsAdmin.Index.ColFlag"]</th>
                        <th>@L["FeatureFlagsAdmin.Index.ColKey"]</th>
                        <th class="text-end" style="width:1%">@L["FeatureFlagsAdmin.Index.ColState"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var f in Model.Flags)
                {
                    var on = f.Enabled;
                    var stateBadge = new UiBadgeOptions
                    {
                        Text = on ? L["FeatureFlagsAdmin.Index.On"].Value : L["FeatureFlagsAdmin.Index.Off"].Value,
                        Variant = on ? UiBadgeVariant.Success : UiBadgeVariant.Secondary,
                        WithDot = true
                    };
                    <tr>
                        <td class="ui-text-strong">@f.DisplayName</td>
                        <td class="ui-mono ui-muted" style="font-size:12px">@f.Key</td>
                        <td class="text-end">
                            <div class="ui-row" style="gap:.5rem; justify-content:flex-end">
                                <partial name="_UiBadge" model="stateBadge" />
                                <form method="post" action="/admin/feature-flags/toggle" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="key" value="@f.Key" />
                                    <input type="hidden" name="enabled" value="@((!on).ToString().ToLowerInvariant())" />
                                    <button class="btn btn-ghost btn-sm" type="submit" title="@L["FeatureFlagsAdmin.Index.Toggle"]">
                                        <i class="bx @(on ? "bx-toggle-right" : "bx-toggle-left")" style="font-size:18px"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
