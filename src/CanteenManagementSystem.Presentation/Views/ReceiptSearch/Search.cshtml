@*
    /admin/receipts/search — order finder.
*@
@using CanteenManagementSystem.Domain.Enums
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.ReceiptSearchController.ReceiptSearchVm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ReceiptSearch.Search.Title"].Value;
    UiBadgeVariant V(CanteenOrderStatus s) => s switch
    {
        CanteenOrderStatus.Delivered => UiBadgeVariant.Success,
        CanteenOrderStatus.Cancelled => UiBadgeVariant.Secondary,
        CanteenOrderStatus.Refunded  => UiBadgeVariant.Warning,
        CanteenOrderStatus.Ready     => UiBadgeVariant.Primary,
        _ => UiBadgeVariant.Info
    };
    var header = new UiPageHeaderOptions
    {
        Title    = L["ReceiptSearch.Search.Title"].Value,
        Subtitle = L["ReceiptSearch.Search.Subtitle"].Value
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="get" class="ui-card mb-4">
        <div class="ui-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="ui-label">@L["Common.Search"]</label>
                    <input class="ui-input form-control" name="q" value="@Model.Q" placeholder="@L["ReceiptSearch.Search.Placeholder"]" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="ui-label">@L["Common.From"]</label>
                    <input class="ui-input form-control" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="ui-label">@L["Common.To"]</label>
                    <input class="ui-input form-control" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-3">
                    <button class="btn btn-primary w-100" type="submit"><i class="bx bx-search me-1"></i> @L["Common.Search"]</button>
                </div>
            </div>
        </div>
    </form>

    <div class="ui-table-wrap">
        <table class="table table-hover mb-0 ui-table">
            <thead>
                <tr>
                    <th>@L["Me.Orders.OrderNumber"]</th>
                    <th>@L["Common.User"]</th>
                    <th class="text-end">@L["Common.Total"]</th>
                    <th>@L["Common.Status"]</th>
                    <th class="text-end">@L["Me.Orders.When"]</th>
                    <th class="text-end" style="width:1%">@L["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Hits.Count == 0)
                {
                    <tr><td colspan="6" class="text-center py-5 ui-muted">@L["ReceiptSearch.Search.NoMatches"]</td></tr>
                }
                @foreach (var h in Model.Hits)
                {
                    var b = new UiBadgeOptions { Text = h.Status.ToString(), Variant = V(h.Status), WithDot = true };
                    <tr>
                        <td class="ui-mono ui-text-strong">@h.OrderNumber</td>
                        <td>
                            <div>@h.UserId</div>
                            <div class="ui-muted" style="font-size:12px">@h.UserType</div>
                        </td>
                        <td class="text-end ui-tabular">৳ @h.TotalAmount.ToString("N0")</td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end ui-muted ui-tabular">@h.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <form method="post" action="/admin/printer/reprint/@h.OrderId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-ghost btn-sm" type="submit" title="@L["ReceiptSearch.Search.Reprint"]">
                                    <i class="bx bx-printer"></i>
                                </button>
                            </form>
                            <a class="btn btn-ghost btn-sm" href="/display/order/@h.OrderNumber" target="_blank" title="@L["Common.View"]">
                                <i class="bx bx-show"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{ var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)); }
    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="receipts-pagination">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Math.Min(15, totalPages); p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="?page=@p&q=@Model.Q&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")">@p</a></li>
                }
            </ul>
        </nav>
    }
</div>
