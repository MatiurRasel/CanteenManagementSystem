@*
    /sysadmin/dashboard — cross-tenant platform overview.
*@
@using CanteenManagementSystem.Application.Sysadmin
@using CanteenManagementSystem.Presentation.Models
@model PlatformDashboardSnapshot
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["PlatformDashboard.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["PlatformDashboard.Index.Title"].Value,
        Subtitle = L["PlatformDashboard.Index.Subtitle", DateTime.UtcNow.ToString("dddd, dd MMM yyyy")].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/tenants'><i class='bx bx-buildings me-1'></i> {L["TenantsAdmin.New.AllTenants"].Value}</a>")
    };

    var kpiTenants = new UiKpiOptions
    {
        Label = L["Tenants"].Value,
        Value = Model.TotalTenants.ToString("N0"),
        Hint  = L["PlatformDashboard.Index.TenantsHint", Model.ActiveTenants, Model.SuspendedTenants, Model.DeletedTenants].Value,
        Icon  = "bx bx-buildings"
    };
    var kpiOrders = new UiKpiOptions
    {
        Label = L["AdminDashboard.Index.OrdersToday"].Value,
        Value = Model.OrdersToday.ToString("N0"),
        Hint  = L["PlatformDashboard.Index.AcrossEveryTenant"].Value,
        Icon  = "bx bx-cart"
    };
    var kpiRevenue = new UiKpiOptions
    {
        Label = L["AdminDashboard.Index.RevenueToday"].Value,
        Value = "৳ " + Model.RevenueToday.ToString("N0"),
        Hint  = L["PlatformDashboard.Index.RevenueHint"].Value,
        Icon  = "bx bx-coin-stack",
        Trend = Model.RevenueToday > 0 ? UiKpiTrend.Up : UiKpiTrend.None
    };
    var kpiFailures = new UiKpiOptions
    {
        Label = L["PlatformDashboard.Index.SyncFailures"].Value,
        Value = Model.FailedSyncsLast24h.ToString(),
        Hint  = Model.FailedSyncsLast24h == 0 ? L["PlatformDashboard.Index.AllGreen"].Value : L["PlatformDashboard.Index.DirectoryPullIssues"].Value,
        Icon  = "bx bx-error",
        Trend = Model.FailedSyncsLast24h > 0 ? UiKpiTrend.Down : UiKpiTrend.None
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiTenants"  /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiOrders"   /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiRevenue"  /></div>
        <div class="col-6 col-md-3"><partial name="_UiKpi" model="kpiFailures" /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="ui-card">
                <div class="ui-card-header">
                    <div>
                        <div class="ui-card-title">@L["PlatformDashboard.Index.RecentTenants"]</div>
                        <div class="ui-card-muted-body">@L["PlatformDashboard.Index.RecentTenantsSubtitle"]</div>
                    </div>
                </div>
                <div class="ui-table-wrap">
                    <table class="table table-hover mb-0 ui-table">
                        <thead>
                            <tr>
                                <th>@L["TenantsAdmin.Index.ColCode"]</th>
                                <th>@L["PlatformDashboard.Index.Tenant"]</th>
                                <th>@L["Common.Status"]</th>
                                <th class="text-end">@L["ReportsAdmin.Index.KpiOrders"]</th>
                                <th class="text-end">@L["StatsRevenue"]</th>
                                <th class="text-end">@L["TenantsAdmin.Index.ColCreated"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var t in Model.RecentTenants)
                        {
                            var b = new UiBadgeOptions
                            {
                                Text    = t.IsDeleted ? L["PlatformDashboard.Index.Deleted"].Value : (t.IsActive ? L["Common.Active"].Value : L["PlatformDashboard.Index.Suspended"].Value),
                                Variant = t.IsDeleted ? UiBadgeVariant.Secondary
                                        : t.IsActive  ? UiBadgeVariant.Success
                                                      : UiBadgeVariant.Warning,
                                WithDot = true
                            };
                            <tr>
                                <td><code class="small">@t.ClientCode</code></td>
                                <td class="ui-text-strong">@t.ClientName</td>
                                <td><partial name="_UiBadge" model="b" /></td>
                                <td class="text-end ui-tabular">@t.OrdersToday.ToString("N0")</td>
                                <td class="text-end ui-tabular">৳ @t.RevenueToday.ToString("N0")</td>
                                <td class="text-end ui-muted small">@t.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                        @if (Model.RecentTenants.Count == 0)
                        {
                            <tr><td colspan="6" class="ui-muted text-center py-4">@L["PlatformDashboard.Index.NoTenantsYet"] <a href="/admin/tenants/new">/admin/tenants/new</a>.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="ui-card">
                <div class="ui-card-header">
                    <div class="ui-card-title">@L["PlatformDashboard.Index.TopTenantsMtd"]</div>
                    <span class="ui-badge variant-primary">@Model.TopTenantsMtd.Count</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var t in Model.TopTenantsMtd)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center" style="background:transparent">
                            <div class="min-w-0">
                                <div class="ui-text-strong small text-truncate">@t.ClientName</div>
                                <div class="ui-muted small">@L["PlatformDashboard.Index.OrderCount", t.OrdersMtd]</div>
                            </div>
                            <span class="ui-badge variant-success">৳ @t.RevenueMtd.ToString("N0")</span>
                        </li>
                    }
                    @if (Model.TopTenantsMtd.Count == 0)
                    {
                        <li class="list-group-item ui-muted text-center" style="background:transparent">@L["PlatformDashboard.Index.NoOrdersThisMonth"]</li>
                    }
                </ul>
            </div>

            @if (Model.LowStockTenants > 0)
            {
                var lowAlert = new UiAlertOptions
                {
                    Variant = UiAlertVariant.Warning,
                    Heading = L["PlatformDashboard.Index.LowStockHeading", Model.LowStockTenants].Value,
                    Body    = L["PlatformDashboard.Index.LowStockBody"].Value
                };
                <div class="mt-3">
                    <partial name="_UiAlert" model="lowAlert" />
                </div>
            }
        </div>
    </div>

    <div class="ui-card mt-4">
        <div class="ui-card-header">
            <div>
                <div class="ui-card-title">@L["PlatformDashboard.Index.SyncFailuresTitle"]</div>
                <div class="ui-card-muted-body">@L["PlatformDashboard.Index.SyncFailuresSubtitle"]</div>
            </div>
            <span class="ui-badge @(Model.FailedSyncsLast24h == 0 ? "variant-success" : "variant-danger")">@Model.FailedSyncsLast24h</span>
        </div>

        @if (Model.SyncFailures.Count == 0)
        {
            var ok = new UiAlertOptions
            {
                Variant = UiAlertVariant.Success,
                Body    = L["PlatformDashboard.Index.AllSyncsOk"].Value
            };
            <div class="ui-card-body">
                <partial name="_UiAlert" model="ok" />
            </div>
        }
        else
        {
            <div class="ui-table-wrap">
                <table class="table mb-0 ui-table">
                    <thead>
                        <tr>
                            <th>@L["PlatformDashboard.Index.WhenUtc"]</th>
                            <th>@L["PlatformDashboard.Index.Tenant"]</th>
                            <th>@L["DirectoryAdminUi.Source"]</th>
                            <th class="text-end">@L["PlatformDashboard.Index.RecentFailures"]</th>
                            <th>@L["Common.Error"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var f in Model.SyncFailures)
                    {
                        <tr>
                            <td class="ui-mono small">@f.FailedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <div class="ui-text-strong">@f.ClientName</div>
                                <div class="ui-muted small"><code>@f.ClientCode</code></div>
                            </td>
                            <td><code class="small">@f.Source</code></td>
                            <td class="text-end ui-tabular">@f.ConsecutiveFailures</td>
                            <td class="text-danger small text-truncate" style="max-width:480px" title="@f.ErrorMessage">@(f.ErrorMessage ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
