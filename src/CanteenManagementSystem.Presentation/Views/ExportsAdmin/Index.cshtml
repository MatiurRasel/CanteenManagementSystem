@*
    /admin/exports — tenant-scoped CSV exports for finance / audit.
*@
@using CanteenManagementSystem.Presentation.Models
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ExportsAdmin.Index.Title"].Value;
    var today = DateTime.UtcNow.Date;
    var defaultFrom = today.AddDays(-6).ToString("yyyy-MM-dd");
    var defaultTo   = today.ToString("yyyy-MM-dd");
    var header = new UiPageHeaderOptions
    {
        Title    = L["ExportsAdmin.Index.Title"].Value,
        Subtitle = L["ExportsAdmin.Index.Subtitle"].Value
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <div class="row g-3">
        <div class="col-lg-6">
            <form method="get" asp-action="Orders" class="ui-card">
                <div class="ui-card-header">
                    <div>
                        <div class="ui-card-title"><i class="bx bx-cart me-2" style="color:var(--accent)"></i>@L["ExportsAdmin.Index.OrdersCsv"]</div>
                        <div class="ui-card-muted-body">@L["ExportsAdmin.Index.OrdersDescription"]</div>
                    </div>
                </div>
                <div class="ui-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="ui-label">@L["Common.From"]</label>
                            <input type="date" name="from" value="@defaultFrom" class="ui-input form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="ui-label">@L["Common.To"]</label>
                            <input type="date" name="to" value="@defaultTo" class="ui-input form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="ui-label">@L["ExportsAdmin.Index.StatusOptional"]</label>
                            <select name="status" class="form-select ui-select">
                                <option value="">@L["ExportsAdmin.Index.AllStatuses"]</option>
                                @foreach (var s in Enum.GetValues<CanteenManagementSystem.Domain.Enums.CanteenOrderStatus>())
                                {
                                    <option value="@((int)s)">@s</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="ui-card-footer">
                    <button class="btn btn-primary" type="submit">
                        <i class="bx bx-download me-1"></i> @L["ExportsAdmin.Index.DownloadOrdersCsv"]
                    </button>
                </div>
            </form>
        </div>

        <div class="col-lg-6">
            <form method="get" asp-action="Wallet" class="ui-card">
                <div class="ui-card-header">
                    <div>
                        <div class="ui-card-title"><i class="bx bx-wallet me-2" style="color:var(--accent)"></i>@L["ExportsAdmin.Index.WalletCsv"]</div>
                        <div class="ui-card-muted-body">@L["ExportsAdmin.Index.WalletDescription"]</div>
                    </div>
                </div>
                <div class="ui-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="ui-label">@L["Common.From"]</label>
                            <input type="date" name="from" value="@defaultFrom" class="ui-input form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="ui-label">@L["Common.To"]</label>
                            <input type="date" name="to" value="@defaultTo" class="ui-input form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="ui-label">@L["ExportsAdmin.Index.UserIdOptional"]</label>
                            <input type="text" name="userId" placeholder="STD-2026-001" class="ui-input form-control" />
                        </div>
                    </div>
                </div>
                <div class="ui-card-footer">
                    <button class="btn btn-primary" type="submit">
                        <i class="bx bx-download me-1"></i> @L["ExportsAdmin.Index.DownloadWalletCsv"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    @{
        var tip = new UiAlertOptions
        {
            Variant = UiAlertVariant.Info,
            Body    = L["ExportsAdmin.Index.RowCapNote"].Value
        };
    }
    <div class="mt-4">
        <partial name="_UiAlert" model="tip" />
    </div>
</div>
