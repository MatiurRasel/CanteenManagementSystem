@*
    /Home/Privacy — placeholder privacy policy. Replace with real legal copy
    before production. Rendered on the standard layout so it picks up branding.
*@
@using CanteenManagementSystem.Presentation.Models
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Home.Privacy.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["Home.Privacy.Title"].Value,
        Subtitle = L["Home.Privacy.Subtitle"].Value
    };
}

<div class="container py-4" style="max-width:820px">
    <partial name="_UiPageHeader" model="header" />

    <div class="ui-card">
        <div class="ui-card-body ui-stack">
            <section>
                <h6 class="ui-text-strong">@L["Home.Privacy.WhatWeCollect"]</h6>
                <p class="ui-muted small mb-0">@L["Home.Privacy.WhatWeCollectBody"]</p>
            </section>
            <section>
                <h6 class="ui-text-strong">@L["Home.Privacy.HowWeUseIt"]</h6>
                <p class="ui-muted small mb-0">@L["Home.Privacy.HowWeUseItBody"]</p>
            </section>
            <section>
                <h6 class="ui-text-strong">@L["Home.Privacy.Retention"]</h6>
                <p class="ui-muted small mb-0">@L["Home.Privacy.RetentionBody"]</p>
            </section>
            <section>
                <h6 class="ui-text-strong">@L["Home.Privacy.YourRights"]</h6>
                <p class="ui-muted small mb-0">@L["Home.Privacy.YourRightsBody"]</p>
            </section>
        </div>
    </div>
</div>
