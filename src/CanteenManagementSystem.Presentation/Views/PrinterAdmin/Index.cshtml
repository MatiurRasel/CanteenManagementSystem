@*
    /admin/printer — TCP/ESC-POS receipt printer config + test buttons.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.PrinterAdminController.PrinterForm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["PrinterAdmin.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["PrinterAdmin.Index.Title"].Value,
        Subtitle = L["PrinterAdmin.Index.Subtitle"].Value
    };
    var hasConfig = !string.IsNullOrWhiteSpace(Model.Host);
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (!hasConfig)
    {
        var alert = new UiAlertOptions
        {
            Variant = UiAlertVariant.Info,
            Heading = L["PrinterAdmin.Alert.NotConfigured.Title"].Value,
            Body    = L["PrinterAdmin.Alert.NotConfigured.Body"].Value
        };
        <partial name="_UiAlert" model="alert" />
        <div style="height:1rem"></div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <form method="post" class="ui-card" data-cl-form>
                @Html.AntiForgeryToken()
                <div class="ui-card-header"><div class="ui-card-title">@L["PrinterAdmin.Config.Title"]</div></div>
                <div class="ui-card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label class="ui-label">@L["PrinterAdmin.Config.Host"]</label>
                            <input class="ui-input form-control ui-mono" name="Host" value="@Model.Host" placeholder="192.168.1.45" />
                            <div class="ui-help-text">@L["PrinterAdmin.Config.HostHelp"]</div>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="ui-label">@L["PrinterAdmin.Config.Port"]</label>
                            <input class="ui-input form-control" type="number" min="1" max="65535" name="Port" value="@Model.Port" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="ui-label">@L["PrinterAdmin.Config.Timeout"]</label>
                            <input class="ui-input form-control" type="number" min="500" max="60000" name="TimeoutMs" value="@Model.TimeoutMs" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="ui-label">@L["PrinterAdmin.Config.LineWidth"]</label>
                            <select name="LineWidth" class="form-select ui-select">
                                <option value="32" selected="@(Model.LineWidth == 32)">@L["PrinterAdmin.Config.Width32"]</option>
                                <option value="48" selected="@(Model.LineWidth == 48)">@L["PrinterAdmin.Config.Width48"]</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="ui-card-footer">
                    <div class="ui-row-between">
                        <span class="ui-muted" style="font-size:13px">@L["PrinterAdmin.Config.ApplyNote"]</span>
                        <button class="btn btn-primary" type="submit"><i class="bx bx-save me-1"></i> @L["Common.Save"]</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-12 col-lg-5">
            <div class="ui-stack">
                <div class="ui-card">
                    <div class="ui-card-header"><div class="ui-card-title">@L["PrinterAdmin.Test.Title"]</div></div>
                    <div class="ui-card-body">
                        <p class="ui-muted" style="font-size:13px">@L["PrinterAdmin.Test.Description"]</p>
                        <form method="post" action="/admin/printer/test" data-cl-form>
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-primary w-100" type="submit">
                                <i class="bx bx-send me-1"></i> @L["PrinterAdmin.Test.Submit"]
                            </button>
                        </form>
                    </div>
                </div>

                <div class="ui-card">
                    <div class="ui-card-header"><div class="ui-card-title">@L["PrinterAdmin.Drawer.Title"]</div></div>
                    <div class="ui-card-body">
                        <p class="ui-muted" style="font-size:13px">@L["PrinterAdmin.Drawer.Description"]</p>
                        <form method="post" action="/admin/printer/kick-drawer" data-cl-form>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reason" value="Manual test from admin" />
                            <button class="btn btn-outline-secondary w-100" type="submit">
                                <i class="bx bx-store-alt me-1"></i> @L["PrinterAdmin.Drawer.Submit"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
