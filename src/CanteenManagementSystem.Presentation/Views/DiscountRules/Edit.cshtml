@*
    /admin/discount-rules/{id} — single-rule editor.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.DiscountRulesController.RuleForm
@inject IStringLocalizer<SharedResource> L
@{
    var isNew = Model.RuleId == 0;
    ViewData["Title"] = isNew ? L["DiscountRules.Edit.NewTitle"].Value : Model.DisplayName;
    var header = new UiPageHeaderOptions
    {
        Title    = isNew ? L["DiscountRules.Edit.NewRuleHeading"].Value : Model.DisplayName,
        Subtitle = isNew ? L["DiscountRules.Edit.NewSubtitle"].Value : L["DiscountRules.Edit.EditSubtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-outline-secondary btn-sm' href='/admin/discount-rules'><i class='bx bx-arrow-back me-1'></i> {L["DiscountRules.Edit.AllRules"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    <form method="post" asp-action="Save">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RuleId" />

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="ui-card">
                    <div class="ui-card-header"><div class="ui-card-title">@L["DiscountRules.Edit.IdentityTitle"]</div></div>
                    <div class="ui-card-body">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="ui-label" asp-for="RuleCode">@L["DiscountRules.Edit.CodeLabel"]</label>
                                <input asp-for="RuleCode" class="ui-input form-control" placeholder="tuesday-teacher" autocomplete="off" />
                            </div>
                            <div class="col-md-7">
                                <label class="ui-label" asp-for="DisplayName">@L["DiscountRules.Edit.DisplayNameLabel"]</label>
                                <input asp-for="DisplayName" class="ui-input form-control" placeholder="@L["DiscountRules.Edit.DisplayNamePlaceholder"]" />
                            </div>
                            <div class="col-12">
                                <label class="ui-label" asp-for="Description">@L["Common.Description"]</label>
                                <input asp-for="Description" class="ui-input form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="ui-label" asp-for="Priority">@L["DiscountRules.Edit.PriorityLabel"]</label>
                                <input asp-for="Priority" type="number" class="ui-input form-control" />
                                <div class="ui-help-text">@L["DiscountRules.Edit.PriorityHint"]</div>
                            </div>
                            <div class="col-md-4">
                                <label class="ui-label" asp-for="ValidFromUtc">@L["DiscountRules.Edit.ValidFromLabel"]</label>
                                <input asp-for="ValidFromUtc" type="date" class="ui-input form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="ui-label" asp-for="ValidUntilUtc">@L["DiscountRules.Edit.ValidUntilLabel"]</label>
                                <input asp-for="ValidUntilUtc" type="date" class="ui-input form-control" />
                            </div>
                            <div class="col-md-1 d-flex align-items-center">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                    <label class="form-check-label small" asp-for="IsActive">@L["Common.Active"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ui-card mt-3">
                    <div class="ui-card-header"><div class="ui-card-title">@L["DiscountRules.Edit.ConditionTitle"]</div></div>
                    <div class="ui-card-body">
                        <select asp-for="ConditionTemplate" class="form-select ui-select mb-3" id="conditionTpl">
                            <option value="DayOfWeekRole">@L["DiscountRules.Edit.CondDayRole"]</option>
                            <option value="ComboItems">@L["DiscountRules.Edit.CondCombo"]</option>
                            <option value="Raw">@L["DiscountRules.Edit.RawJson"]</option>
                        </select>
                        <div data-cond="DayOfWeekRole" class="row g-3">
                            <div class="col-md-4">
                                <label class="ui-label">@L["DiscountRules.Edit.DayOfWeekLabel"]</label>
                                <select asp-for="Day" class="form-select ui-select">
                                    @foreach (var d in Enum.GetValues<DayOfWeek>())
                                    {
                                        <option value="@d">@System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetDayName(d)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="ui-label">@L["DiscountRules.Edit.RolesLabel"]</label>
                                <input asp-for="Roles" class="ui-input form-control" placeholder="TEACHER, STAFF" />
                                <div class="ui-help-text">@L["DiscountRules.Edit.RolesHint"]</div>
                            </div>
                        </div>
                        <div data-cond="ComboItems">
                            <label class="ui-label">@L["DiscountRules.Edit.ComboIdsLabel"]</label>
                            <input asp-for="ComboFoodItemIds" class="ui-input form-control" placeholder="12, 15, 18" />
                        </div>
                        <div data-cond="Raw">
                            <label class="ui-label">@L["DiscountRules.Edit.ConditionJsonLabel"]</label>
                            <textarea asp-for="ConditionJson" class="ui-input form-control ui-mono" rows="3">@Model.ConditionJson</textarea>
                        </div>
                    </div>
                </div>

                <div class="ui-card mt-3">
                    <div class="ui-card-header"><div class="ui-card-title">@L["DiscountRules.Edit.EffectTitle"]</div></div>
                    <div class="ui-card-body">
                        <select asp-for="EffectTemplate" class="form-select ui-select mb-3" id="effectTpl">
                            <option value="Percent">@L["DiscountRules.Edit.EffPercent"]</option>
                            <option value="Flat">@L["DiscountRules.Edit.EffFlat"]</option>
                            <option value="Raw">@L["DiscountRules.Edit.RawJson"]</option>
                        </select>
                        <div data-eff="Percent" class="row g-3">
                            <div class="col-md-4">
                                <label class="ui-label">@L["DiscountRules.Edit.PercentAmountLabel"]</label>
                                <div class="input-group">
                                    <input asp-for="EffectAmount" type="number" step="0.01" min="0" max="100" class="ui-input form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                        <div data-eff="Flat" class="row g-3">
                            <div class="col-md-4">
                                <label class="ui-label">@L["DiscountRules.Edit.FlatAmountLabel"]</label>
                                <input asp-for="EffectAmount" type="number" step="0.01" min="0" class="ui-input form-control" />
                            </div>
                        </div>
                        <div data-eff="Raw">
                            <label class="ui-label">@L["DiscountRules.Edit.EffectJsonLabel"]</label>
                            <textarea asp-for="EffectJson" class="ui-input form-control ui-mono" rows="3">@Model.EffectJson</textarea>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> @L["Common.Save"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@L["Common.Cancel"]</a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ui-card sticky-top" style="top:5rem">
                    <div class="ui-card-header"><div class="ui-card-title">@L["DiscountRules.Edit.HowTitle"]</div></div>
                    <div class="ui-card-body">
                        <ul class="small ui-stack-sm mb-3" style="padding-left:1.2rem">
                            <li>@L["DiscountRules.Edit.HowItem1"]</li>
                            <li>@L["DiscountRules.Edit.HowItem2"]</li>
                            <li>@L["DiscountRules.Edit.HowItem3"]</li>
                            <li>@L["DiscountRules.Edit.HowItem4"]</li>
                        </ul>
                        <p class="ui-muted small mb-0">
                            @L["DiscountRules.Edit.HowFooterPrefix"]
                            <code>DiscountEngine</code> @L["DiscountRules.Edit.HowFooterSuffix"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            function applyVis(group, attr, current) {
                document.querySelectorAll(`[${attr}]`).forEach(el => {
                    el.style.display = el.getAttribute(attr) === current ? '' : 'none';
                });
            }
            const c = document.getElementById('conditionTpl');
            const e = document.getElementById('effectTpl');
            c.addEventListener('change', () => applyVis('Cond', 'data-cond', c.value));
            e.addEventListener('change', () => applyVis('Effect', 'data-eff', e.value));
            applyVis('Cond', 'data-cond', c.value);
            applyVis('Effect', 'data-eff', e.value);
        })();
    </script>
}
