@*
    /admin/discount-rules — discount rule list.
*@
@using Platform.Domain.Pricing
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<DiscountRule>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DiscountRules.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["DiscountRules.Index.Title"].Value,
        Subtitle = L["DiscountRules.Index.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-primary' href='/admin/discount-rules/new'><i class='bx bx-plus me-1'></i> {L["DiscountRules.Index.AddRule"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var empty = new EmptyStateOptions
        {
            Icon = "bx-purchase-tag-alt",
            Title = L["DiscountRules.Index.EmptyTitle"].Value,
            Description = L["DiscountRules.Index.EmptyDescription"].Value
        };
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["DiscountRules.Index.ColCode"]</th>
                        <th>@L["DiscountRules.Index.ColDisplayName"]</th>
                        <th class="text-end">@L["DiscountRules.Index.ColPriority"]</th>
                        <th>@L["DiscountRules.Index.ColValidWindow"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end" style="width:1%">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    var b = new UiBadgeOptions
                    {
                        Text = r.IsActive ? L["Common.Active"].Value : L["Common.Disabled"].Value,
                        Variant = r.IsActive ? UiBadgeVariant.Success : UiBadgeVariant.Secondary,
                        WithDot = true
                    };
                    <tr>
                        <td class="ui-mono ui-text-strong">@r.RuleCode</td>
                        <td>@r.DisplayName</td>
                        <td class="text-end ui-tabular">@r.Priority</td>
                        <td class="ui-muted ui-tabular" style="font-size:12px">
                            @(r.ValidFromUtc?.ToString("yyyy-MM-dd") ?? "—") → @(r.ValidUntilUtc?.ToString("yyyy-MM-dd") ?? "—")
                        </td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" href="/admin/discount-rules/@r.RuleId">
                                <i class="bx bx-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
