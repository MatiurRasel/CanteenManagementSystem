@*
    /admin/combos — counter quick-button list + create CTA.
*@
@using CanteenManagementSystem.Application.Menus
@using CanteenManagementSystem.Presentation.Models
@model IReadOnlyList<ComboButtonListItem>
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CombosAdmin.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["CombosAdmin.Index.Heading"].Value,
        Subtitle = L["CombosAdmin.Index.Subtitle"].Value,
        Actions  = Html.Raw($"<a class='btn btn-sm btn-primary' href='/admin/combos/edit'><i class='bx bx-plus me-1'></i> {L["CombosAdmin.Index.AddCombo"].Value}</a>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.Count == 0)
    {
        var emptyOpts = new EmptyStateOptions
        {
            Icon  = "bx-layer",
            Title = L["CombosAdmin.Index.EmptyTitle"].Value,
            Description = L["CombosAdmin.Index.EmptyDescription"].Value,
            CtaLabel = L["CombosAdmin.Index.EmptyCta"].Value,
            CtaUrl   = "/admin/combos/edit",
            CtaIcon  = "bx-plus"
        };
        <partial name="_EmptyState" model="emptyOpts" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th style="width:1%">@L["CombosAdmin.Index.ColColor"]</th>
                        <th>@L["CombosAdmin.Index.ColCode"]</th>
                        <th>@L["Common.Name"]</th>
                        <th class="text-end">@L["Common.Items"]</th>
                        <th class="text-end">@L["CombosAdmin.Index.ColOrder"]</th>
                        <th>@L["Common.Status"]</th>
                        <th class="text-end" style="width:1%">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    var color = string.IsNullOrEmpty(c.Color) ? "var(--accent)" : c.Color;
                    var statusBadge = new UiBadgeOptions
                    {
                        Text    = c.IsActive ? L["Common.Active"].Value : L["Common.Disabled"].Value,
                        Variant = c.IsActive ? UiBadgeVariant.Success : UiBadgeVariant.Secondary,
                        WithDot = true
                    };
                    <tr>
                        <td><span style="display:inline-block;width:18px;height:18px;border-radius:var(--rad-sm);background:@color"></span></td>
                        <td class="ui-mono ui-text-strong">@c.Code</td>
                        <td>@c.DisplayName</td>
                        <td class="text-end ui-tabular">@c.ItemCount</td>
                        <td class="text-end ui-tabular ui-muted">@c.SortOrder</td>
                        <td><partial name="_UiBadge" model="statusBadge" /></td>
                        <td class="text-end">
                            <div class="ui-row" style="gap: .25rem; justify-content:flex-end">
                                <a class="btn btn-ghost btn-sm" href="/admin/combos/edit/@c.ComboButtonId" title="@L["Common.Edit"]">
                                    <i class="bx bx-edit"></i>
                                </a>
                                <form method="post" action="/admin/combos/delete/@c.ComboButtonId" class="d-inline"
                                      data-cl-confirm="@L["CombosAdmin.Index.ConfirmDelete", c.Code]" data-cl-confirm-variant="warning">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-ghost btn-sm" type="submit" title="@L["Common.Delete"]">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
