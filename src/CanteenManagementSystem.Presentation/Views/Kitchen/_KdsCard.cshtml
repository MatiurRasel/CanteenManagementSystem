@using CanteenManagementSystem.Application.Orders.Dtos
@using CanteenManagementSystem.Domain.Enums
@model OperatorOrderViewModel

<div class="ks-kds-card" data-order-id="@Model.OrderID" data-placed="@Model.OrderDateTime.ToString("o")">
    <div class="ks-kds-head">
        <div class="ks-kds-no">#@Model.OrderNumber</div>
        <div class="ks-kds-age">00:00</div>
    </div>
    <div class="ks-kds-user">
        <i class="bx bx-user me-1"></i>@Model.UserName
        @if (!string.IsNullOrEmpty(Model.AcademicInformation))
        {
            <small class="opacity-75 d-block">@Model.AcademicInformation</small>
        }
    </div>
    <ul class="ks-kds-items">
        @foreach (var i in Model.Items)
        {
            <li><span>@i.ItemName</span><span class="ui-muted">× @i.Quantity</span></li>
        }
    </ul>
    <div class="ks-kds-actions">
        @if (Model.Status == CanteenOrderStatus.Pending || Model.Status == CanteenOrderStatus.Placed || Model.Status == CanteenOrderStatus.Confirmed)
        {
            <button class="btn btn-sm btn-primary" data-status="30"><i class="bx bx-flame me-1"></i> Start</button>
        }
        @if (Model.Status != CanteenOrderStatus.Ready && Model.Status != CanteenOrderStatus.Delivered)
        {
            <button class="btn btn-sm btn-success" data-status="40"><i class="bx bx-bell me-1"></i> Ready</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-light" data-status="1"><i class="bx bx-check me-1"></i> Delivered</button>
        }
    </div>
</div>
