@*
    /admin/kiosks — paired self-service tablets.
*@
@using CanteenManagementSystem.Presentation.Models
@model CanteenManagementSystem.Presentation.Controllers.KiosksAdminController.IndexVm
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["KiosksAdmin.Index.Title"].Value;
    var header = new UiPageHeaderOptions
    {
        Title    = L["KiosksAdmin.Index.Title"].Value,
        Subtitle = L["KiosksAdmin.Index.Subtitle"].Value,
        Actions  = Html.Raw($"<button class='btn btn-primary btn-sm' data-bs-toggle='modal' data-bs-target='#issueModal'><i class='bx bx-plus me-1'></i> {L["KiosksAdmin.Index.PairNew"].Value}</button>")
    };
}

<div class="container-fluid py-4">
    <partial name="_UiPageHeader" model="header" />

    @if (Model.JustIssued is not null)
    {
        <div class="ui-card mb-4" style="border-color:var(--success)">
            <div class="ui-card-header">
                <div>
                    <div class="ui-card-title">
                        <i class="bx bx-check-circle me-1" style="color:var(--success)"></i>
                        @L["KiosksAdmin.Index.Paired.Title", Model.JustIssued.Name]
                    </div>
                    <div class="ui-card-muted-body">@L["KiosksAdmin.Index.Paired.OpenOnce"]</div>
                </div>
            </div>
            <div class="ui-card-body">
                <div class="input-group mb-3">
                    <input type="text" id="pairUrl" class="ui-input form-control ui-mono small" value="@Model.JustIssued.PairUrl" readonly />
                    <button class="btn btn-outline-primary" type="button"
                            onclick="navigator.clipboard.writeText(document.getElementById('pairUrl').value);this.innerText='@L["KiosksAdmin.Index.Copied"]';setTimeout(()=>this.innerHTML='<i class=\'bx bx-copy me-1\'></i>@L["Common.Copy"]',1500)">
                        <i class="bx bx-copy me-1"></i>@L["Common.Copy"]
                    </button>
                </div>
                <div class="ui-muted small mb-2">@L["KiosksAdmin.Index.ScanQr"]</div>
                <img alt="@L["KiosksAdmin.Index.PairQrAlt"]" loading="lazy"
                     src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=@Uri.EscapeDataString(Model.JustIssued.PairUrl)"
                     style="border-radius:var(--rad);border:1px solid var(--border);padding:.5rem;background:#fff" />
                <div class="ui-muted small mt-2">@L["KiosksAdmin.Index.RawToken"] <code>@Model.JustIssued.RawToken</code></div>
            </div>
        </div>
    }

    @if (Model.Devices.Count == 0)
    {
        var emptyOpts = new EmptyStateOptions
        {
            Icon        = "bx-tab",
            Title       = L["KiosksAdmin.Index.Empty.Title"].Value,
            Description = L["KiosksAdmin.Index.Empty.Description"].Value,
            CtaLabel    = L["KiosksAdmin.Index.PairNew"].Value,
            CtaIcon     = "bx-plus",
            CtaUrl      = "#issueModal"
        };
        <partial name="_EmptyState" model="emptyOpts" />
    }
    else
    {
        <div class="ui-table-wrap">
            <table class="table table-hover mb-0 ui-table">
                <thead>
                    <tr>
                        <th>@L["Common.Name"]</th>
                        <th>@L["KiosksAdmin.Index.Token"]</th>
                        <th>@L["Common.Status"]</th>
                        <th>@L["CardsAdmin.Issued"]</th>
                        <th>@L["KiosksAdmin.Index.LastSeen"]</th>
                        <th class="text-end">@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Devices)
                {
                    var b = new UiBadgeOptions
                    {
                        Text    = d.IsActive ? L["Common.Active"].Value : L["KiosksAdmin.Index.Revoked"].Value,
                        Variant = d.IsActive ? UiBadgeVariant.Success : UiBadgeVariant.Secondary,
                        WithDot = true
                    };
                    <tr>
                        <td class="ui-text-strong">@d.Name</td>
                        <td class="ui-mono small ui-muted">@d.TokenPrefix… <span class="small">@L["KiosksAdmin.Index.Hidden"]</span></td>
                        <td><partial name="_UiBadge" model="b" /></td>
                        <td class="small">@d.IssuedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (d.LastSeenAtUtc is null)
                            {
                                <span class="small ui-muted">@L["KiosksAdmin.Index.Never"]</span>
                            }
                            else
                            {
                                <span class="small">@d.LastSeenAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") <span class="ui-muted">(@d.LastSeenIp)</span></span>
                            }
                        </td>
                        <td class="text-end">
                            @if (d.IsActive)
                            {
                                <form asp-action="Revoke" asp-route-id="@d.KioskDeviceId" method="post" class="d-inline"
                                      data-cl-confirm="@L["KiosksAdmin.Index.ConfirmRevoke"]" data-cl-confirm-variant="warning">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger"><i class="bx bx-block me-1"></i>@L["KiosksAdmin.Index.Revoke"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="issueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-action="Issue">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title"><i class="bx bx-tab me-2" style="color:var(--accent)"></i>@L["KiosksAdmin.Modal.Title"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body">
                <p class="ui-muted small">@L["KiosksAdmin.Modal.Help"]</p>
                <label class="ui-label">@L["KiosksAdmin.Modal.Name"]</label>
                <input name="Name" class="ui-input form-control" placeholder="@L["KiosksAdmin.Modal.NamePlaceholder"]" required maxlength="120" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                <button type="submit" class="btn btn-primary"><i class="bx bx-key me-1"></i>@L["KiosksAdmin.Modal.Submit"]</button>
            </div>
        </form>
    </div>
</div>
