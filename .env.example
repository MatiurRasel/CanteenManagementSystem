# Copy to .env and fill in. docker-compose reads this file automatically.

# -------- Auth signing key (REQUIRED) ---------------------------------------
# A random 48+ byte string. Generate with one of:
#   openssl rand -base64 48
#   pwsh -c "[Convert]::ToBase64String((1..48|%{[byte](Get-Random -Max 256)}))"
AUTH_SIGNING_KEY=

# -------- SQL Server --------------------------------------------------------
SQL_SA_PASSWORD=Change@MeNow!42
SQL_DB=canteen_saas
SQL_PORT=1433

# -------- Redis -------------------------------------------------------------
REDIS_PORT=6379

# -------- App ---------------------------------------------------------------
APP_PORT=8080
SEED_DEFAULT_USER_PASSWORD=Change@123
