    },
    {
        "en":  "How SmartCanteen handles personal data.",
        "k":  "Home.Privacy.Subtitle"
    },
    {
        "en":  "What we collect",
        "k":  "Home.Privacy.WhatWeCollect"
    },
    {
        "en":  "User profile (name, email, role), card UID, order history, wallet transactions, device pairing tokens, and webhook delivery logs. Sensitive credentials (passwords, gateway secrets) are hashed or encrypted at rest and never returned to the browser.",
        "k":  "Home.Privacy.WhatWeCollectBody"
    },
    {
        "en":  "How we use it",
        "k":  "Home.Privacy.HowWeUseIt"
    },
    {
        "en":  "Strictly to operate this canteen — process orders, settle wallet balances, deliver SMS / email notifications, run reports, and audit transactions. Data is segregated per tenant; one tenant cannot see another tenant\u0027s data.",
        "k":  "Home.Privacy.HowWeUseItBody"
    },
    {
        "en":  "Retention",
        "k":  "Home.Privacy.Retention"
    },
    {
        "en":  "Transaction history is retained for the duration required by your local tax law (typically 5 years). Soft-deleted tenants are kept on a 30-day cooling-off window before a one-shot hard delete.",
        "k":  "Home.Privacy.RetentionBody"
    },
    {
        "en":  "Your rights",
        "k":  "Home.Privacy.YourRights"
    },
    {
        "en":  "Subject access, correction, and erasure requests should be addressed to your tenant administrator — they hold the data controller role for your canteen\u0027s deployment.",
        "k":  "Home.Privacy.YourRightsBody"
    },
