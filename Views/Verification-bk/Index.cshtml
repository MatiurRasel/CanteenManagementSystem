@{
    ViewData["Title"] = "ক্যান্টিন অর্ডার সিস্টেম";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700;800&display=swap');

        * {
            font-family: 'Noto+Sans Bengali', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            overflow: hidden;
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .scan-animation {
            animation: scan 2s ease-in-out infinite;
        }

        @@keyframes scan {
            0%, 100% { transform: translateY(-10px); opacity: 0.5; }
            50% { transform: translateY(10px); opacity: 1; }
        }

        .pulse-ring {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @@keyframes pulse-ring {
            0% { transform: scale(1); opacity: 1; }
            100% { transform: scale(1.5); opacity: 0; }
        }

        .slide-in-bottom {
            animation: slideInBottom 0.5s ease-out;
        }

        @@keyframes slideInBottom {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .fade-in {
            animation: fadeIn 0.3s ease-in;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        }

        .menu-item {
            transition: all 0.3s ease;
        }

        .menu-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15);
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px -5px rgba(102, 126, 234, 0.5);
        }

        .quantity-badge {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
    </style>
</head>
<body>
    <!-- VERIFICATION SCREEN -->
    <div id="verificationScreen" class="min-h-screen flex items-center justify-center p-8">
        <div class="glass-effect rounded-3xl p-12 max-w-2xl w-full text-center">
            <!-- Logo/Header -->
            <div class="mb-8">
                <div class="relative inline-block">
                    <div class="absolute inset-0 pulse-ring bg-purple-400 rounded-full"></div>
                    <div class="relative bg-gradient-to-br from-purple-500 to-pink-500 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-utensils text-4xl text-white"></i>
                    </div>
                </div>
                <h1 class="text-5xl font-bold text-gray-800 mb-3">ক্যান্টিন অর্ডার সিস্টেম</h1>
                <p class="text-xl text-gray-600">চট্টগ্রাম ক্যান্টনমেন্ট পাবলিক কলেজ</p>
            </div>

            <!-- Scan Icon -->
            <div class="my-12 scan-animation">
                <i class="fas fa-id-card text-8xl text-purple-400"></i>
            </div>

            <!-- Instructions -->
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">আপনার কার্ড স্ক্যান করুন</h2>
                <p class="text-lg text-gray-600">কার্ড স্ক্যানার, QR কোড, বারকোড বা NFC ব্যবহার করুন</p>
            </div>

            <!-- Input Field -->
            <div class="mb-8">
                <input type="text"
                       id="cardInput"
                       class="w-full px-8 py-6 text-3xl text-center border-4 border-gray-300 rounded-2xl focus:border-purple-500 transition"
                       placeholder="আপনার ID এখানে লিখুন..."
                       autofocus
                       autocomplete="off" />
            </div>

            <!-- Error Message -->
            <div id="errorMessage" class="hidden mb-6 bg-red-50 border-l-4 border-red-500 p-6 rounded-xl">
                <p class="text-red-700 font-semibold text-lg"></p>
            </div>

            <!-- Loading -->
            <div id="loadingSpinner" class="hidden">
                <div class="flex justify-center items-center">
                    <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-purple-500"></div>
                </div>
                <p class="text-gray-600 mt-4 text-lg">যাচাই করা হচ্ছে...</p>
            </div>

            <!-- Manual Entry Button -->
            <button onclick="document.getElementById('cardInput').focus()"
                    class="btn-primary text-white px-12 py-4 rounded-xl font-bold text-xl mt-6">
                <i class="fas fa-keyboard mr-3"></i>ম্যানুয়ালি ID লিখুন
            </button>
        </div>
    </div>

    <!-- ORDER SCREEN (Hidden Initially) -->
    <div id="orderScreen" class="hidden min-h-screen p-8">
        <div class="max-w-7xl mx-auto">
            <!-- Header with User Info -->
            <div class="glass-effect rounded-3xl p-8 mb-6 slide-in-bottom">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-6">
                        <div class="bg-gradient-to-br from-purple-500 to-pink-500 w-20 h-20 rounded-2xl flex items-center justify-center">
                            <i class="fas fa-user text-3xl text-white"></i>
                        </div>
                        <div>
                            <h2 class="text-3xl font-bold text-gray-800" id="userName">Loading...</h2>
                            <p class="text-lg text-gray-600" id="userInfo">Loading...</p>
                            <p class="text-sm text-gray-500 mt-1">
                                <span id="userType" class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full font-semibold"></span>
                            </p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-600 mb-2">ব্যালেন্স তথ্য</p>
                        <div class="grid grid-cols-3 gap-6">
                            <div class="text-center">
                                <p class="text-sm text-gray-600">মোট</p>
                                <p class="text-2xl font-bold text-gray-800">৳<span id="totalBalance">0</span></p>
                            </div>
                            <div class="text-center">
                                <p class="text-sm text-gray-600">ব্যবহৃত</p>
                                <p class="text-2xl font-bold text-orange-600">৳<span id="usedBalance">0</span></p>
                            </div>
                            <div class="text-center">
                                <p class="text-sm text-gray-600">উপলব্ধ</p>
                                <p class="text-3xl font-bold text-green-600">৳<span id="availableBalance">0</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-6">
                <!-- Menu Items -->
                <div class="col-span-2">
                    <div class="glass-effect rounded-3xl p-8 slide-in-bottom" style="animation-delay: 0.1s;">
                        <h3 class="text-3xl font-bold text-gray-800 mb-6">
                            <i class="fas fa-list text-purple-600 mr-3"></i>আজকের মেনু
                        </h3>
                        <div id="menuItems" class="grid grid-cols-2 gap-6 max-h-[600px] overflow-y-auto pr-4">
                            <!-- Menu items will be loaded here -->
                        </div>
                    </div>
                </div>

                <!-- Cart -->
                <div class="col-span-1">
                    <div class="glass-effect rounded-3xl p-8 sticky top-8 slide-in-bottom" style="animation-delay: 0.2s;">
                        <h3 class="text-3xl font-bold text-gray-800 mb-6">
                            <i class="fas fa-shopping-cart text-purple-600 mr-3"></i>আপনার অর্ডার
                        </h3>

                        <div id="cartItems" class="space-y-4 mb-6 min-h-[300px] max-h-[400px] overflow-y-auto">
                            <div class="text-center py-12 text-gray-400">
                                <i class="fas fa-shopping-basket text-6xl mb-4"></i>
                                <p class="text-lg">কোনো আইটেম নির্বাচিত নয়</p>
                            </div>
                        </div>

                        <div class="border-t-2 border-gray-200 pt-6 mb-6">
                            <div class="flex justify-between items-center text-2xl font-bold mb-4">
                                <span>সর্বমোট:</span>
                                <span class="text-purple-600">৳<span id="cartTotal">0</span></span>
                            </div>
                            <div class="text-sm text-gray-600">
                                <p>অবশিষ্ট থাকবে: ৳<span id="remainingAfterOrder">0</span></p>
                            </div>
                        </div>

                        <button onclick="placeOrder()"
                                id="placeOrderBtn"
                                disabled
                                class="w-full btn-primary text-white px-8 py-5 rounded-2xl font-bold text-xl disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none mb-4">
                            <i class="fas fa-check-circle mr-3"></i>অর্ডার নিশ্চিত করুন
                        </button>

                        <div class="flex gap-3">
                            <button onclick="clearCart()"
                                    class="flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-xl font-semibold hover:bg-gray-300 transition">
                                <i class="fas fa-trash-alt mr-2"></i>পরিষ্কার করুন
                            </button>
                            <button onclick="cancelOrder()"
                                    class="flex-1 bg-red-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-red-600 transition">
                                <i class="fas fa-times mr-2"></i>বাতিল করুন
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SUCCESS SCREEN -->
    <div id="successScreen" class="hidden min-h-screen flex items-center justify-center p-8">
        <div class="glass-effect rounded-3xl p-12 max-w-2xl w-full text-center fade-in">
            <div class="bg-green-100 w-32 h-32 rounded-full flex items-center justify-center mx-auto mb-8 animate-bounce">
                <i class="fas fa-check-circle text-7xl text-green-600"></i>
            </div>

            <h1 class="text-5xl font-bold text-gray-800 mb-4">অর্ডার সফল হয়েছে!</h1>
            <p class="text-xl text-gray-600 mb-8">আপনার খাবার প্রস্তুত করা হচ্ছে</p>

            <div class="bg-purple-50 rounded-2xl p-8 mb-8">
                <div class="grid grid-cols-2 gap-6 mb-6">
                    <div>
                        <p class="text-gray-600 mb-2">অর্ডার নম্বর</p>
                        <p class="text-3xl font-bold text-purple-600" id="successOrderNumber">---</p>
                    </div>
                    <div>
                        <p class="text-gray-600 mb-2">মোট পরিমাণ</p>
                        <p class="text-3xl font-bold text-purple-600">৳<span id="successAmount">0</span></p>
                    </div>
                </div>

                <div class="border-t-2 border-purple-200 pt-6">
                    <p class="text-gray-600 mb-3 font-semibold">অবশিষ্ট ব্যালেন্স</p>
                    <p class="text-4xl font-bold text-green-600">৳<span id="successRemainingBalance">0</span></p>
                </div>
            </div>

            <div class="text-gray-600 mb-8">
                <p class="text-lg">অনুগ্রহ করে অর্ডার নম্বরটি মনে রাখুন</p>
                <p class="mt-2">স্বয়ংক্রিয়ভাবে রিসেট হচ্ছে <span id="countdown" class="font-bold text-purple-600">10</span> সেকেন্ডে...</p>
            </div>

            <button onclick="resetToVerification()"
                    class="btn-primary text-white px-12 py-4 rounded-xl font-bold text-xl">
                <i class="fas fa-home mr-3"></i>প্রথম পৃষ্ঠায় ফিরে যান
            </button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        let currentUser = null;
        let cart = {};
        let menuData = [];
        let orderTimeout = null;

        // Initialize
        $(document).ready(function() {
            $('#cardInput').focus();

            // Auto-submit on Enter or after card scan
            $('#cardInput').on('keypress', function(e) {
                if (e.which === 13) {
                    verifyUser();
                }
            });

            // Auto-submit after 0.5s delay (for card scanners)
            $('#cardInput').on('input', function() {
                clearTimeout(window.cardScanTimeout);
                window.cardScanTimeout = setTimeout(() => {
                    if ($(this).val().length >= 3) {
                        verifyUser();
                    }
                }, 500);
            });
        });

        async function verifyUser() {
            const identifier = $('#cardInput').val().trim();

            if (!identifier) {
                showError('অনুগ্রহ করে আপনার কার্ড স্ক্যান করুন বা ID লিখুন');
                return;
            }

            hideError();
            $('#loadingSpinner').removeClass('hidden');
            $('#cardInput').prop('disabled', true);

            try {
                const response = await fetch('/Verification/VerifyUser', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier })
                });

                const data = await response.json();

                if (data.success) {
                    currentUser = data;
                    menuData = data.todayMenu;
                    showOrderScreen();
                } else {
                    showError(data.message);
                    $('#cardInput').val('').prop('disabled', false).focus();
                }
            } catch (error) {
                showError('সংযোগে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
                $('#cardInput').prop('disabled', false).focus();
            } finally {
                $('#loadingSpinner').addClass('hidden');
            }
        }

        function showOrderScreen() {
            $('#verificationScreen').addClass('hidden');
            $('#orderScreen').removeClass('hidden');

            // Populate user info
            $('#userName').text(currentUser.userName);
            $('#userInfo').text(currentUser.userType === 'STD' ? currentUser.className : currentUser.designation);
            $('#userType').text(currentUser.userType === 'STD' ? 'শিক্ষার্থী' : 'কর্মচারী');
            $('#totalBalance').text(currentUser.totalBalance.toFixed(2));
            $('#usedBalance').text(currentUser.usedBalance.toFixed(2));
            $('#availableBalance').text(currentUser.availableBalance.toFixed(2));

            // Populate menu
            displayMenu();

            // Start session timeout (5 minutes)
            startSessionTimeout();
        }

        function displayMenu() {
            const container = $('#menuItems');
            container.empty();

            if (menuData.length === 0) {
                container.html(`
                    <div class="col-span-2 text-center py-12 text-gray-400">
                        <i class="fas fa-utensils text-6xl mb-4"></i>
                        <p class="text-xl">আজকের জন্য কোনো মেনু নেই</p>
                    </div>
                `);
                return;
            }

            menuData.forEach(item => {
                const isOutOfStock = !item.inStock;
                container.append(`
                    <div class="menu-item bg-white rounded-2xl p-6 border-2 border-gray-200 ${isOutOfStock ? 'opacity-50' : ''}">
                        <div class="flex items-start justify-between mb-4">
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-800 mb-2">${item.itemName}</h4>
                                <p class="text-sm text-gray-600 mb-3">${item.description}</p>
                                <p class="text-xs text-gray-500">
                                    উপলব্ধ: ${item.availableQuantity} টি
                                </p>
                            </div>
                            <span class="text-4xl">🍽️</span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="text-2xl font-bold text-purple-600">৳${item.price}</span>

                            ${!isOutOfStock ? `
                                <div class="flex items-center gap-2">
                                    <button onclick="changeQuantity(${item.dailyMenuID}, ${item.foodItemID}, -1)"
                                            class="bg-gray-200 w-10 h-10 rounded-full hover:bg-gray-300 transition">
                                        <i class="fas fa-minus text-sm"></i>
                                    </button>
                                    <span id="qty-${item.dailyMenuID}" class="w-12 text-center font-bold text-xl">0</span>
                                    <button onclick="changeQuantity(${item.dailyMenuID}, ${item.foodItemID}, 1, ${item.availableQuantity})"
                                            class="btn-primary text-white w-10 h-10 rounded-full">
                                        <i class="fas fa-plus text-sm"></i>
                                    </button>
                                </div>
                            ` : `
                                <span class="bg-red-100 text-red-700 px-4 py-2 rounded-full text-sm font-semibold">
                                    শেষ হয়ে গেছে
                                </span>
                            `}
                        </div>
                    </div>
                `);
            });
        }

        function changeQuantity(menuId, foodItemId, change, maxQty) {
            if (!cart[menuId]) {
                cart[menuId] = { menuId, foodItemId, quantity: 0 };
            }

            cart[menuId].quantity += change;

            if (cart[menuId].quantity < 0) cart[menuId].quantity = 0;
            if (maxQty && cart[menuId].quantity > maxQty) cart[menuId].quantity = maxQty;

            if (cart[menuId].quantity === 0) {
                delete cart[menuId];
            }

            $(`#qty-${menuId}`).text(cart[menuId]?.quantity || 0);
            updateCart();
        }

        function updateCart() {
            const container = $('#cartItems');
            let total = 0;
            let html = '';

            for (let menuId in cart) {
                const item = menuData.find(m => m.dailyMenuID == menuId);
                if (item && cart[menuId].quantity > 0) {
                    const itemTotal = item.price * cart[menuId].quantity;
                    total += itemTotal;

                    html += `
                        <div class="bg-gradient-to-r from-purple-50 to-pink-50 p-4 rounded-xl">
                            <div class="flex justify-between items-start mb-2">
                                <div class="flex-1">
                                    <p class="font-bold text-gray-800">${item.itemName}</p>
                                    <p class="text-sm text-gray-600">${cart[menuId].quantity} × ৳${item.price}</p>
                                </div>
                                <button onclick="removeFromCart(${menuId})"
                                        class="text-red-500 hover:text-red-700">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <p class="text-right font-bold text-purple-600">৳${itemTotal.toFixed(2)}</p>
                        </div>
                    `;
                }
            }

            if (html === '') {
                html = `
                    <div class="text-center py-12 text-gray-400">
                        <i class="fas fa-shopping-basket text-6xl mb-4"></i>
                        <p class="text-lg">কোনো আইটেম নির্বাচিত নয়</p>
                    </div>
                `;
                $('#placeOrderBtn').prop('disabled', true);
            } else {
                $('#placeOrderBtn').prop('disabled', false);
            }

            container.html(html);
            $('#cartTotal').text(total.toFixed(2));
            $('#remainingAfterOrder').text((currentUser.availableBalance - total).toFixed(2));
        }

        function removeFromCart(menuId) {
            delete cart[menuId];
            $(`#qty-${menuId}`).text('0');
            updateCart();
        }

        function clearCart() {
            if (Object.keys(cart).length === 0) return;

            if (confirm('আপনি কি নিশ্চিত যে সব আইটেম মুছে ফেলতে চান?')) {
                cart = {};
                $('.menu-item span[id^="qty-"]').text('0');
                updateCart();
            }
        }

        async function placeOrder() {
            const items = [];
            for (let menuId in cart) {
                if (cart[menuId].quantity > 0) {
                    items.push({
                        dailyMenuId: parseInt(menuId),
                        foodItemId: cart[menuId].foodItemId,
                        quantity: cart[menuId].quantity
                    });
                }
            }

            if (items.length === 0) {
                alert('অনুগ্রহ করে কমপক্ষে একটি আইটেম নির্বাচন করুন');
                return;
            }

            $('#placeOrderBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-3"></i>প্রক্রিয়াকরণ হচ্ছে...');

            try {
                const response = await fetch('/Order/PlaceOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userId: currentUser.userId,
                        userType: currentUser.userType,
                        items: items
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showSuccessScreen(data);
                } else {
                    alert(data.message);
                    $('#placeOrderBtn').prop('disabled', false).html('<i class="fas fa-check-circle mr-3"></i>অর্ডার নিশ্চিত করুন');
                }
            } catch (error) {
                alert('অর্ডার প্রক্রিয়াকরণে সমস্যা হয়েছে');
                $('#placeOrderBtn').prop('disabled', false).html('<i class="fas fa-check-circle mr-3"></i>অর্ডার নিশ্চিত করুন');
            }
        }

        function showSuccessScreen(data) {
            clearTimeout(orderTimeout);

            $('#orderScreen').addClass('hidden');
            $('#successScreen').removeClass('hidden');

            $('#successOrderNumber').text(data.orderNumber);
            $('#successAmount').text(data.totalAmount.toFixed(2));
            $('#successRemainingBalance').text(data.remainingBalance.toFixed(2));

            // Countdown
            let count = 10;
            const interval = setInterval(() => {
                count--;
                $('#countdown').text(count);
                if (count <= 0) {
                    clearInterval(interval);
                    resetToVerification();
                }
            }, 1000);
        }

        function cancelOrder() {
            if (confirm('আপনি কি নিশ্চিত যে অর্ডার বাতিল করতে চান?')) {
                resetToVerification();
            }
        }

        function resetToVerification() {
            clearTimeout(orderTimeout);
            currentUser = null;
            cart = {};
            menuData = [];

            $('#successScreen').addClass('hidden');
            $('#orderScreen').addClass('hidden');
            $('#verificationScreen').removeClass('hidden');

            $('#cardInput').val('').prop('disabled', false).focus();
            hideError();
        }

        function startSessionTimeout() {
            clearTimeout(orderTimeout);
            orderTimeout = setTimeout(() => {
                alert('সেশন টাইমআউট। অনুগ্রহ করে আবার শুরু করুন।');
                resetToVerification();
            }, 300000); // 5 minutes
        }

        function showError(message) {
            $('#errorMessage p').text(message);
            $('#errorMessage').removeClass('hidden');
        }

        function hideError() {
            $('#errorMessage').addClass('hidden');
        }
    </script>
</body>
</html>