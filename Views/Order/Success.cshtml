@model CanteenManagementSystem.Models.Order

@{
    ViewData["Title"] = "অর্ডার সফল";
}

<div class="min-h-screen gradient-bg flex items-center justify-center py-12 px-4">
    <div class="max-w-2xl w-full">
        <div class="bg-white rounded-2xl shadow-2xl p-8 text-center">
            <div class="bg-green-100 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6 animate-bounce">
                <i class="fas fa-check-circle text-6xl text-green-600"></i>
            </div>

            <h1 class="text-4xl font-bold text-gray-800 mb-4">অর্ডার সফল হয়েছে!</h1>
            <p class="text-xl text-gray-600 mb-8">আপনার খাবার প্রস্তুত করা হচ্ছে</p>

            <div class="bg-purple-50 rounded-xl p-6 mb-8">
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="text-left">
                        <p class="text-gray-600 mb-1">অর্ডার নম্বর</p>
                        <p class="text-2xl font-bold text-purple-600">@Model.OrderNumber</p>
                    </div>
                    <div class="text-right">
                        <p class="text-gray-600 mb-1">মোট পরিমাণ</p>
                        <p class="text-2xl font-bold text-purple-600">৳@Model.TotalAmount</p>
                    </div>
                </div>

                <div class="border-t-2 border-purple-200 pt-4">
                    <h3 class="font-bold text-gray-800 mb-3">অর্ডারকৃত আইটেম:</h3>
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="flex justify-between items-center bg-white p-3 rounded-lg mb-2">
                            <span class="text-gray-800">@item.FoodItem.ItemName × @item.Quantity</span>
                            <span class="font-semibold text-purple-600">৳@item.TotalPrice</span>
                        </div>
                    }
                </div>
            </div>

            <div class="text-center space-y-4">
                <p class="text-gray-600">অনুগ্রহ করে অর্ডার নম্বরটি মনে রাখুন</p>

                <a asp-controller="Home" asp-action="Index"
                   class="inline-block bg-gradient-to-r from-purple-600 to-pink-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:from-purple-700 hover:to-pink-700 transition transform hover:scale-105">
                    <i class="fas fa-home mr-2"></i>হোম পেজে ফিরে যান
                </a>
            </div>
        </div>
    </div>
</div>
