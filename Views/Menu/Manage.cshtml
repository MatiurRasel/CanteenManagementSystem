                            <label class="block text-gray-700 font-semibold mb-2">ডিফল্ট পরিমাণ</label>
                            <input type="number" id="bulkDefaultQuantity" value="50" min="1" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">খাবারের ধরন</label>
                            <select id="bulkMealType" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg">
