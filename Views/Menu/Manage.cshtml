                <!-- Preview -->
                <div>
                    <h4 class="font-semibold text-gray-800 mb-4">পূর্বরূপ</h4>
                    <div id="bulkTemplatePreview" class="bg-gray-50 rounded-lg p-4">
                        <p class="text-gray-600 text-center">নির্বাচন করুন পূর্বরূপ দেখতে</p>
                    </div>
                </div>
            </div>

            <div class="flex gap-4 mt-8">
                <button onclick="previewBulkTemplate()"
                        class="flex-1 bg-blue-100 text-blue-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-200 transition">
                    পূর্বরূপ
                </button>
                <button onclick="createBulkTemplate()"
                        class="flex-1 btn-primary px-6 py-3 rounded-lg font-semibold hover:shadow-lg transition">
                    তৈরি করুন
                </button>
            </div>
        </div>
