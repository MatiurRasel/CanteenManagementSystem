                <div class="space-y-2">
                    <div class="flex items-center">
                        <input type="checkbox" id="overwriteExisting" class="w-4 h-4 mr-2">
                        <label for="overwriteExisting" class="text-gray-700">বিদ্যমান মেনু প্রতিস্থাপন করুন</label>
                    </div>
                    <div class="flex items-center">
                        <input type="checkbox" id="copyQuantities" class="w-4 h-4 mr-2" checked>
