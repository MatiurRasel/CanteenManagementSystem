                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-semibold text-gray-800 mb-2">পূর্বরূপ</h4>
                        <div id="foodItemPreview" class="text-center py-4">
                            <i class="fas fa-utensils text-4xl text-gray-300 mb-2"></i>
                            <p class="text-gray-500 text-sm">খাবার যোগ করুন পূর্বরূপ দেখতে</p>
                        </div>
                    </div>
                </div>
