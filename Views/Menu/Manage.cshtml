    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Global Variables
        let currentTab = 'daily';
        let selectedFoodItems = [];
        let currentEditItemId = null;

        // Initialize on page load
        $(document).ready(function() {
            // Initialize Select2 for food item select
            $('#foodItemSelect').select2({
                placeholder: "-- নির্বাচন করুন --",
                allowClear: true,
                width: '100%'
            });

            // Initialize Select2 for bulk food items
            $('#bulkFoodItems').select2({
                placeholder: "খাবার আইটেম নির্বাচন করুন",
                width: '100%'
            });

            // Set today's date as default
            const today = new Date().toISOString().split('T')[0];
            $('#menuDate').val(today);
            $('#templateStartDate').val(today);
            $('#quickApplyDate').val(today);
            $('#quickTargetDate').val(today);

            // Update menu summary
            updateMenuSummary();

            // Setup event listeners
            setupEventListeners();

            // Show success message if any
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success')) {
                showToast('সফল', 'অপারেশন সফলভাবে সম্পন্ন হয়েছে!', 'success');
            }
        });

        // Setup event listeners
        function setupEventListeners() {
            // Food item select change
            $('#foodItemSelect').on('change', function() {
                const selectedOption = $(this).find('option:selected');
                if (selectedOption.val()) {
                    $('#selectedItemPreview').removeClass('hidden');
                    $('#previewItemName').text(selectedOption.data('name'));
                    $('#previewItemPrice').text('৳' + selectedOption.data('price'));
                    $('#previewItemCategory').text(selectedOption.data('category'));
                    $('#addMenuItemBtn').prop('disabled', false);
                } else {
                    $('#selectedItemPreview').addClass('hidden');
                    $('#addMenuItemBtn').prop('disabled', true);
                }
            });

            // Template select change
            $('#templateSelect').on('change', function() {
                if ($(this).val() === 'custom') {
                    $('#customTemplateOptions').removeClass('hidden');
                } else {
                    $('#customTemplateOptions').addClass('hidden');
                }
            });

            // Quantity input validation
            $('#quantityInput').on('input', function() {
                const value = parseInt($(this).val());
                const min = parseInt($(this).attr('min'));
                if (value < min) {
                    $(this).val(min);
                }
                updateQuantityWarning();
            });

            // Food item search
            $('#foodItemSearch').on('input', function() {
                filterFoodItems();
            });

            // Global food item search
            $('#foodItemGlobalSearch').on('input', function() {
                filterAllFoodItems();
            });
        }

        // Tab Navigation
        function showTab(tabName) {
            // Hide all tabs
            $('.tab-content').addClass('hidden');
            $('.tab-button').removeClass('active').addClass('bg-gray-100 text-gray-700');

            // Update current tab
            currentTab = tabName;

            // Show selected tab
            if (tabName === 'daily') {
                $('#dailyMenuTab').removeClass('hidden');
                $('#tabDaily').removeClass('bg-gray-100 text-gray-700').addClass('active');
            } else if (tabName === 'weekly') {
                $('#weeklyTemplateTab').removeClass('hidden');
                $('#tabWeekly').removeClass('bg-gray-100 text-gray-700').addClass('active');
            } else if (tabName === 'foodItems') {
                $('#foodItemsTab').removeClass('hidden');
                $('#tabFoodItems').removeClass('bg-gray-100 text-gray-700').addClass('active');
            } else if (tabName === 'quickActions') {
                $('#quickActionsTab').removeClass('hidden');
                $('#tabQuickActions').removeClass('bg-gray-100 text-gray-700').addClass('active');
            }
        }

        // Load menu for selected date
        async function loadMenu() {
            showLoading();
            const date = $('#menuDate').val();
            try {
                window.location.href = `/Menu/Manage?date=${date}`;
            } catch (error) {
                showToast('ত্রুটি', 'মেনু লোড করতে সমস্যা হয়েছে', 'error');
                hideLoading();
            }
        }

        // Refresh current menu
        function refreshMenu() {
            showLoading();
            setTimeout(() => {
                location.reload();
            }, 500);
        }

        // Add menu item
        async function addMenuItem() {
            const foodItemId = $('#foodItemSelect').val();
            const mealType = $('input[name="mealType"]:checked').val();
            const quantity = $('#quantityInput').val();
            const displayOrder = $('#displayOrderInput').val();
            const menuDate = $('#menuDate').val();

            if (!foodItemId) {
                showToast('সতর্কতা', 'অনুগ্রহ করে একটি খাবার নির্বাচন করুন', 'warning');
                return;
            }

            if (!mealType) {
                showToast('সতর্কতা', 'অনুগ্রহ করে খাবারের ধরন নির্বাচন করুন', 'warning');
                return;
            }

            showLoading();
            try {
                const response = await fetch('/Menu/AddMenuItem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        foodItemId: parseInt(foodItemId),
                        menuDate: menuDate,
                        mealType: mealType,
                        quantity: parseInt(quantity),
                        displayOrder: parseInt(displayOrder)
                    })
                });

                const data = await response.json();
                if (data.success) {
                    showToast('সফল', data.message, 'success');
                    setTimeout(() => {
                        loadMenu();
                    }, 1000);
                } else {
                    showToast('ত্রুটি', data.message, 'error');
                }
            } catch (error) {
                showToast('ত্রুটি', 'একটি ত্রুটি ঘটেছে: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

        // Remove menu item
        async function removeMenuItem(menuId) {
            if (!confirm('আপনি কি নিশ্চিত যে এই আইটেমটি মুছে ফেলতে চান?')) return;

            showLoading();
            try {
                const response = await fetch('/Menu/RemoveMenuItem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `menuId=${menuId}`
                });

                const data = await response.json();
                if (data.success) {
                    showToast('সফল', data.message, 'success');
                    $(`#menu-${menuId}`).fadeOut(300, function() {
                        $(this).remove();
                        updateMenuSummary();
                    });
                } else {
                    showToast('ত্রুটি', data.message, 'error');
                }
            } catch (error) {
                showToast('ত্রুটি', 'একটি ত্রুটি ঘটেছে: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

        // Update menu item quantity
        async function updateQuantity(menuId) {
            const newQuantity = $(`#qty-${menuId}`).val();

            if (!newQuantity || newQuantity < 1) {
                showToast('সতর্কতা', 'অনুগ্রহ করে সঠিক পরিমাণ লিখুন', 'warning');
                return;
            }

            showLoading();
            try {
                const response = await fetch('/Menu/UpdateQuantity', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        menuId: menuId,
                        newQuantity: parseInt(newQuantity)
                    })
                });

                const data = await response.json();
                if (data.success) {
                    showToast('সফল', data.message, 'success');
                    setTimeout(() => {
                        loadMenu();
                    }, 1000);
                } else {
                    showToast('ত্রুটি', data.message, 'error');
                }
            } catch (error) {
                showToast('ত্রুটি', 'একটি ত্রুটি ঘটেছে: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

        // Toggle menu item availability
        async function toggleAvailability(menuId) {
            showLoading();
            try {
                const response = await fetch('/Menu/ToggleAvailability', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `menuId=${menuId}`
                });

                const data = await response.json();
                if (data.success) {
                    const btn = $(`#avail-btn-${menuId}`);
                    if (data.isAvailable) {
                        btn.removeClass('bg-gray-400 hover:bg-gray-500').addClass('btn-success').html('<i class="fas fa-check-circle mr-2"></i>উপলব্ধ');
                    } else {
                        btn.removeClass('btn-success').addClass('bg-gray-400 hover:bg-gray-500').html('<i class="fas fa-times-circle mr-2"></i>অনুপলব্ধ');
                    }
                    showToast('সফল', data.message, 'success');
                } else {
                    showToast('ত্রুটি', data.message, 'error');
                }
            } catch (error) {
                showToast('ত্রুটি', 'একটি ত্রুটি ঘটেছে: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

        // Show edit menu item modal
        function showEditMenuItemModal(menuId) {
            showToast('ইনফো', 'সম্পাদনা ফিচারটি শীঘ্রই আসছে', 'info');
        }

        // Apply weekly template
        async function applyTemplate() {
            const templateType = $('#templateSelect').val();
            const startDate = $('#templateStartDate').val();
            const duration = $('#templateDuration').val();
            const skipExisting = $('#skipExisting').is(':checked');

            if (!templateType) {
                showToast('সতর্কতা', 'অনুগ্রহ করে টেমপ্লেট টাইপ নির্বাচন করুন', 'warning');
                return;
            }

            if (!startDate) {
                showToast('সতর্কতা', 'অনুগ্রহ করে শুরুর তারিখ নির্বাচন করুন', 'warning');
                return;
            }

            let selectedDays = [];
            if (templateType === 'custom') {
                selectedDays = $('#customTemplateOptions input[type="checkbox"]:checked').map(function() {
                    return parseInt($(this).val());
                }).get();

                if (selectedDays.length === 0) {
                    showToast('সতর্কতা', 'অনুগ্রহ করে কমপক্ষে একটি দিন নির্বাচন করুন', 'warning');
                    return;
                }
            }

            showLoading();
            try {
                let requestData = {
                    startDate: startDate,
                    durationDays: parseInt(duration),
                    templateType: templateType,
                    skipExisting: skipExisting
                };

                if (templateType === 'custom') {
                    requestData.selectedDays = selectedDays;
                }

                const response = await fetch('/Menu/ApplyWeeklyTemplate', {
                    method: 'POST',
                    headers: {
