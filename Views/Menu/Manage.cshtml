@model CanteenManagementSystem.Models.ViewModels.MenuManagementViewModel
@using CanteenManagementSystem.Models
@{
    ViewData["Title"] = "মেনু ম্যানেজমেন্ট";
}

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700;800&display=swap');

        * {
            font-family: 'Noto Sans Bengali', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .container-wrapper {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            min-height: 100vh;
        }

        .card {
            background: white;
            border-radius: 1rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .menu-item-card {
            transition: all 0.3s ease;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            overflow: hidden;
        }

            .menu-item-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
                border-color: #667eea;
            }

        .tab-button {
            transition: all 0.3s ease;
            border-radius: 0.75rem;
        }

            .tab-button.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
            }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-weight: 600;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
            }

        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .quantity-badge {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .modal-overlay {
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
        }

        .modal-content {
            animation: slideUp 0.3s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .loader {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Mobile optimizations */
        @@media (max-width: 768px) {
            .container-wrapper {
                padding: 0.5rem;
            }

            .card {
                border-radius: 0.5rem;
            }

            .menu-item-card {
                border-radius: 0.5rem;
            }

            h1 {
                font-size: 1.5rem;
            }

            h2 {
                font-size: 1.25rem;
            }
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
        }

        .select2-container--default .select2-selection--single {
            border: 2px solid #e5e7eb !important;
            border-radius: 0.75rem !important;
            height: 48px !important;
            padding: 0.5rem !important;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                line-height: 2.5 !important;
            }
    </style>
</head>
<body>
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
        <div class="loader"></div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed top-4 right-4 z-50 hidden">
        <div class="bg-white rounded-lg shadow-lg p-4 max-w-md transform transition-transform duration-300 translate-x-full">
            <div class="flex items-center">
                <div id="toastIcon" class="text-2xl mr-3"></div>
                <div>
                    <h3 id="toastTitle" class="font-semibold"></h3>
                    <p id="toastMessage" class="text-sm text-gray-600"></p>
                </div>
            </div>
        </div>
    </div>

    <div class="container-wrapper">
        <div class="min-h-screen p-4 lg:p-6">
            <div class="max-w-7xl mx-auto">
                <!-- Header -->
                <div class="card p-4 lg:p-8 mb-6">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="bg-gradient-to-r from-purple-600 to-pink-600 p-3 rounded-xl">
                                    <i class="fas fa-list-alt text-white text-2xl"></i>
                                </div>
                                <div>
                                    <h1 class="text-2xl lg:text-4xl font-bold text-gray-800">
                                        মেনু ম্যানেজমেন্ট
                                    </h1>
                                    <p class="text-gray-600 text-sm lg:text-base">দৈনিক মেনু এবং সাপ্তাহিক টেমপ্লেট পরিচালনা করুন</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                            <div class="relative">
                                <input type="date"
                                       id="menuDate"
                                       value="@Model.TargetDate.ToString("yyyy-MM-dd")"
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-purple-500 focus:outline-none bg-white">
                                <i class="fas fa-calendar-alt absolute right-3 top-3 text-gray-400"></i>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="loadMenu()"
                                        class="btn-primary px-6 py-3 rounded-xl font-semibold flex-1">
                                    <i class="fas fa-sync-alt mr-2"></i>লোড করুন
                                </button>
                                <a asp-controller="Operator" asp-action="Dashboard"
                                   class="btn-success px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition flex-1 text-center">
                                    <i class="fas fa-tachometer-alt mr-2"></i>ড্যাশবোর্ড
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabs Navigation -->
                <div class="card p-4 mb-6">
                    <div class="flex flex-wrap gap-2">
                        <button onclick="showTab('daily')"
                                id="tabDaily"
                                class="tab-button active px-6 py-3 rounded-xl font-semibold text-sm lg:text-base flex-1 min-w-[140px]">
                            <i class="fas fa-calendar-day mr-2"></i>দৈনিক মেনু
                        </button>
                        <button onclick="showTab('weekly')"
                                id="tabWeekly"
                                class="tab-button px-6 py-3 rounded-xl font-semibold text-sm lg:text-base bg-gray-100 text-gray-700 flex-1 min-w-[140px]">
                            <i class="fas fa-calendar-week mr-2"></i>টেমপ্লেট
                        </button>
                        <button onclick="showTab('foodItems')"
                                id="tabFoodItems"
                                class="tab-button px-6 py-3 rounded-xl font-semibold text-sm lg:text-base bg-gray-100 text-gray-700 flex-1 min-w-[140px]">
                            <i class="fas fa-utensils mr-2"></i>খাবার আইটেম
                        </button>
                        <button onclick="showTab('quickActions')"
                                id="tabQuickActions"
                                class="tab-button px-6 py-3 rounded-xl font-semibold text-sm lg:text-base bg-gray-100 text-gray-700 flex-1 min-w-[140px]">
                            <i class="fas fa-bolt mr-2"></i>দ্রুত কাজ
                        </button>
                    </div>
                </div>

                <!-- Daily Menu Tab -->
                <div id="dailyMenuTab" class="tab-content">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Current Menu -->
                        <div class="lg:col-span-2">
                            <div class="card p-4 lg:p-6">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
                                    <div>
                                        <h2 class="text-xl lg:text-2xl font-bold text-gray-800">
                                            <i class="fas fa-calendar-check text-purple-600 mr-2"></i>
                                            আজকের মেনু - @Model.TargetDate.ToString("dd MMMM yyyy")
                                        </h2>
                                        <p class="text-gray-600 text-sm mt-1" id="menuSummary"></p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span id="itemCount" class="quantity-badge">
                                            @Model.MenuItems.Count টি আইটেম
                                        </span>
                                        <button onclick="refreshMenu()"
                                                class="bg-blue-600 text-white p-2 rounded-lg hover:bg-blue-700 transition">
                                            <i class="fas fa-redo"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Menu Filter -->
                                <div class="mb-6">
                                    <div class="flex flex-wrap gap-2">
                                        <button onclick="filterMenu('all')" class="px-4 py-2 bg-purple-100 text-purple-700 rounded-lg font-medium active">সকল</button>
                                        <button onclick="filterMenu('Breakfast')" class="px-4 py-2 bg-orange-100 text-orange-700 rounded-lg font-medium">সকালের নাস্তা</button>
                                        <button onclick="filterMenu('Lunch')" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-medium">লাঞ্চ</button>
                                        <button onclick="filterMenu('Snacks')" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-medium">স্ন্যাক্স</button>
                                        <button onclick="filterMenu('Drinks')" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-medium">ড্রিংকস</button>
                                    </div>
                                </div>

                                <!-- Menu Items Grid -->
                                <div id="currentMenu" class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[600px] overflow-y-auto pr-2">
                                    @if (Model.MenuItems.Any())
                                    {
                                        @foreach (var item in Model.MenuItems)
                                        {
                                            string mealTypeName = item.Category switch
                                            {
                                                "Breakfast" => "সকালের নাস্তা",
                                                "Lunch" => "লাঞ্চ",
                                                "Snacks" => "স্ন্যাক্স",
                                                "Drinks" => "ড্রিংকস",
                                                "Dinner" => "ডিনার",
                                                _ => item.Category
                                            };

                                            <div class="menu-item-card" id="menu-@item.DailyMenuID" data-category="@item.Category">
                                                <div class="p-4">
                                                    <div class="flex items-start justify-between mb-3">
                                                        <div class="flex-1">
                                                            <div class="flex items-center gap-2 mb-1">
                                                                <h3 class="text-lg font-bold text-gray-800">@item.ItemName</h3>
                                                                <span class="text-xs px-2 py-1 rounded-full bg-purple-100 text-purple-700">
                                                                    @mealTypeName
                                                                </span>
                                                            </div>
                                                            <p class="text-2xl font-bold text-purple-600 mb-2">৳@item.Price</p>
                                                        </div>
                                                        <span class="text-3xl">🍽️</span>
                                                    </div>

                                                    <!-- Quantity Stats -->
                                                    <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-lg p-3 mb-4">
                                                        <div class="grid grid-cols-3 gap-2 text-center">
                                                            <div class="bg-white rounded p-2">
                                                                <p class="text-xs text-gray-600 mb-1">মোট</p>
                                                                <p class="font-bold text-gray-800 text-lg">@item.InitialQuantity</p>
                                                            </div>
                                                            <div class="bg-white rounded p-2">
                                                                <p class="text-xs text-gray-600 mb-1">বিক্রি</p>
                                                                <p class="font-bold text-orange-600 text-lg">@item.OrderedQuantity</p>
                                                            </div>
                                                            <div class="bg-white rounded p-2">
                                                                <p class="text-xs text-gray-600 mb-1">বাকি</p>
                                                                <p class="font-bold text-green-600 text-lg">@item.AvailableQuantity</p>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="space-y-3">
                                                        <div class="flex gap-2">
                                                            <input type="number"
                                                                   id="qty-@item.DailyMenuID"
                                                                   value="@item.InitialQuantity"
                                                                   min="@item.OrderedQuantity"
                                                                   class="flex-1 px-3 py-2 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none"
                                                                   placeholder="পরিমাণ">
                                                            <button onclick="updateQuantity(@item.DailyMenuID)"
                                                                    class="bg-blue-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition">
                                                                <i class="fas fa-save"></i>
                                                            </button>
                                                        </div>

                                                        <div class="flex gap-2">
                                                            <button onclick="toggleAvailability(@item.DailyMenuID)"
                                                                    id="avail-btn-@item.DailyMenuID"
                                                                    class="flex-1 @(item.IsAvailable ? "btn-success" : "bg-gray-400 hover:bg-gray-500") px-4 py-2 rounded-lg font-semibold transition">
                                                                <i class="fas @(item.IsAvailable ? "fa-check-circle" : "fa-times-circle") mr-2"></i>
                                                                @(item.IsAvailable ? "উপলব্ধ" : "অনুপলব্ধ")
                                                            </button>
                                                            <button onclick="showEditMenuItemModal(@item.DailyMenuID)"
                                                                    class="bg-yellow-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-yellow-600 transition">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <button onclick="removeMenuItem(@item.DailyMenuID)"
                                                                    class="btn-danger px-4 py-2 rounded-lg font-semibold hover:shadow-lg transition">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="col-span-2 text-center py-12">
                                            <div class="bg-gray-100 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                                                <i class="fas fa-utensils text-4xl text-gray-400"></i>
                                            </div>
                                            <p class="text-xl text-gray-400 mb-2">এই তারিখের জন্য কোনো মেনু নেই</p>
                                            <p class="text-gray-500 mb-4">মেনু যোগ করুন অথবা টেমপ্লেট প্রয়োগ করুন</p>
                                            <button onclick="showApplyTemplateModal()"
                                                    class="btn-primary px-6 py-3 rounded-lg font-semibold">
                                                <i class="fas fa-magic mr-2"></i>টেমপ্লেট প্রয়োগ করুন
                                            </button>
                                        </div>
                                    }
                                </div>

                                <!-- Pagination (if needed) -->
                                <div class="mt-6 flex justify-center">
                                    <div class="flex gap-2">
                                        <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                        <button class="px-4 py-2 bg-purple-600 text-white rounded-lg">1</button>
                                        <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg">2</button>
                                        <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Add Item Panel -->
                        <div class="lg:col-span-1">
                            <div class="card p-4 lg:p-6 sticky top-4">
                                <h2 class="text-xl lg:text-2xl font-bold text-gray-800 mb-6">
                                    <i class="fas fa-plus-circle text-green-600 mr-2"></i>
                                    নতুন আইটেম যোগ করুন
                                </h2>

                                <div class="space-y-4">
                                    <!-- Quick Search -->
                                    <div>
                                        <label class="block text-gray-700 font-semibold mb-2">
                                            <i class="fas fa-search mr-2"></i>দ্রুত খুঁজুন
                                        </label>
                                        <input type="text"
                                               id="foodItemSearch"
                                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none"
                                               placeholder="খাবারের নাম লিখুন..."
                                               onkeyup="filterFoodItems()">
                                    </div>

                                    <!-- Food Item Selection -->
                                    <div>
                                        <label class="block text-gray-700 font-semibold mb-2">
                                            <i class="fas fa-utensils mr-2"></i>খাবার নির্বাচন
                                        </label>
                                        <select id="foodItemSelect"
                                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none">
                                            <option value="">-- নির্বাচন করুন --</option>
                                            @foreach (var item in Model.AllFoodItems)
                                            {
                                                <option value="@item.FoodItemID"
                                                        data-price="@item.Price"
                                                        data-category="@item.Category"
                                                        data-name="@item.ItemName">
                                                    @item.ItemName (৳@item.Price)
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Selected Item Preview -->
                                    <div id="selectedItemPreview" class="hidden bg-gray-50 rounded-lg p-4">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <h4 id="previewItemName" class="font-bold text-gray-800"></h4>
                                                <p id="previewItemPrice" class="text-purple-600 font-semibold"></p>
                                            </div>
                                            <span id="previewItemCategory" class="text-xs px-2 py-1 rounded-full bg-purple-100 text-purple-700"></span>
                                        </div>
                                    </div>

                                    <!-- Meal Type Selection -->
                                    <div>
                                        <label class="block text-gray-700 font-semibold mb-2">
                                            <i class="fas fa-clock mr-2"></i>খাবারের ধরন
                                        </label>
                                        <div class="grid grid-cols-2 gap-2">
                                            <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-purple-500">
                                                <input type="radio" name="mealType" value="Breakfast" class="mr-2">
                                                <span>সকালের নাস্তা</span>
                                            </label>
                                            <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-purple-500">
                                                <input type="radio" name="mealType" value="Lunch" class="mr-2" checked>
                                                <span>লাঞ্চ</span>
                                            </label>
                                            <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-purple-500">
                                                <input type="radio" name="mealType" value="Snacks" class="mr-2">
                                                <span>স্ন্যাক্স</span>
                                            </label>
                                            <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-purple-500">
                                                <input type="radio" name="mealType" value="Drinks" class="mr-2">
                                                <span>ড্রিংকস</span>
                                            </label>
                                            <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-purple-500">
                                                <input type="radio" name="mealType" value="Dinner" class="mr-2">
                                                <span>ডিনার</span>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Quantity Input -->
                                    <div>
                                        <label class="block text-gray-700 font-semibold mb-2">
                                            <i class="fas fa-boxes mr-2"></i>পরিমাণ
                                        </label>
                                        <div class="flex items-center gap-2">
                                            <button onclick="decreaseQuantity()" class="bg-gray-200 text-gray-700 w-10 h-10 rounded-lg">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                            <input type="number"
                                                   id="quantityInput"
                                                   value="50"
                                                   min="1"
                                                   class="flex-1 px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none text-center">
                                            <button onclick="increaseQuantity()" class="bg-gray-200 text-gray-700 w-10 h-10 rounded-lg">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                        <div class="flex justify-between mt-2 text-sm text-gray-600">
                                            <span>ন্যূনতম: 1</span>
                                            <span id="quantityWarning" class="text-orange-600 hidden">অর্ডার থেকে কম!</span>
                                        </div>
                                    </div>

                                    <!-- Display Order -->
                                    <div>
                                        <label class="block text-gray-700 font-semibold mb-2">
                                            <i class="fas fa-sort-numeric-down mr-2"></i>প্রদর্শন অর্ডার
                                        </label>
                                        <input type="number"
                                               id="displayOrderInput"
                                               value="0"
                                               min="0"
                                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none">
                                    </div>

                                    <!-- Add Button -->
                                    <button onclick="addMenuItem()"
                                            id="addMenuItemBtn"
                                            class="w-full btn-primary px-6 py-4 rounded-xl font-bold text-lg hover:shadow-lg transition disabled:opacity-50 disabled:cursor-not-allowed">
                                        <i class="fas fa-plus-circle mr-2"></i>মেনুতে যোগ করুন
                                    </button>
                                </div>

                                <!-- Quick Template Actions -->
                                <div class="mt-8 pt-6 border-t-2 border-gray-200">
                                    <h3 class="font-bold text-gray-800 mb-4">
                                        <i class="fas fa-bolt mr-2"></i>দ্রুত টেমপ্লেট
                                    </h3>
                                    <div class="space-y-3">
                                        <button onclick="applyTodayTemplate()"
                                                class="w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition">
                                            <i class="fas fa-calendar-day mr-2"></i>আজকের টেমপ্লেট
                                        </button>
                                        <button onclick="showApplyTemplateModal()"
                                                class="w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition">
                                            <i class="fas fa-calendar-week mr-2"></i>টেমপ্লেট প্রয়োগ
                                        </button>
                                        <button onclick="showCopyMenuModal()"
                                                class="w-full bg-gradient-to-r from-green-600 to-green-700 text-white px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition">
                                            <i class="fas fa-copy mr-2"></i>মেনু কপি করুন
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Weekly Template Tab -->
                <div id="weeklyTemplateTab" class="tab-content hidden">
                    <div class="card p-4 lg:p-6">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between mb-6 gap-4">
                            <div>
                                <h2 class="text-xl lg:text-2xl font-bold text-gray-800">
                                    <i class="fas fa-calendar-week text-purple-600 mr-2"></i>
                                    সাপ্তাহিক মেনু টেমপ্লেট
                                </h2>
                                <p class="text-gray-600">সাপ্তাহিক রুটিনের জন্য টেমপ্লেট তৈরি করুন</p>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="showCreateTemplateModal()"
                                        class="btn-primary px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition">
                                    <i class="fas fa-plus mr-2"></i>নতুন টেমপ্লেট
                                </button>
                                <button onclick="showBulkTemplateModal()"
                                        class="bg-green-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-green-700 transition">
                                    <i class="fas fa-layer-group mr-2"></i>বাল্ক তৈরি
                                </button>
                                <button onclick="exportTemplates()"
                                        class="bg-blue-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-700 transition">
                                    <i class="fas fa-file-export mr-2"></i>এক্সপোর্ট
                                </button>
                            </div>
                        </div>

                        <!-- Template Filter -->
                        <div class="mb-6">
                            <div class="flex flex-wrap gap-2">
                                <select id="templateDayFilter"
                                        class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none"
                                        onchange="filterTemplates()">
                                    <option value="all">সকল দিন</option>
                                    <option value="0">শনিবার</option>
                                    <option value="1">রবিবার</option>
                                    <option value="2">সোমবার</option>
                                    <option value="3">মঙ্গলবার</option>
                                    <option value="4">বুধবার</option>
                                    <option value="5">বৃহস্পতিবার</option>
                                    <option value="6">শুক্রবার</option>
                                </select>
                                <select id="templateCategoryFilter"
                                        class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none"
                                        onchange="filterTemplates()">
                                    <option value="all">সকল ক্যাটাগরি</option>
                                    <option value="Breakfast">সকালের নাস্তা</option>
                                    <option value="Lunch">লাঞ্চ</option>
                                    <option value="Snacks">স্ন্যাক্স</option>
                                    <option value="Drinks">ড্রিংকস</option>
                                </select>
                            </div>
                        </div>

                        <!-- Weekly Template Grid -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            @for (int day = 0; day <= 6; day++)
                            {
                                var dayName = new[] { "শনিবার", "রবিবার", "সোমবার", "মঙ্গলবার", "বুধবার", "বৃহস্পতিবার", "শুক্রবার" }[day];
                                var dayTemplates = Model.WeeklyTemplates.Where(t => t.DayOfWeek == day).ToList();

                                <div class="border-2 border-gray-200 rounded-xl p-4 lg:p-6 template-day" data-day="@day">
                                    <div class="flex items-center justify-between mb-4">
                                        <h3 class="text-lg lg:text-xl font-bold text-gray-800 flex items-center gap-2">
                                            <span class="bg-purple-100 text-purple-700 w-8 h-8 rounded-full flex items-center justify-center">
                                                @dayName[0]
                                            </span>
                                            @dayName
                                        </h3>
                                        <span class="text-sm px-3 py-1 bg-gray-100 text-gray-700 rounded-full">
                                            @dayTemplates.Count টি আইটেম
                                        </span>
                                    </div>

                                    @if (dayTemplates.Any())
                                    {
                                        <div class="space-y-3">
                                            @foreach (var template in dayTemplates)
                                            {
                                                <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-4 template-item"
                                                     data-category="@template.MealType"
                                                     data-id="@template.TemplateID">
                                                    <div class="flex items-start justify-between">
                                                        <div class="flex-1">
                                                            <div class="flex items-center gap-2 mb-1">
                                                                <h4 class="font-semibold text-gray-800">@template.FoodItem.ItemName</h4>
                                                                <span class="text-xs px-2 py-1 rounded-full bg-purple-100 text-purple-700">
                                                                    @template.MealType
                                                                </span>
                                                            </div>
                                                            <p class="text-sm text-gray-600 mb-2">পরিমাণ: @template.DefaultQuantity | অর্ডার: @template.DisplayOrder</p>
                                                            <p class="text-sm text-gray-500">@template.TemplateName</p>
                                                        </div>
                                                        <div class="flex gap-1">
                                                            <button onclick="editTemplate(@template.TemplateID)"
                                                                    class="bg-blue-500 text-white p-2 rounded-lg hover:bg-blue-600 transition">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <button onclick="deleteTemplate(@template.TemplateID)"
                                                                    class="btn-danger p-2 rounded-lg hover:shadow-lg transition">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-8">
                                            <i class="fas fa-calendar-plus text-4xl text-gray-300 mb-3"></i>
                                            <p class="text-gray-400">কোনো টেমপ্লেট নেই</p>
                                            <button onclick="createTemplateForDay(@day)"
                                                    class="mt-3 text-purple-600 hover:text-purple-700 font-medium">
                                                <i class="fas fa-plus mr-1"></i>টেমপ্লেট যোগ করুন
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Food Items Management Tab -->
                <div id="foodItemsTab" class="tab-content hidden">
                    <div class="card p-4 lg:p-6">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between mb-6 gap-4">
                            <div>
                                <h2 class="text-xl lg:text-2xl font-bold text-gray-800">
                                    <i class="fas fa-utensils text-green-600 mr-2"></i>
                                    খাবার আইটেম ব্যবস্থাপনা
                                </h2>
                                <p class="text-gray-600">সমস্ত খাবার আইটেম দেখুন এবং পরিচালনা করুন</p>
                            </div>
                            <button onclick="showCreateFoodItemModal()"
                                    class="btn-primary px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition">
                                <i class="fas fa-plus mr-2"></i>নতুন খাবার যোগ করুন
                            </button>
                        </div>

                        <!-- Food Items Search and Filter -->
                        <div class="mb-6">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="relative">
                                    <input type="text"
                                           id="foodItemGlobalSearch"
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none pl-10"
                                           placeholder="খাবারের নাম লিখুন...">
                                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                                </div>
                                <select id="foodItemCategoryFilter"
                                        class="px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none">
                                    <option value="all">সকল ক্যাটাগরি</option>
                                    <option value="Breakfast">সকালের নাস্তা</option>
                                    <option value="Lunch">লাঞ্চ</option>
                                    <option value="Snacks">স্ন্যাক্স</option>
                                    <option value="Drinks">ড্রিংকস</option>
                                    <option value="Dinner">ডিনার</option>
                                </select>
                                <select id="foodItemStatusFilter"
                                        class="px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500 focus:outline-none">
                                    <option value="all">সকল অবস্থা</option>
                                    <option value="available">উপলব্ধ</option>
                                    <option value="unavailable">অনুপলব্ধ</option>
                                </select>
                            </div>
                        </div>

                        <!-- Food Items Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="foodItemsGrid">
                            @foreach (var item in Model.AllFoodItems)
                            {
                                <div class="border-2 border-gray-200 rounded-xl p-4 food-item-card"
                                     data-category="@item.Category"
                                     data-available="@item.IsAvailable">
                                    <div class="flex items-start justify-between mb-3">
                                        <div class="flex-1">
                                            <h3 class="text-lg font-bold text-gray-800 mb-1">@item.ItemName</h3>
                                            <p class="text-sm text-gray-600 mb-2">@item.Description</p>
                                            <div class="flex items-center gap-2">
                                                <span class="text-xl font-bold text-purple-600">৳@item.Price</span>
                                                <span class="text-xs px-2 py-1 rounded-full bg-purple-100 text-purple-700">
                                                    @item.Category
                                                </span>
                                                <span class="text-xs px-2 py-1 rounded-full @(item.IsAvailable ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                                    @(item.IsAvailable ? "সক্রিয়" : "নিষ্ক্রিয়")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="w-16 h-16 bg-gray-100 rounded-lg flex items-center justify-center">
                                            <i class="fas fa-utensils text-2xl text-gray-400"></i>
                                        </div>
                                    </div>

                                    <div class="flex gap-2 pt-3 border-t border-gray-200">
                                        <button onclick="editFoodItem(@item.FoodItemID)"
                                                class="flex-1 bg-blue-500 text-white px-3 py-2 rounded-lg font-medium hover:bg-blue-600 transition">
                                            <i class="fas fa-edit mr-1"></i>সম্পাদনা
                                        </button>
                                        <button onclick="toggleFoodItemStatus(@item.FoodItemID)"
                                                class="flex-1 @(item.IsAvailable ? "bg-yellow-500 hover:bg-yellow-600" : "bg-green-500 hover:bg-green-600") text-white px-3 py-2 rounded-lg font-medium transition">
                                            <i class="fas @(item.IsAvailable ? "fa-eye-slash" : "fa-eye") mr-1"></i>
                                            @(item.IsAvailable ? "লুকান" : "দেখান")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Quick Actions Tab -->
                <div id="quickActionsTab" class="tab-content hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Apply Template Panel -->
                        <div class="card p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4">
                                <i class="fas fa-calendar-week text-purple-600 mr-2"></i>
                                টেমপ্লেট প্রয়োগ করুন
                            </h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-gray-700 font-semibold mb-2">টেমপ্লেট নির্বাচন</label>
                                    <select id="quickTemplateSelect" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg">
                                        <option value="">-- নির্বাচন করুন --</option>
                                        <option value="week">সম্পূর্ণ সপ্তাহ</option>
                                        <option value="weekend">শুক্র-শনি</option>
                                        <option value="weekdays">সোম-বৃহস্পতি</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-gray-700 font-semibold mb-2">তারিখ</label>
                                    <input type="date" id="quickApplyDate" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                </div>
                                <button onclick="quickApplyTemplate()" class="w-full btn-primary py-3 rounded-lg font-semibold">
                                    <i class="fas fa-magic mr-2"></i>দ্রুত প্রয়োগ করুন
                                </button>
                            </div>
                        </div>

                        <!-- Copy Menu Panel -->
                        <div class="card p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4">
                                <i class="fas fa-copy text-blue-600 mr-2"></i>
                                মেনু কপি করুন
                            </h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-gray-700 font-semibold mb-2">উৎস তারিখ</label>
                                    <input type="date" id="quickSourceDate" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")">
                                </div>
                                <div>
                                    <label class="block text-gray-700 font-semibold mb-2">গন্তব্য তারিখ</label>
                                    <input type="date" id="quickTargetDate" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="flex items-center">
                                    <input type="checkbox" id="quickOverwrite" class="w-4 h-4 mr-2">
                                    <label for="quickOverwrite" class="text-gray-700">বিদ্যমান মেনু প্রতিস্থাপন করুন</label>
                                </div>
                                <button onclick="quickCopyMenu()" class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700">
                                    <i class="fas fa-copy mr-2"></i>কপি করুন
                                </button>
                            </div>
                        </div>

                        <!-- Batch Operations -->
                        <div class="card p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4">
                                <i class="fas fa-layer-group text-green-600 mr-2"></i>
                                বাল্ক অপারেশন
                            </h3>
                            <div class="space-y-3">
                                <button onclick="batchUpdateQuantities()" class="w-full bg-yellow-500 text-white p-4 rounded-lg font-semibold hover:bg-yellow-600 transition">
                                    <i class="fas fa-boxes mr-2"></i>সকল পরিমাণ আপডেট
                                </button>
                                <button onclick="batchToggleAvailability()" class="w-full bg-purple-600 text-white p-4 rounded-lg font-semibold hover:bg-purple-700 transition">
                                    <i class="fas fa-toggle-on mr-2"></i>সকল উপলব্ধতা পরিবর্তন
                                </button>
                                <button onclick="clearTodayMenu()" class="w-full bg-red-600 text-white p-4 rounded-lg font-semibold hover:bg-red-700 transition">
                                    <i class="fas fa-trash-alt mr-2"></i>আজকের মেনু পরিষ্কার
                                </button>
                                <button onclick="generateWeeklyReport()" class="w-full bg-blue-600 text-white p-4 rounded-lg font-semibold hover:bg-blue-700 transition">
                                    <i class="fas fa-chart-bar mr-2"></i>সাপ্তাহিক রিপোর্ট
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <!-- Apply Template Modal -->
    <div id="applyTemplateModal" class="modal-overlay fixed inset-0 flex items-center justify-center z-50 hidden p-4">
        <div class="modal-content bg-white rounded-2xl p-6 max-w-md w-full max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-800">টেমপ্লেট প্রয়োগ করুন</h3>
                <button onclick="closeApplyTemplateModal()" class="text-gray-400 hover:text-gray-600">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">টেমপ্লেট নির্বাচন</label>
                    <select id="templateSelect" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500">
                        <option value="">-- নির্বাচন করুন --</option>
                        <option value="week">সম্পূর্ণ সপ্তাহ</option>
                        <option value="weekend">শুক্র-শনি</option>
                        <option value="weekdays">সোম-বৃহস্পতি</option>
                        <option value="custom">কাস্টম নির্বাচন</option>
                    </select>
                </div>

                <div id="customTemplateOptions" class="hidden space-y-2">
                    <div class="grid grid-cols-2 gap-2">
                        @for (int i = 0; i <= 6; i++)
                        {
                            var dayName = new[] { "শনি", "রবি", "সোম", "মঙ্গল", "বুধ", "বৃহঃ", "শুক্র" }[i];
                            <label class="flex items-center p-2 border rounded-lg cursor-pointer">
                                <input type="checkbox" value="@i" class="mr-2">
                                <span>@dayName</span>
                            </label>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-gray-700 font-semibold mb-2">শুরুর তারিখ</label>
                    <input type="date" id="templateStartDate"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>

                <div>
                    <label class="block text-gray-700 font-semibold mb-2">সময়কাল</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="setDuration(7)" class="p-3 border rounded-lg hover:border-purple-500">১ সপ্তাহ</button>
                        <button onclick="setDuration(14)" class="p-3 border rounded-lg hover:border-purple-500">২ সপ্তাহ</button>
                        <button onclick="setDuration(30)" class="p-3 border rounded-lg hover:border-purple-500">১ মাস</button>
                    </div>
                    <input type="number" id="templateDuration" value="7" min="1" class="w-full mt-2 px-4 py-3 border-2 border-gray-300 rounded-lg">
                </div>

                <div class="flex items-center">
                    <input type="checkbox" id="skipExisting" class="w-4 h-4 mr-2">
                    <label for="skipExisting" class="text-gray-700">বিদ্যমান মেনু স্কিপ করুন</label>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h4 class="font-semibold text-blue-800 mb-2">
                        <i class="fas fa-info-circle mr-2"></i>মনে রাখুন
                    </h4>
                    <p class="text-sm text-blue-700">
                        টেমপ্লেট প্রয়োগ করলে নির্বাচিত দিনগুলোতে ডিফল্ট আইটেমগুলো যুক্ত হবে। বিদ্যমান মেনু আইটেমগুলো সংরক্ষিত থাকবে যদি স্কিপ অপশন সিলেক্ট করা থাকে।
                    </p>
                </div>
            </div>

            <div class="flex gap-4">
                <button onclick="closeApplyTemplateModal()"
                        class="flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition">
                    বাতিল
                </button>
                <button onclick="applyTemplate()"
                        class="flex-1 btn-primary px-6 py-3 rounded-lg font-semibold hover:shadow-lg transition">
                    <i class="fas fa-check mr-2"></i>প্রয়োগ করুন
                </button>
            </div>
        </div>
    </div>

    <!-- Copy Menu Modal -->
    <div id="copyMenuModal" class="modal-overlay fixed inset-0 flex items-center justify-center z-50 hidden p-4">
        <div class="modal-content bg-white rounded-2xl p-6 max-w-md w-full">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-800">মেনু কপি করুন</h3>
                <button onclick="closeCopyMenuModal()" class="text-gray-400 hover:text-gray-600">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">কোন তারিখ থেকে</label>
                    <input type="date" id="copySourceDate"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500"
                           value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">কোন তারিখে</label>
                    <input type="date" id="copyTargetDate"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500"
