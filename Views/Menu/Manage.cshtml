                    <h4 class="font-semibold text-gray-800 mb-4">২. খাবার আইটেম নির্বাচন করুন</h4>
                    <select id="bulkFoodItems" multiple class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-purple-500">
                        @foreach (var item in Model.AllFoodItems)
                        {
                            <option value="@item.FoodItemID" data-price="@item.Price">@item.ItemName (৳@item.Price)</option>
