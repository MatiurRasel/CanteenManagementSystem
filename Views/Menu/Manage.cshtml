            showLoading();
            try {
                const response = await fetch('/Menu/GenerateWeeklyReport');
                const data = await response.json();

                if (data.success) {
                    // Create and download report
                    const blob = new Blob([data.report], { type: 'text/csv' });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `weekly_report_${new Date().toISOString().split('T')[0]}.csv`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);

                    showToast('সফল', 'রিপোর্ট ডাউনলোড করা হয়েছে', 'success');
                } else {
                    showToast('ত্রুটি', data.message, 'error');
                }
            } catch (error) {
                showToast('ত্রুটি', 'একটি ত্রুটি ঘটেছে: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

        // Export templates
        async function exportTemplates() {
            showLoading();
            try {
                const response = await fetch('/Menu/ExportTemplates');
                const data = await response.json();

                if (data.success) {
                    const blob = new Blob([JSON.stringify(data.templates, null, 2)], { type: 'application/json' });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `templates_${new Date().toISOString().split('T')[0]}.json`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);

                    showToast('সফল', 'টেমপ্লেট এক্সপোর্ট করা হয়েছে', 'success');
                } else {
                    showToast('ত্রুটি', data.message, 'error');
                }
            } catch (error) {
                showToast('ত্রুটি', 'একটি ত্রুটি ঘটেছে: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

        // Filter menu items by category
        function filterMenu(category) {
            $('.menu-item-card').show();

            if (category !== 'all') {
                $(`.menu-item-card:not([data-category*="${category}"])`).hide();
            }

            // Update active filter button
            $('.filter-button').removeClass('active');
            $(`button[onclick="filterMenu('${category}')"]`).addClass('active');
        }

        // Filter food items in select
        function filterFoodItems() {
            const searchText = $('#foodItemSearch').val().toLowerCase();

            $('#foodItemSelect option').each(function() {
                const text = $(this).text().toLowerCase();
                if (text.includes(searchText)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        // Filter all food items in grid
        function filterAllFoodItems() {
            const searchText = $('#foodItemGlobalSearch').val().toLowerCase();
            const category = $('#foodItemCategoryFilter').val();
            const status = $('#foodItemStatusFilter').val();

            $('.food-item-card').each(function() {
                const itemName = $(this).find('h3').text().toLowerCase();
                const itemCategory = $(this).data('category');
                const itemAvailable = $(this).data('available').toString();

                let showItem = true;

                // Search text filter
                if (searchText && !itemName.includes(searchText)) {
                    showItem = false;
                }

                // Category filter
                if (category !== 'all' && itemCategory !== category) {
                    showItem = false;
                }

                // Status filter
                if (status !== 'all') {
                    if (status === 'available' && itemAvailable !== 'true') {
                        showItem = false;
                    } else if (status === 'unavailable' && itemAvailable !== 'false') {
                        showItem = false;
                    }
                }

                if (showItem) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        // Filter templates
        function filterTemplates() {
            const dayFilter = $('#templateDayFilter').val();
            const categoryFilter = $('#templateCategoryFilter').val();

            $('.template-day').each(function() {
                const day = $(this).data('day');
                let showDay = true;

                // Day filter
                if (dayFilter !== 'all' && day.toString() !== dayFilter) {
                    showDay = false;
                }

                if (showDay) {
                    $(this).show();

                    // Filter items within day
                    $(this).find('.template-item').each(function() {
                        const category = $(this).data('category');
                        let showItem = true;

                        if (categoryFilter !== 'all' && category !== categoryFilter) {
                            showItem = false;
                        }

                        if (showItem) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                } else {
                    $(this).hide();
                }
            });
        }

        // Update menu summary
        function updateMenuSummary() {
            const totalItems = $('.menu-item-card').length;
            const availableItems = $('.menu-item-card').filter(function() {
                return $(this).find('.btn-success').length > 0;
            }).length;
            const totalQuantity = $('.menu-item-card').find('.bg-white:first-child p:last-child').map(function() {
                return parseInt($(this).text());
            }).get().reduce((a, b) => a + b, 0);

            $('#itemCount').text(`${totalItems} টি আইটেম`);
            $('#menuSummary').html(`
                <span class="text-green-600">${availableItems} টি উপলব্ধ</span> |
                <span class="text-blue-600">মোট ${totalQuantity} পিস</span>
            `);
        }

        // Update quantity warning
        function updateQuantityWarning() {
            const quantity = parseInt($('#quantityInput').val());
            if (quantity < 10) {
                $('#quantityWarning').removeClass('hidden');
            } else {
                $('#quantityWarning').addClass('hidden');
            }
        }

        // Increase quantity
        function increaseQuantity() {
            const input = $('#quantityInput');
            let value = parseInt(input.val());
            input.val(value + 1);
            updateQuantityWarning();
        }

        // Decrease quantity
        function decreaseQuantity() {
            const input = $('#quantityInput');
            let value = parseInt(input.val());
            const min = parseInt(input.attr('min'));
            if (value > min) {
                input.val(value - 1);
                updateQuantityWarning();
            }
        }

        // Set duration for template
        function setDuration(days) {
            $('#templateDuration').val(days);
        }

        // Create template for specific day
        function createTemplateForDay(day) {
            $('#templateDayOfWeek').val(day);
            showCreateTemplateModal();
        }

        // Preview bulk template
        function previewBulkTemplate() {
            const selectedDays = $('.bulk-day-checkbox:checked').map(function() {
                return $(this).val();
            }).get();

            const selectedFoodItems = $('#bulkFoodItems').val();
            const defaultQuantity = $('#bulkDefaultQuantity').val();
            const mealType = $('#bulkMealType').val();

            if (selectedDays.length === 0 || !selectedFoodItems || selectedFoodItems.length === 0) {
                $('#bulkTemplatePreview').html('<p class="text-gray-600 text-center">নির্বাচন করুন পূর্বরূপ দেখতে</p>');
                return;
            }

            const dayNames = ['শনিবার', 'রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার'];
            const selectedDayNames = selectedDays.map(d => dayNames[d]).join(', ');

            $('#bulkTemplatePreview').html(`
                <div class="space-y-2">
                    <p><strong>নির্বাচিত দিন:</strong> ${selectedDayNames}</p>
                    <p><strong>খাবারের ধরন:</strong> ${mealType}</p>
                    <p><strong>ডিফল্ট পরিমাণ:</strong> ${defaultQuantity}</p>
                    <p><strong>মোট টেমপ্লেট:</strong> ${selectedDays.length * selectedFoodItems.length} টি</p>
                </div>
            `);
        }

        // Show loading overlay
        function showLoading() {
            $('#loadingOverlay').removeClass('hidden');
        }

        // Hide loading overlay
        function hideLoading() {
            $('#loadingOverlay').addClass('hidden');
        }

        // Show toast notification
        function showToast(title, message, type = 'info') {
            const toast = $('#toast');
            const toastTitle = $('#toastTitle');
            const toastMessage = $('#toastMessage');
            const toastIcon = $('#toastIcon');

            // Set icon based on type
            let icon = 'fa-info-circle';
            let bgColor = 'bg-blue-500';

            switch(type) {
                case 'success':
                    icon = 'fa-check-circle';
                    bgColor = 'bg-green-500';
                    break;
                case 'error':
                    icon = 'fa-times-circle';
                    bgColor = 'bg-red-500';
                    break;
                case 'warning':
                    icon = 'fa-exclamation-triangle';
                    bgColor = 'bg-yellow-500';
                    break;
            }

            // Update content
            toastTitle.text(title);
            toastMessage.text(message);
            toastIcon.removeClass().addClass(`fas ${icon} ${bgColor} text-white p-2 rounded-full`);

            // Show toast
            toast.removeClass('hidden');
            setTimeout(() => {
                toast.find('.modal-content').removeClass('translate-x-full');
            }, 10);

            // Hide after 5 seconds
            setTimeout(() => {
                toast.find('.modal-content').addClass('translate-x-full');
                setTimeout(() => {
                    toast.addClass('hidden');
                }, 300);
            }, 5000);
        }

        // Modal functions
        function showApplyTemplateModal() {
            $('#applyTemplateModal').removeClass('hidden');
        }

        function closeApplyTemplateModal() {
            $('#applyTemplateModal').addClass('hidden');
        }

        function showCopyMenuModal() {
            $('#copyMenuModal').removeClass('hidden');
        }

        function closeCopyMenuModal() {
            $('#copyMenuModal').addClass('hidden');
        }

        function showCreateFoodItemModal() {
            $('#createFoodItemModal').removeClass('hidden');
        }

        function closeCreateFoodItemModal() {
            $('#createFoodItemModal').addClass('hidden');
        }

        function showEditFoodItemModal() {
            $('#editFoodItemModal').removeClass('hidden');
        }

        function closeEditFoodItemModal() {
            $('#editFoodItemModal').addClass('hidden');
        }

        function showBulkTemplateModal() {
            $('#bulkTemplateModal').removeClass('hidden');
        }

        function closeBulkTemplateModal() {
            $('#bulkTemplateModal').addClass('hidden');
        }
    </script>
</body>
</html>