@{
    ViewData["Title"] = "ব্যবহারকারীর ধরন নির্বাচন করুন";
}

<div class="min-h-screen gradient-bg flex items-center justify-center py-12 px-4">
    <div class="container mx-auto">
        <div class="text-center text-white mb-12">
            <h1 class="text-5xl font-bold mb-4">আপনার ধরন নির্বাচন করুন</h1>
            <p class="text-xl text-purple-200">অর্ডার শুরু করতে আপনার ক্যাটাগরি বেছে নিন</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <!-- Student Card -->
            <a asp-controller="Order" asp-action="Kiosk" asp-route-userType="Student"
               class="card-hover bg-white rounded-2xl p-8 text-center transform transition hover:scale-105 shadow-2xl">
                <div class="bg-blue-100 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-user-graduate text-5xl text-blue-600"></i>
                </div>
                <h2 class="text-3xl font-bold text-gray-800 mb-4">শিক্ষার্থী</h2>
                <p class="text-gray-600 mb-6">Student ID দিয়ে লগইন করুন</p>
                <div class="bg-blue-50 rounded-lg p-4">
                    <p class="text-sm text-blue-800 font-semibold">মাসিক লিমিট: ৳১৮০০ - ৳২০০০</p>
                </div>
            </a>

            <!-- Teacher Card -->
            <a asp-controller="Order" asp-action="Kiosk" asp-route-userType="Teacher"
               class="card-hover bg-white rounded-2xl p-8 text-center transform transition hover:scale-105 shadow-2xl">
                <div class="bg-green-100 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-chalkboard-teacher text-5xl text-green-600"></i>
                </div>
                <h2 class="text-3xl font-bold text-gray-800 mb-4">শিক্ষক</h2>
                <p class="text-gray-600 mb-6">Employee ID দিয়ে লগইন করুন</p>
                <div class="bg-green-50 rounded-lg p-4">
                    <p class="text-sm text-green-800 font-semibold">বর্ধিত মাসিক লিমিট</p>
                </div>
            </a>

            <!-- Staff Card -->
            <a asp-controller="Order" asp-action="Kiosk" asp-route-userType="Staff"
               class="card-hover bg-white rounded-2xl p-8 text-center transform transition hover:scale-105 shadow-2xl">
                <div class="bg-purple-100 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-users text-5xl text-purple-600"></i>
                </div>
                <h2 class="text-3xl font-bold text-gray-800 mb-4">কর্মচারী</h2>
                <p class="text-gray-600 mb-6">Employee ID দিয়ে লগইন করুন</p>
                <div class="bg-purple-50 rounded-lg p-4">
                    <p class="text-sm text-purple-800 font-semibold">মাসিক লিমিট: ৳১৮০০ - ৳২০০০</p>
                </div>
            </a>
        </div>

        <div class="text-center mt-12">
            <a asp-controller="Home" asp-action="Index"
               class="inline-block bg-white text-purple-600 px-6 py-3 rounded-full font-semibold hover:bg-purple-100 transition">
                <i class="fas fa-arrow-left mr-2"></i>হোম পেজে ফিরে যান
            </a>
        </div>
    </div>
</div>