                                    <div class="flex justify-between items-center mt-3">
                                        <div class="flex items-center gap-2">
                                            <button onclick="changeQuantity(${menuId}, ${item.foodItemID}, -1, null, event)"
                                                    class="quantity-btn w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300">
                                                <i class="fas fa-minus text-xs text-gray-700"></i>
                                            </button>
                                            <span class="font-bold text-gray-900 w-8 text-center">${cart[menuId].quantity}</span>
                                            <button onclick="changeQuantity(${menuId}, ${item.foodItemID}, 1, ${item.availableQuantity}, event)"
                                                    class="quantity-btn w-8 h-8 edtech-gradient rounded-full flex items-center justify-center hover:opacity-90">
                                                <i class="fas fa-plus text-xs text-white"></i>
                                            </button>
                                        </div>
                                        <p class="font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">
                                            ৳${itemTotal.toFixed(2)}
                                        </p>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-2">
                                        <i class="fas fa-tag mr-1 text-indigo-400"></i>
                                        ${cart[menuId].quantity} × ৳${item.price.toFixed(2)}
                                    </p>
                                </div>
                                <button onclick="removeFromCart(${menuId})"
                                        class="ml-4 text-red-500 hover:text-red-700 transition-colors p-2">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }
            }

            if (html === '') {
                html = `
                    <div class="text-center py-12">
                        <div class="inline-block p-6 bg-gradient-to-br from-gray-100 to-gray-50 rounded-2xl mb-4">
                            <i class="fas fa-shopping-basket text-5xl text-gray-300"></i>
                        </div>
                        <p class="text-xl font-medium text-gray-500">কোনো আইটেম নির্বাচিত নয়</p>
                        <p class="text-sm text-gray-400 mt-2">মেনু থেকে আইটেম নির্বাচন করুন</p>
                    </div>
                `;
                $('#placeOrderBtn').prop('disabled', true);
            } else {
                $('#placeOrderBtn').prop('disabled', false);
            }

            container.html(html);
            $('#cartTotal').text(formatCurrency(total));
            $('#cartItemCount').text(itemCount);
            $('#remainingAfterOrder').text(formatCurrency(currentUser.availableBalance - total));

            // Animate cart update
            container.addClass('scale-105');
            setTimeout(() => container.removeClass('scale-105'), 150);
        }

        function removeFromCart(menuId) {
            delete cart[menuId];
            $(`#qty-${menuId}`).text('0');
            updateCart();
            showToast('আইটেম কার্ট থেকে সরানো হয়েছে', 'info');
        }

        function clearCart() {
            if (Object.keys(cart).length === 0) return;

            if (confirm('আপনি কি নিশ্চিত যে সব আইটেম মুছে ফেলতে চান?')) {
                cart = {};
                $('.menu-item span[id^="qty-"]').text('0');
                updateCart();
                showToast('কার্ট পরিষ্কার করা হয়েছে', 'success');
            }
        }

        async function placeOrder() {
            const items = [];
            for (let menuId in cart) {
                if (cart[menuId].quantity > 0) {
                    items.push({
                        dailyMenuId: parseInt(menuId),
                        foodItemId: cart[menuId].foodItemId,
                        quantity: cart[menuId].quantity
                    });
                }
            }

            if (items.length === 0) {
                showError('অনুগ্রহ করে কমপক্ষে একটি আইটেম নির্বাচন করুন');
                return;
            }

            // Check if balance is sufficient
            const cartTotal = parseFloat($('#cartTotal').text().replace(/,/g, ''));
            if (currentUser.availableBalance < cartTotal) {
                showError('আপনার পর্যাপ্ত ব্যালেন্স নেই।');
                return;
            }

            $('#placeOrderBtn').prop('disabled', true)
                .html('<i class="fas fa-spinner fa-spin mr-3"></i>প্রক্রিয়াকরণ হচ্ছে...');

            try {
                const response = await fetch('/Order/PlaceOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userId: currentUser.userId,
                        userIdentifier: currentUser.userIdentifier,
                        userType: currentUser.userType,
                        items: items
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showSuccessScreen(data);
                } else {
                    showError(data.message || 'অর্ডার দিতে সমস্যা হয়েছে।');
                    $('#placeOrderBtn').prop('disabled', false)
                        .html('<i class="fas fa-check-circle mr-3"></i>অর্ডার নিশ্চিত করুন');
                }
            } catch (error) {
                console.error('Order error:', error);
                showError('অর্ডার প্রক্রিয়াকরণে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
                $('#placeOrderBtn').prop('disabled', false)
                    .html('<i class="fas fa-check-circle mr-3"></i>অর্ডার নিশ্চিত করুন');
            }
        }

        function showSuccessScreen(data) {
            clearTimeout(orderTimeout);
            if (countdownInterval) clearInterval(countdownInterval);

            $('#orderScreen').addClass('hidden');
            $('#successScreen').removeClass('hidden');
            $('html, body').animate({ scrollTop: 0 }, 300);

            $('#successOrderNumber').text(data.orderNumber || '---');
            $('#successAmount').text(formatCurrency(data.totalAmount || 0));
            $('#successRemainingBalance').text(formatCurrency(data.remainingBalance || 0));

            // Countdown with progress bar
            let count = 10;
            $('#countdown').text(count);
            const countdownBar = $('#countdownBar');
            countdownBar.css('width', '100%');

            countdownInterval = setInterval(() => {
                count--;
                $('#countdown').text(count);
                const progress = (count / 10) * 100;
                countdownBar.css('width', `${progress}%`);

                if (count <= 0) {
                    clearInterval(countdownInterval);
                    resetToVerification();
                }
            }, 1000);
        }

        function printReceipt() {
            const printContent = `
                <div style="font-family: 'Noto Sans Bengali', sans-serif; padding: 20px;">
                    <h1 style="text-align: center; color: #4F46E5;">অর্ডার রিসিপ্ট</h1>
                    <p>অর্ডার নম্বর: ${$('#successOrderNumber').text()}</p>
                    <p>তারিখ: ${new Date().toLocaleDateString('bn-BD')}</p>
                    <p>মোট পরিমাণ: ৳${$('#successAmount').text()}</p>
                    <hr>
                    <p style="text-align: center;">ধন্যবাদ</p>
                </div>
            `;

            const printWindow = window.open('', '_blank');
            printWindow.document.write(printContent);
            printWindow.document.close();
            printWindow.print();
        }

        function showOrderHistory() {
            alert('এই ফিচারটি শীঘ্রই আসছে...');
        }

        function cancelOrder() {
            if (confirm('আপনি কি নিশ্চিত যে অর্ডার বাতিল করতে চান? সব নির্বাচিত আইটেম মুছে যাবে।')) {
                resetToVerification();
            }
        }

        function resetToVerification() {
            clearTimeout(orderTimeout);
            if (countdownInterval) clearInterval(countdownInterval);
            if (autoFocusTimer) clearInterval(autoFocusTimer);

            currentUser = null;
            cart = {};
            menuData = [];
            isManualInputEnabled = false;
            isProcessing = false;

            // Reset all screens
            $('#successScreen').addClass('hidden');
            $('#orderScreen').addClass('hidden');
            $('#verificationScreen').removeClass('hidden');

            // Reset input field
            const input = $('#cardInput');
            input.val('').prop('disabled', false);
            input.removeClass('manual-input-active');
            $('#manualInputBtn').removeClass('bg-gradient-to-r from-green-500 to-emerald-500');
            $('#menuSearch').val('');

            // Hide loading spinner just in case
            $('#loadingSpinner').addClass('hidden');

            // Restore scanner placeholder
            disableManualInput();

            // Focus scanner for next scan
            setTimeout(focusScanner, 300);

            // Trigger event for other listeners
            $(document).trigger('resetComplete');

            // Restart auto-focus timer
            startAutoFocusTimer();

            hideError();
        }

        function startSessionTimeout() {
            clearTimeout(orderTimeout);
            orderTimeout = setTimeout(() => {
                if ($('#orderScreen').is(':visible')) {
                    showError('সেশন টাইমআউট (২ মিনিট)। স্বয়ংক্রিয়ভাবে রিসেট হচ্ছে...');
                    setTimeout(() => {
                        resetToVerification();
                        showToast('নতুন স্ক্যানের জন্য প্রস্তুত', 'info');
                    }, 2000);
                }
            }, 2 * 60 * 1000); // 2 minutes
        }

        function scrollToTop() {
            $('html, body').animate({ scrollTop: 0 }, 500);
        }

        function showError(message) {
            $('#errorText').text(message);
            $('#errorMessage').removeClass('hidden').addClass('bounce-in');
            setTimeout(hideError, 5000);
        }

        function hideError() {
            $('#errorMessage').removeClass('bounce-in').addClass('hidden');
        }

        function showToast(message, type = 'info') {
            const colors = {
                success: 'bg-gradient-to-r from-green-500 to-emerald-600',
                error: 'bg-gradient-to-r from-red-500 to-pink-600',
                warning: 'bg-gradient-to-r from-yellow-500 to-amber-600',
                info: 'edtech-gradient'
            };

            const icons = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-circle',
                warning: 'fa-exclamation-triangle',
                info: 'fa-info-circle'
            };

            const toast = $(`
                <div class="fixed top-4 left-1/2 transform -translate-x-1/2 ${colors[type]} text-white px-6 py-3 rounded-full shadow-2xl z-50" style="animation: slideInDown 0.3s ease-out">
                    <div class="flex items-center gap-3">
                        <i class="fas ${icons[type]}"></i>
                        <span class="font-medium">${message}</span>
                    </div>
                </div>
            `);

            $('body').append(toast);
            setTimeout(() => {
                toast.animate({ opacity: 0, top: '-100px' }, 300, function() {
                    $(this).remove();
                });
            }, 3000);
        }

        function setupSwipeGestures() {
            let touchStartX = 0;
            let touchStartY = 0;
            let touchEndX = 0;
            let touchEndY = 0;

            document.addEventListener('touchstart', function(event) {
                touchStartX = event.changedTouches[0].screenX;
                touchStartY = event.changedTouches[0].screenY;
            }, false);

            document.addEventListener('touchend', function(event) {
                touchEndX = event.changedTouches[0].screenX;
                touchEndY = event.changedTouches[0].screenY;
                handleSwipe();
            }, false);

            function handleSwipe() {
                const deltaX = touchEndX - touchStartX;
                const deltaY = touchEndY - touchStartY;

                // Minimum swipe distance
                if (Math.abs(deltaX) < 50 && Math.abs(deltaY) < 50) return;

                // Horizontal swipe (left/right)
                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX > 0) {
                        // Swipe right - go back
                        if ($('#orderScreen').is(':visible')) {
                            cancelOrder();
                        }
                    }
                }
            }
        }

        function checkConnection() {
            const statusElement = $('#connectionStatus');
            if (navigator.onLine) {
                statusElement.html(`
                    <div class="status-online flex items-center gap-2">
                        <div class="w-2 h-2 bg-white rounded-full animate-pulse"></div>
                        <span>অনলাইন</span>
                    </div>
                `);
            } else {
                statusElement.html(`
                    <div class="bg-gradient-to-r from-red-500 to-pink-600 text-white px-4 py-2 rounded-full shadow-lg flex items-center gap-2">
                        <div class="w-2 h-2 bg-white rounded-full"></div>
                        <span>অফলাইন</span>
                    </div>
                `);
            }
        }

        // Handle offline/online events
        window.addEventListener('online', checkConnection);
        window.addEventListener('offline', checkConnection);
    </script>
</body>
</html>