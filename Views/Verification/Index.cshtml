        function changeQuantity(menuId, foodItemId, change, maxQty, event) {
            if (event) {
                event.stopPropagation();
                // Add click feedback
                $(event.currentTarget).addClass('scale-90');
                setTimeout(() => {
                    $(event.currentTarget).removeClass('scale-90');
                }, 150);
            }

            if (!cart[menuId]) {
                cart[menuId] = { menuId, foodItemId, quantity: 0 };
            }

            cart[menuId].quantity += change;

            if (cart[menuId].quantity < 0) cart[menuId].quantity = 0;
            if (maxQty && cart[menuId].quantity > maxQty) {
                cart[menuId].quantity = maxQty;
                showError(`সর্বোচ্চ ${maxQty} টি অর্ডার করতে পারবেন`);
            }

            if (cart[menuId].quantity === 0) {
                delete cart[menuId];
            }

            // Animate quantity change
            const qtyElement = $(`#qty-${menuId}`);
            qtyElement.addClass('scale-110');
            setTimeout(() => qtyElement.removeClass('scale-110'), 150);
            qtyElement.text(cart[menuId]?.quantity || 0);

            updateCart();
        }

        function updateCart() {
            const container = $('#cartItems');
            let total = 0;
            let itemCount = 0;
            let html = '';

            for (let menuId in cart) {
                const item = menuData.find(m => m.dailyMenuID == menuId);
                if (item && cart[menuId].quantity > 0) {
                    const itemTotal = item.price * cart[menuId].quantity;
                    total += itemTotal;
                    itemCount += cart[menuId].quantity;

                    html += `
                        <div class="bg-gradient-to-r from-white to-indigo-50 p-4 rounded-xl border border-indigo-100 shadow-sm hover:shadow-md transition-all">
                            <div class="flex justify-between items-start mb-2">
