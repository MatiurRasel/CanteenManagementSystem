        function generateAvatar(name, userType) {
            const colors = userType === 1 ? ['4F46E5', '7C3AED'] : ['10B981', '059669'];
            const nameParts = (name || 'User').split(' ');
            const initials = nameParts.map(p => p.charAt(0)).join('').toUpperCase().substring(0, 2);
            $('#userPhoto').attr('src',
                `https://ui-avatars.com/api/?name=${encodeURIComponent(initials)}&background=${colors[0]}&color=fff&size=80&bold=true&font-size=0.4`
            );
        }

        function formatCurrency(amount) {
            return parseFloat(amount).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

