                case 1: return 'ব্রেকফাস্ট';
                case 2: return 'লাঞ্চ';
                case 3: return 'স্ন্যাকস';
                case 4: return 'ড্রিংকস';
                case 5: return 'ডিনার';
                default: return 'অন্যান্য';
            }
        }

        function getCategoryColor(category) {
            switch(category) {
                case 1: return 'bg-gradient-to-r from-yellow-500 to-amber-600';
                case 2: return 'bg-gradient-to-r from-green-500 to-emerald-600';
                case 3: return 'bg-gradient-to-r from-pink-500 to-rose-600';
                case 4: return 'bg-gradient-to-r from-blue-500 to-cyan-600';
                case 5: return 'bg-gradient-to-r from-purple-500 to-violet-600';
                default: return 'bg-gradient-to-r from-gray-500 to-gray-800';
