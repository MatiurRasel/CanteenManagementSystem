                userTypeText = employeeTypeName.toUpperCase();
                userIcon = 'fas fa-user-tie';
                $('#userTypeIcon').removeClass().addClass(userIcon);
            }

            $('#userTypeBadge').text(userTypeText);

            // Set user photo with fallback
            const userPhoto = $('#userPhoto');
            if (currentUser.userPhotoUrl) {
                userPhoto.attr('src', currentUser.userPhotoUrl);
                userPhoto.on('error', function() {
                    generateAvatar(currentUser.userName, userType);
