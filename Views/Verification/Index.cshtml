    <!-- Auto-focus Message -->
    <div id="autoFocusMessage" class="auto-focus-message hidden">
        <i class="fas fa-bolt mr-2 text-yellow-300"></i>
        স্ক্যানার স্বয়ংক্রিয়ভাবে প্রস্তুত
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Global variables
        let currentUser = null;
        let cart = {};
        let menuData = [];
        let orderTimeout = null;
        let countdownInterval = null;
        let searchTimeout = null;
        let isManualInputEnabled = false;
        let lastScanTime = 0;
        let scanTimeout = null;
        let isProcessing = false;
        let idleTimer = null;
        let autoFocusTimer = null;
        let qrScanner = null;

        // Initialize
        $(document).ready(function() {
            initializeApp();
            setupEventListeners();
            checkConnection();

            // Auto-focus on page load with delay
            setTimeout(() => {
                focusScanner();
                showAutoFocusMessage();
            }, 800);
        });

        function initializeApp() {
            displayCurrentDate();
            setupSwipeGestures();

            // Initially focus scanner
            focusScanner();

            // Setup scanner placeholder click
            $('#scannerPlaceholder').on('click', function() {
                if (!isManualInputEnabled && !isProcessing) {
                    focusScanner();
                }
            });

            // Show/hide scanner placeholder based on input
            $('#cardInput').on('focus', function() {
                $('#scannerPlaceholder').addClass('border-solid bg-white border-indigo-500 scanner-active');
            }).on('blur', function() {
                if (!$(this).val() && !isManualInputEnabled) {
                    $('#scannerPlaceholder').removeClass('border-solid bg-white border-indigo-500');
                }
            });

            // Auto-refocus when tab/window becomes visible
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden && !isManualInputEnabled && !isProcessing) {
                    setTimeout(focusScanner, 100);
                }
            });

            // Start auto-focus timer
            startAutoFocusTimer();
        }

        function setupEventListeners() {
            // Handle scanner input - optimized for fast scanning
            $('#cardInput').on('input', function(e) {
                if (isProcessing) return;

                const input = $(this);
                const value = input.val();

                // Clear any existing timeout
                clearTimeout(scanTimeout);

                // If Enter key or newline is detected (scanners often send Enter)
                if (value.includes('\n') || value.includes('\r')) {
                    const cleanValue = value.replace(/[\n\r]/g, '').trim();
                    input.val(cleanValue);
                    if (cleanValue.length >= 2) {
                        verifyUser();
                    }
                    return;
                }

                // For scanners that don't send Enter, detect based on length
                if (value.length >= 3) {
                    scanTimeout = setTimeout(() => {
                        verifyUser();
                    }, 100); // Fast timeout for scanners
                }
            });

            // Handle Enter key specifically
            $('#cardInput').on('keydown', function(e) {
                if (e.key === 'Enter' && $(this).val().length >= 2) {
                    e.preventDefault();
                    verifyUser();
                }
            });

            // Menu search with debounce
            $('#menuSearch').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    filterMenuItems($(this).val());
                }, 300);
            });

            // Back to top button
            $(window).on('scroll', function() {
                if ($(this).scrollTop() > 100) {
                    $('#backToTop').fadeIn();
                } else {
                    $('#backToTop').fadeOut();
                }
            });

            // Prevent form submission on enter in search
            $('#menuSearch').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                }
            });

            // Click outside to disable manual input and refocus scanner
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#cardInput, #manualInputBtn, #manualInputOverlay').length && isManualInputEnabled) {
                    disableManualInput();
                    setTimeout(focusScanner, 100);
                }
            });

            // Escape key to disable manual input
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && isManualInputEnabled) {
                    disableManualInput();
                    setTimeout(focusScanner, 100);
                }
            });

            // Refocus scanner after order success screen timeout
            $(document).on('resetComplete', function() {
                setTimeout(focusScanner, 300);
            });

            // Reset idle timer on user interaction
            document.addEventListener('mousemove', resetIdleTimer);
            document.addEventListener('keypress', resetIdleTimer);
            document.addEventListener('click', resetIdleTimer);
            document.addEventListener('touchstart', resetIdleTimer);
            document.addEventListener('scroll', resetIdleTimer);

            // Start idle timer
            resetIdleTimer();

            // Initialize NFC if available
            initializeNFC();
        }

        // FOCUS FUNCTIONS
        function focusScanner() {
            if (isProcessing || isManualInputEnabled) return;

            const input = $('#cardInput');
            input.focus();

            // Create a visible indicator that scanner is ready
            $('#scannerPlaceholder').addClass('border-solid bg-white border-indigo-500 scanner-active');

            // Clear input for fresh scan
            input.val('');

            // For touch devices, ensure virtual keyboard doesn't show
            if ('ontouchstart' in window) {
                input.attr('readonly', 'readonly');
                setTimeout(() => {
                    input.removeAttr('readonly');
                }, 100);
            }

            // Play soft focus sound
            playSound('focus');
        }

        function enableManualInput() {
            isManualInputEnabled = true;
            const input = $('#cardInput');

            // Show overlay
            $('#manualInputOverlay').show();

            // Show the actual input field
            input.removeClass('opacity-0 absolute');
            input.addClass('opacity-100 relative block manual-input-active');
            input.css('background', 'white');
            input.css('z-index', '100');
            $('#scannerPlaceholder').hide();

            // Show virtual keyboard on mobile
            input.attr('inputmode', 'numeric');
            input.attr('pattern', '[0-9]*');
            input.attr('readonly', false);

            // Focus and select all text
            setTimeout(() => {
                input.focus();
                input.select();
            }, 100);

            $('#manualInputBtn').addClass('bg-gradient-to-r from-green-500 to-emerald-500');
            showToast('আইডি লিখতে প্রস্তুত। স্ক্যানার মোডে ফিরতে ESC চাপুন।', 'info');
        }

        function disableManualInput() {
            isManualInputEnabled = false;
            const input = $('#cardInput');

            // Hide overlay
            $('#manualInputOverlay').hide();

            // Hide the input field, show scanner placeholder
            input.addClass('opacity-0 absolute');
            input.removeClass('opacity-100 relative block manual-input-active');
            input.css('background', 'transparent');
            input.css('z-index', 'auto');
            $('#scannerPlaceholder').show();

            // Remove keyboard attributes
            input.removeAttr('inputmode');
            input.removeAttr('pattern');

            input.val('').blur();

            $('#manualInputBtn').removeClass('bg-gradient-to-r from-green-500 to-emerald-500');
            showToast('স্ক্যানার মোড সক্রিয়', 'info');
        }

        function startAutoFocusTimer() {
            let seconds = 0;
            autoFocusTimer = setInterval(() => {
                seconds++;
                $('#autoFocusTimer').text(seconds);

                // Auto-refocus every 30 seconds if not in manual mode
                if (seconds % 30 === 0 && !isManualInputEnabled && !isProcessing) {
                    if (!$('#orderScreen').is(':visible') && !$('#successScreen').is(':visible')) {
                        focusScanner();
                        showAutoFocusMessage();
                    }
                }
            }, 1000);
        }

        function showAutoFocusMessage() {
            const message = $('#autoFocusMessage');
            message.removeClass('hidden');
            setTimeout(() => {
                message.addClass('hidden');
            }, 3000);
        }

        function resetIdleTimer() {
            clearTimeout(idleTimer);
            idleTimer = setTimeout(() => {
                if (!$('#orderScreen').is(':visible') &&
                    !$('#successScreen').is(':visible') &&
                    !isManualInputEnabled &&
                    !isProcessing) {
                    focusScanner();
                }
            }, 30000); // Refocus after 30 seconds of inactivity
        }

        // SOUND FUNCTIONS
        function playSound(type) {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();

                if (type === 'scan') {
                    // Beep sound for successful scan
                    const oscillator = audioContext.createOscillator();
                    const gainNode = audioContext.createGain();

                    oscillator.connect(gainNode);
                    gainNode.connect(audioContext.destination);

                    oscillator.frequency.value = 800;
                    oscillator.type = 'sine';

                    gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);

                    oscillator.start(audioContext.currentTime);
                    oscillator.stop(audioContext.currentTime + 0.1);
                } else if (type === 'focus') {
                    // Soft focus sound
                    const oscillator = audioContext.createOscillator();
                    const gainNode = audioContext.createGain();

                    oscillator.connect(gainNode);
                    gainNode.connect(audioContext.destination);

                    oscillator.frequency.value = 400;
                    oscillator.type = 'sine';

                    gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.05);

                    oscillator.start(audioContext.currentTime);
                    oscillator.stop(audioContext.currentTime + 0.05);
                } else if (type === 'success') {
                    // Success sound
                    const oscillator = audioContext.createOscillator();
                    const gainNode = audioContext.createGain();

                    oscillator.connect(gainNode);
                    gainNode.connect(audioContext.destination);

                    oscillator.frequency.setValueAtTime(523.25, audioContext.currentTime); // C5
                    oscillator.frequency.setValueAtTime(659.25, audioContext.currentTime + 0.1); // E5
                    oscillator.frequency.setValueAtTime(783.99, audioContext.currentTime + 0.2); // G5

                    oscillator.type = 'sine';

                    gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);

                    oscillator.start(audioContext.currentTime);
                    oscillator.stop(audioContext.currentTime + 0.3);
                }
            } catch (e) {
                console.log('Audio not supported');
            }
        }

        // NFC SUPPORT
        function initializeNFC() {
            if ('NDEFReader' in window) {
                try {
                    const ndef = new NDEFReader();
                    ndef.scan().then(() => {
                        console.log("NFC reader ready");
                        ndef.onreading = (event) => {
                            const decoder = new TextDecoder();
                            for (const record of event.message.records) {
                                const text = decoder.decode(record.data);
                                $('#cardInput').val(text.trim());
                                setTimeout(() => verifyUser(), 100);
                            }
                        };

                        ndef.onreadingerror = () => {
                            console.log("NFC reading error");
                        };
                    }).catch(error => {
                        console.log("NFC not available:", error);
                    });
                } catch (error) {
                    console.log("NFC API not supported");
                }
            }
        }

        // QR CODE SCANNING
        function scanQRCode() {
            $('#qrScannerModal').removeClass('hidden');

            // Dynamically load QR scanner library
            if (typeof Html5QrcodeScanner === 'undefined') {
                const script = document.createElement('script');
                script.src = "https://unpkg.com/html5-qrcode";
                script.onload = initializeQRScanner;
                document.head.appendChild(script);
            } else {
                initializeQRScanner();
            }
        }

        function initializeQRScanner() {
            if (!qrScanner) {
                qrScanner = new Html5QrcodeScanner(
                    "qr-reader",
                    {
                        fps: 10,
                        qrbox: 250,
                        showTorchButtonIfSupported: true,
                        showZoomSliderIfSupported: true
                    },
                    false
                );
            }

            qrScanner.render(
                (decodedText) => {
                    playSound('scan');
                    $('#cardInput').val(decodedText.trim());
                    closeQRScanner();
                    setTimeout(() => verifyUser(), 300);
                },
                (errorMessage) => {
                    // Optional: Handle scanning errors
                }
            );
        }

        function closeQRScanner() {
            $('#qrScannerModal').addClass('hidden');
            if (qrScanner) {
                qrScanner.clear();
            }
            setTimeout(focusScanner, 100);
        }

        async function verifyUser() {
            const identifier = $('#cardInput').val().trim();

            if (!identifier || identifier.length < 2) {
                showError('অনুগ্রহ করে একটি বৈধ আইডি স্ক্যান করুন বা লিখুন');
                return;
            }

            isProcessing = true;
            playSound('scan');

            // Clear previous user data and cart
            currentUser = null;
            cart = {};
            menuData = [];

            // Reset all screens to default state
            $('#successScreen').addClass('hidden');
            $('#orderScreen').addClass('hidden');
            $('#verificationScreen').removeClass('hidden');

            hideError();
            $('#loadingSpinner').removeClass('hidden');
            $('#cardInput').prop('disabled', true);

            try {
                const response = await fetch('/Verification/VerifyUser', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                if (data.success) {
                    currentUser = data;
                    menuData = data.todayMenu || [];

                    // Hide loading spinner FIRST
                    $('#loadingSpinner').addClass('hidden');
                    $('#cardInput').prop('disabled', false);

                    // Reset input field after successful scan
                    $('#cardInput').val('');

                    // Play success sound
                    playSound('success');

                    // Automatically switch back to scanner mode
                    disableManualInput();

                    // Then show order screen
                    showOrderScreen();
                } else {
                    showError(data.message);
                    $('#loadingSpinner').addClass('hidden');
                    $('#cardInput').prop('disabled', false);
                    $('#cardInput').val('');

                    // Refocus for next scan
                    setTimeout(focusScanner, 500);
                }
            } catch (error) {
                console.error('Verification error:', error);
                showError('সংযোগে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
                $('#loadingSpinner').addClass('hidden');
                $('#cardInput').prop('disabled', false);
                $('#cardInput').val('');

                setTimeout(focusScanner, 500);
            } finally {
                isProcessing = false;
            }
        }

