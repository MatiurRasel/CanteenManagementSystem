@{
    ViewData["Title"] = "ক্যান্টিন অর্ডার সিস্টেম";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700;800;900&display=swap');

        * {
            font-family: 'Noto Sans Bengali', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            --primary-color: #4F46E5;
            --secondary-color: #10B981;
            --accent-color: #F59E0B;
            --background-color: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-primary: #1E293B;
            --text-secondary: #64748B;
            --border-color: #E2E8F0;
            --success-color: #10B981;
            --warning-color: #F59E0B;
            --error-color: #EF4444;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            overflow-x: hidden;
            touch-action: manipulation;
            transition: background 0.3s ease;
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        .scan-animation {
            animation: scan 2s ease-in-out infinite;
        }

        @@keyframes scan {
            0%, 100% {
                transform: translateY(-10px) scale(1.05);
                opacity: 0.7;
            }

            50% {
                transform: translateY(10px) scale(1.1);
                opacity: 1;
            }
        }

        .pulse-ring {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @@keyframes pulse-ring {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            100% {
                transform: scale(1.8);
                opacity: 0;
            }
        }

        .slide-in-bottom {
            animation: slideInBottom 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @@keyframes slideInBottom {
            from {
                transform: translateY(30px) scale(0.95);
                opacity: 0;
            }

            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        .fade-in {
            animation: fadeIn 0.4s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .bounce-in {
            animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @@keyframes bounceIn {
            0% {
                transform: scale(0.3);
                opacity: 0;
            }

            50% {
                transform: scale(1.05);
            }

            70% {
                transform: scale(0.9);
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .scanner-active {
            animation: scannerPulse 2s infinite;
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 20px rgba(79, 70, 229, 0.3) !important;
        }

        @@keyframes scannerPulse {
            0%, 100% {
                box-shadow: 0 0 10px rgba(79, 70, 229, 0.3);
            }

            50% {
                box-shadow: 0 0 25px rgba(79, 70, 229, 0.6);
            }
        }

        input {
            color: var(--text-primary);
            background: white;
            transition: all 0.3s ease;
            border: 2px solid var(--border-color);
        }

            input:focus {
                outline: none;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
            }

        .menu-item {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            background: white;
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }

            .menu-item::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(79, 70, 229, 0.1), transparent);
                transition: 0.5s;
            }

            .menu-item:hover::before {
                left: 100%;
            }

            .menu-item:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 20px 40px rgba(79, 70, 229, 0.15);
                border-color: var(--primary-color);
            }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, #7C3AED 100%);
            color: white;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            border: none;
        }

            .btn-primary::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .btn-primary:hover::before {
                width: 300px;
                height: 300px;
            }

            .btn-primary:hover {
                transform: translateY(-3px) scale(1.02);
                box-shadow: 0 15px 30px rgba(79, 70, 229, 0.3);
            }

            .btn-primary:active {
                transform: translateY(-1px) scale(0.98);
            }

        .quantity-btn {
            transition: all 0.2s ease;
            touch-action: manipulation;
        }

            .quantity-btn:active {
                transform: scale(0.9);
            }

        /* Enhanced Scrollbar Styling */
        .custom-scrollbar {
            scrollbar-width: thin;
            scrollbar-color: var(--primary-color) #F1F5F9;
        }

            .custom-scrollbar::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: #F1F5F9;
                border-radius: 8px;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: linear-gradient(135deg, var(--primary-color) 0%, #7C3AED 100%);
                border-radius: 8px;
                border: 2px solid #F1F5F9;
            }

                .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                    background: linear-gradient(135deg, #4338CA 0%, #6D28D9 100%);
                }

        /* Responsive Grid */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        @@media (max-width: 768px) {
            .menu-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Card Styling */
        .card-hover {
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .card-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            }

        /* Loading Skeleton */
        .skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
        }

        @@keyframes loading {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        /* Badge Animations */
        .badge-pulse {
            animation: badgePulse 2s infinite;
        }

        @@keyframes badgePulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.4);
            }

            50% {
                box-shadow: 0 0 0 8px rgba(79, 70, 229, 0);
            }
        }

        /* EdTech Themed Elements */
        .edtech-gradient {
            background: linear-gradient(135deg, #4F46E5 0%, #10B981 100%);
        }

        .edtech-gradient-secondary {
            background: linear-gradient(135deg, #F59E0B 0%, #F97316 100%);
        }

        .edtech-gradient-success {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
        }

        /* Mobile Optimizations */
        @@media (max-width: 640px) {
            .mobile-stack {
                flex-direction: column;
            }

            .mobile-full {
                width: 100% !important;
                max-width: 100% !important;
            }

            .mobile-text-center {
                text-align: center;
            }

            .mobile-padding {
                padding: 1rem !important;
            }

            .mobile-gap {
                gap: 0.75rem !important;
            }
        }

        /* Touch Device Optimizations */
        @@media (hover: none) and (pointer: coarse) {
            .menu-item:hover {
                transform: none;
            }

            .btn-primary:hover {
                transform: none;
            }

            .quantity-btn {
                min-height: 44px;
                min-width: 44px;
            }
        }

        /* Print Styles */
        @@media print {
            body {
                background: white !important;
            }

            .glass-effect {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
            }
        }

        /* Accessibility */
        .focus-visible:focus-visible {
            outline: 3px solid var(--primary-color);
            outline-offset: 2px;
        }

        /* Reduced Motion */
        @@media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Manual input mode */
        .manual-input-active {
            animation: manualInputGlow 1.5s ease-in-out infinite alternate;
            border-color: var(--primary-color);
        }

        @@keyframes manualInputGlow {
            from {
                box-shadow: 0 0 5px rgba(79, 70, 229, 0.3);
            }

            to {
                box-shadow: 0 0 15px rgba(79, 70, 229, 0.6);
            }
        }

        /* EdTech Icons Styling */
        .edtech-icon {
            background: linear-gradient(135deg, var(--primary-color), #7C3AED);
            color: white;
            border-radius: 12px;
            padding: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        /* Progress Bar */
        .progress-bar {
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
            background: #E2E8F0;
        }

            .progress-bar .progress-fill {
                height: 100%;
                background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
                transition: width 1s ease;
            }

        /* Status Indicators */
        .status-online {
            background: var(--success-color);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }

        /* Modern Card Design */
        .modern-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }

            .modern-card:hover {
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
                transform: translateY(-2px);
            }

        /* Toast Animation */
        @@keyframes slideInDown {
            from {
                transform: translate(-50%, -100px);
                opacity: 0;
            }

            to {
                transform: translate(-50%, 0);
                opacity: 1;
            }
        }

        /* Always show cursor as pointer for scanner area */
        #scannerPlaceholder {
            cursor: pointer;
            transition: transform 0.2s ease;
        }

            #scannerPlaceholder:hover {
                transform: scale(1.02);
            }

        /* Scanner ready indicator */
        .scanner-ready {
            position: relative;
        }

            .scanner-ready::after {
                content: '';
                position: absolute;
                top: -5px;
                right: -5px;
                width: 15px;
                height: 15px;
                background: #10B981;
                border-radius: 50%;
                animation: pulse 2s infinite;
            }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.2);
                opacity: 0.7;
            }
        }

        /* Manual input overlay */
        #manualInputOverlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 99;
            display: none;
        }

        /* Focus indicator */
        .focus-indicator {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border: 3px solid transparent;
            border-radius: 1rem;
            pointer-events: none;
            z-index: 1;
        }

        .focused .focus-indicator {
            border-color: var(--primary-color);
            animation: focusPulse 1.5s infinite;
        }

        @@keyframes focusPulse {
            0%, 100% {
                opacity: 0.5;
            }

            50% {
                opacity: 1;
            }
        }

        /* Auto-focus message */
        .auto-focus-message {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            z-index: 1000;
            animation: fadeInOut 3s ease-in-out;
        }

        @@keyframes fadeInOut {
            0%, 100% {
                opacity: 0;
            }

            20%, 80% {
                opacity: 1;
            }
        }

        /* Scanner sound wave */
        .sound-wave {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 3px;
            height: 30px;
        }

            .sound-wave span {
                width: 4px;
                height: 10px;
                background: var(--primary-color);
                border-radius: 2px;
                animation: soundWave 1s ease infinite;
            }

                .sound-wave span:nth-child(2) {
                    animation-delay: 0.1s;
                }

                .sound-wave span:nth-child(3) {
                    animation-delay: 0.2s;
                }

                .sound-wave span:nth-child(4) {
                    animation-delay: 0.3s;
                }

                .sound-wave span:nth-child(5) {
                    animation-delay: 0.4s;
                }

        @@keyframes soundWave {
            0%, 100% {
                height: 10px;
            }

            50% {
                height: 25px;
            }
        }
    </style>
</head>
<body class="antialiased">
    <!-- VERIFICATION SCREEN -->
    <div id="verificationScreen" class="min-h-screen flex items-center justify-center p-4 md:p-8">
        <div class="glass-effect rounded-3xl p-6 md:p-12 w-full max-w-2xl mx-4 modern-card">
            <!-- Logo/Header -->
            <div class="mb-6 md:mb-8 text-center">
                <div class="relative inline-block mb-4 md:mb-6">
                    <div class="absolute inset-0 pulse-ring bg-indigo-400 rounded-full"></div>
                    <div class="relative edtech-gradient w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center mx-auto shadow-2xl">
                        <i class="fas fa-graduation-cap text-3xl md:text-4xl text-white"></i>
                    </div>
                </div>
                <h1 class="text-3xl md:text-5xl font-black text-gray-900 mb-2 md:mb-3 leading-tight">
                    ক্যান্টিন অর্ডার সিস্টেম
                </h1>
                <p class="text-lg md:text-xl text-gray-700 font-medium">চট্টগ্রাম ক্যান্টনমেন্ট পাবলিক কলেজ</p>
                <p class="text-base md:text-lg text-gray-600 mt-1 md:mt-2">স্মার্ট কার্ড স্ক্যান করে অর্ডার করুন</p>
            </div>

            <!-- Scan Icon with Sound Wave -->
            <div class="my-8 md:my-12 scan-animation">
                <div class="edtech-icon inline-block p-6 rounded-2xl">
                    <i class="fas fa-id-card text-5xl md:text-6xl text-white"></i>
                </div>
                <div class="sound-wave mt-4">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
            </div>

            <!-- Instructions -->
            <div class="mb-6 md:mb-8 text-center">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3 md:mb-4">আপনার আইডি কার্ড স্ক্যান করুন</h2>
                <p class="text-base md:text-lg text-gray-700">
                    <i class="fas fa-qrcode mr-2 text-indigo-500"></i>
                    বারকোড/QR কোড স্ক্যানার বা NFC কার্ড ব্যবহার করুন
                </p>
                <p class="text-sm text-gray-500 mt-2">
                    <i class="fas fa-volume-up mr-1 text-green-500"></i>
                    স্ক্যান সফল হলে শব্দ শুনতে পাবেন
                </p>
            </div>

            <!-- Input Field -->
            <div class="mb-6 md:mb-8">
                <div class="relative focused">
                    <div class="focus-indicator"></div>
                    <input type="text"
                           id="cardInput"
                           class="w-full px-6 py-5 md:px-8 md:py-6 text-2xl md:text-3xl text-center border-3 border-gray-300 rounded-2xl focus:border-indigo-500 transition-all duration-300 shadow-lg focus:shadow-xl bg-white opacity-0 absolute"
                           placeholder=""
                           autocomplete="off"
                           autocapitalize="off"
                           autocorrect="off"
                           spellcheck="false"
                           aria-label="আপনার আইডি লিখুন" />
                    <!-- Visible placeholder for scanner -->
                    <div id="scannerPlaceholder"
                         class="w-full px-6 py-5 md:px-8 md:py-6 text-2xl md:text-3xl text-center border-3 border-indigo-500 border-dashed rounded-2xl bg-indigo-50 text-indigo-700 cursor-pointer transition-all duration-300 shadow-lg scanner-active">
                        <div class="flex items-center justify-center gap-3">
                            <i class="fas fa-barcode text-3xl text-indigo-500"></i>
                            <span>স্ক্যানার ব্যবহার করুন</span>
                        </div>
                        <div class="text-sm text-indigo-600 mt-2">
                            <i class="fas fa-bolt mr-1"></i>
                            স্ক্যানার প্রস্তুত
                        </div>
                    </div>
                </div>
                <p class="text-sm text-gray-500 mt-2 text-center">
                    <i class="fas fa-info-circle mr-1 text-indigo-500"></i>
                    স্ক্যানার সক্রিয় | ম্যানুয়ালি আইডি লিখতে নিচের বাটনে ক্লিক করুন
                </p>
            </div>

            <!-- Error Message -->
            <div id="errorMessage" class="hidden mb-6 bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 p-6 rounded-xl shadow-lg">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-triangle text-2xl text-red-500 mr-3"></i>
                    <p class="text-red-700 font-semibold text-lg" id="errorText"></p>
                </div>
            </div>

            <!-- Loading -->
            <div id="loadingSpinner" class="hidden">
                <div class="flex flex-col items-center justify-center py-6">
                    <div class="relative">
                        <div class="animate-spin rounded-full h-20 w-20 border-t-4 border-b-4 border-indigo-500"></div>
                        <div class="absolute inset-0 animate-ping rounded-full border-4 border-indigo-300 opacity-75"></div>
                    </div>
                    <p class="text-gray-700 mt-6 text-lg font-medium">যাচাই করা হচ্ছে...</p>
                    <p class="text-gray-500 text-sm mt-2">অনুগ্রহ করে অপেক্ষা করুন</p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col md:flex-row gap-4 mt-8">
                <button onclick="enableManualInput()"
                        id="manualInputBtn"
                        class="btn-primary text-white px-8 py-4 rounded-xl font-bold text-lg md:text-xl flex-1 flex items-center justify-center gap-3 shadow-xl">
                    <i class="fas fa-keyboard text-xl"></i>
                    ম্যানুয়ালি আইডি লিখুন
                </button>
                <button onclick="scanQRCode()"
                        id="qrScanBtn"
                        class="edtech-gradient-secondary text-white px-8 py-4 rounded-xl font-bold text-lg md:text-xl flex-1 flex items-center justify-center gap-3 shadow-xl hover:shadow-2xl transition-all">
                    <i class="fas fa-camera text-xl"></i>
                    QR কোড স্ক্যান
                </button>
            </div>

            <!-- Quick Status -->
            <div class="mt-6 p-4 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl border border-blue-200">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                        <span class="text-sm font-medium text-gray-700">স্ক্যানার প্রস্তুত</span>
                    </div>
                    <div class="text-xs text-gray-500">
                        <i class="far fa-clock mr-1"></i>
                        স্বয়ংক্রিয় ফোকাস: <span id="autoFocusTimer">0</span>s
                    </div>
                </div>
            </div>

            <!-- Help Text -->
            <div class="mt-8 text-center">
                <p class="text-gray-600 text-sm">
                    <i class="fas fa-question-circle mr-2 text-indigo-500"></i>
                    সমস্যা হলে অফিসে যোগাযোগ করুন
                </p>
            </div>
        </div>
    </div>

    <!-- Manual Input Overlay -->
    <div id="manualInputOverlay"></div>

    <!-- ORDER SCREEN (Hidden Initially) -->
    <div id="orderScreen" class="hidden min-h-screen p-4 md:p-8">
        <div class="max-w-7xl mx-auto">
            <!-- Header with User Info -->
            <div class="glass-effect rounded-3xl p-6 md:p-8 mb-6 slide-in-bottom modern-card">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="flex items-center gap-4 md:gap-6">
                        <div id="userPhotoContainer" class="relative">
                            <img id="userPhoto" src="" alt="User Photo"
                                 class="w-16 h-16 md:w-20 md:h-20 rounded-2xl object-cover border-4 border-white shadow-2xl"
